{
  "private": true,
  "name": "agency",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "gen:shopify-app": "turbo gen shopify-app",
    "auth": "git config --global credential.azreposCredentialType oauth && git config --global credential.msauthUseBroker true && npm install ado-npm-auth@latest --location=global --registry=https://registry.npmjs.org && ado-npm-auth -Config .npmrc -F",
    "verify": "run-s check test:coverage",
    "check": "run-p check:*",
    "check:change": "beachball check",
    "check:format": "oxfmt",
    "check:lint": "turbo run lint",
    "check:types": "turbo run check:types",
    "check:unused": "turbo run check:unused",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "change": "beachball change",
    "change:release": "beachball publish",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@turbo/gen": "^2.10.0",
    "@vitest/expect": "4.1.10",
    "beachball": "^2.65.5",
    "knip": "^6.16.1",
    "lefthook": "^2.1.9",
    "npm-run-all2": "^9.0.2",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "turbo": "^2.10.0"
  },
  "packageManager": "pnpm@11.9.0"
}
