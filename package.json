{
  "private": true,
  "name": "agency",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "verify": "run-s check test:coverage",
    "check": "run-p check:*",
    "check:change": "beachball check",
    "check:format": "oxfmt --check",
    "check:lint": "turbo run lint",
    "check:types": "turbo run check:types",
    "check:unused": "knip",
    "lint": "turbo run lint",
    "format": "oxfmt",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "change": "beachball change",
    "change:release": "beachball publish",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "beachball": "^2.65.5",
    "knip": "^6.27.0",
    "lefthook": "^2.1.10",
    "npm-run-all2": "^9.0.2",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "turbo": "^2.10.5"
  },
  "packageManager": "pnpm@11.9.0"
}
