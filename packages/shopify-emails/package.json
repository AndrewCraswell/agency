{
  "name": "@repo/shopify-emails",
  "version": "0.0.0",
  "description": "Write Shopify notification emails as typed React Email components and compile them to Liquid.",
  "keywords": [
    "shopify",
    "liquid",
    "email",
    "react-email",
    "notifications",
    "transactional-email",
    "templates"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts",
    "./liquid": "./src/filters/index.ts",
    "./probe": "./src/probe/index.ts",
    "./store": "./src/admin/store.ts"
  },
  "bin": {
    "shopify-emails": "./src/admin/bin.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./liquid": {
        "types": "./dist/filters/index.d.ts",
        "default": "./dist/filters/index.js"
      },
      "./probe": {
        "types": "./dist/probe/index.d.ts",
        "default": "./dist/probe/index.js"
      },
      "./store": {
        "types": "./dist/admin/store.d.ts",
        "default": "./dist/admin/store.js"
      }
    },
    "bin": {
      "shopify-emails": "./dist/admin/bin.js"
    }
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json --clean && tsc --build tsconfig.build.json",
    "check:types": "tsc --noEmit",
    "check:unused": "knip --directory ../.. --workspace packages/shopify-emails",
    "cli": "tsx src/admin/bin.ts",
    "lint": "oxlint --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^15.0.0",
    "liquidjs": "^10.27.2",
    "picocolors": "^1.1.1",
    "tsx": "^4.23.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-email": "^6.0.0"
  },
  "devDependencies": {
    "@repo/oxlint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@shopify/theme-check-docs-updater": "^3.28.0",
    "@types/node": "catalog:",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.9",
    "oxlint": "^1.72.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-email": "^6.9.1",
    "typescript": "catalog:",
    "vitest": "^4.1.9"
  }
}
