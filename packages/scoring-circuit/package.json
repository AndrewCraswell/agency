{
  "name": "@repo/scoring-circuit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "build": "tsx src/build.ts",
    "check:types": "tsc --noEmit",
    "check:unused": "knip --directory ../.. --workspace packages/scoring-circuit",
    "dev": "tsx --watch src/build.ts",
    "lint": "oxlint --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tscircuit/soup-util": "0.0.41",
    "react": "^19.2.0",
    "tscircuit": "0.0.2271",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@repo/oxlint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "^19.2.0",
    "@vitest/coverage-v8": "^4.1.9",
    "oxlint": "^1.72.0",
    "tsx": "^4.23.0",
    "typescript": "catalog:",
    "vitest": "^4.1.9"
  }
}
