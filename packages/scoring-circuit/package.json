{
  "name": "@repo/scoring-circuit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "analog:simulate": "node scripts/run-analog-sim.mjs",
    "analog:simulate:reference-drive": "node scripts/run-reference-drive-sim.mjs",
    "build": "tsx src/build.ts",
    "check:types": "tsc --noEmit",
    "check:unused": "knip --directory ../.. --workspace packages/scoring-circuit",
    "dev": "tsx --watch src/build.ts",
    "judge:manufacturability": "node scripts/run-judge.mjs manufacturability",
    "judge:reliability": "node scripts/run-judge.mjs reliability",
    "lint": "oxlint --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tscircuit/parts-engine": "0.0.28",
    "@tscircuit/simple-3d-svg": "0.0.41",
    "@tscircuit/soup-util": "0.0.41",
    "circuit-json": "0.0.465",
    "circuit-json-to-gltf": "0.0.111",
    "circuit-json-to-simple-3d": "0.0.9",
    "circuit-to-svg": "0.0.400",
    "react": "^19.2.0",
    "three": "0.179.1",
    "tscircuit": "0.0.2271",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@repo/oxlint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "^19.2.0",
    "@vitest/coverage-v8": "^4.1.9",
    "esbuild": "0.28.1",
    "oxlint": "^1.72.0",
    "tsx": "^4.23.0",
    "typescript": "catalog:",
    "vitest": "^4.1.9"
  }
}
