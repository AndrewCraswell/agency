{
  "name": "@repo/scoring-circuit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "build": "tsx src/build.ts",
    "check:types": "tsc --noEmit",
    "check:unused": "knip --directory ../.. --workspace packages/scoring-circuit",
    "dev": "tsx --watch src/build.ts",
    "pcb:export": "tsx src/export-pcb.ts",
    "pcb:route": "tsx src/export-pcb.ts --route",
    "simulate": "tsx src/run-electrical-simulations.ts",
    "lint": "oxlint --max-warnings=0",
    "test": "vitest run"
  },
  "dependencies": {
    "@tscircuit/simple-3d-svg": "0.0.41",
    "circuit-json": "0.0.465",
    "circuit-json-to-gltf": "0.0.111",
    "circuit-json-to-simple-3d": "0.0.9",
    "circuit-to-svg": "0.0.400",
    "react": "^19.2.0",
    "three": "0.179.1",
    "tscircuit": "0.0.2271"
  },
  "devDependencies": {
    "@repo/oxlint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "^19.2.0",
    "circuit-json-to-gerber": "0.0.94",
    "circuit-json-to-kicad": "0.0.173",
    "esbuild": "0.28.1",
    "oxlint": "^1.72.0",
    "tsx": "^4.23.0",
    "typescript": "catalog:",
    "vitest": "^4.1.9"
  }
}
