{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "target": "ES2024",
    "types": ["node", "react", "tscircuit"],
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vitest.config.ts"],
  "exclude": ["node_modules"]
}
