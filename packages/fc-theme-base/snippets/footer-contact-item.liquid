{% comment %}
  Renders one icon and value row inside the footer contact column.

  Callers pass `value` already escaped, because the address row embeds
  its own `<br>` between street and locality.

  Accepts:
  - icon: {String} file name of an SVG in assets, e.g. 'icon-mail.svg'
  - value: {String} escaped text to display
  - label: {String} what the value is, e.g. 'Email'. The icon carries this
    visually, so the label is exposed to assistive tech only.
  - href: {String} link target for the value (optional)
  - tag: {String} pass 'address' to wrap the value in an `<address>` element

  Usage:
  {% render 'footer-contact-item',
    icon: 'icon-mail.svg',
    label: 'Email',
    value: email,
    href: email_href
  %}
{% endcomment %}

{%- if value != blank -%}
  <li class="footer-block__contact-item">
    <span class="footer-block__contact-icon svg-wrapper" aria-hidden="true">
      {{- icon | inline_asset_content -}}
    </span>
    {%- capture labelled_value -%}
      {%- if label != blank -%}
        <span class="visually-hidden">{{ label | escape }} </span>
      {%- endif -%}
      {{- value -}}
    {%- endcapture -%}
    {%- if href != blank -%}
      <a class="link link--text" href="{{ href }}">{{ labelled_value }}</a>
    {%- elsif tag == 'address' -%}
      <address class="footer-block__contact-address">{{ labelled_value }}</address>
    {%- else -%}
      <span>{{ labelled_value }}</span>
    {%- endif -%}
  </li>
{%- endif -%}
