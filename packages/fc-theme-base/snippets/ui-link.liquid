{% comment %}
  Renders a standalone text link.

  Accepts:
  - label: {String} Visible text.
  - url: {String} Destination.
  - icon: {String} Optional ui-icon name.
  - icon_position: {String} before | after. Default: after.
  - reverse_icon: {Boolean} Rotate the icon 180 degrees.
  - class: {String} Optional extra classes for section-level sizing.
  - label_class: {String} Optional class for the label span.
  - tabindex: {String} Optional tabindex value.
{% endcomment %}

<a
  class="ui-link{% if icon %} ui-link--with-icon{% endif %}{% if icon_position == 'before' %} ui-link--icon-before{% endif %}{% if reverse_icon %} ui-link--icon-reversed{% endif %}{% if class %} {{ class }}{% endif %}"
  href="{{ url }}"
  {% if tabindex != blank %}
    tabindex="{{ tabindex }}"
  {% endif %}
>
  {%- if icon and icon_position == 'before' -%}
    {%- render 'ui-icon', icon: icon -%}
  {%- endif -%}
  <span class="ui-link__label{% if label_class %} {{ label_class }}{% endif %}">{{ label | escape }}</span>
  {%- if icon and icon_position != 'before' -%}
    {%- render 'ui-icon', icon: icon -%}
  {%- endif -%}
</a>
