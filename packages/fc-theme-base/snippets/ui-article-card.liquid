{%- comment -%}
  Renders one Journal archive card with independent media, title, and read-more links.

  Accepts:
  - article: {Article} Article to render (required)
  - read_label: {String} Read-more link label (required)
  - heading_level: {Number} Heading level from 2 through 6 (default 2)
  - class: {String} Optional extra classes
{%- endcomment -%}
{%- assign heading_level = heading_level | default: 2 -%}
{%- assign heading_tag = 'h' | append: heading_level -%}
<article class="ui-article-card{% if class %} {{ class }}{% endif %}">
  <a class="ui-article-card__media" href="{{ article.url }}" aria-label="{{ article.title | escape }}">
    {%- if article.image -%}
      {{
        article.image
        | image_url: width: 800
        | image_tag:
          class: 'ui-article-card__image',
          widths: '397, 600, 800',
          sizes: '(min-width: 990px) 397px, (min-width: 750px) calc((100vw - 108px) / 2), calc(100vw - 40px)',
          alt: article.image.alt | default: article.title,
          loading: 'lazy'
      }}
    {%- else -%}
      <span class="ui-article-card__placeholder"></span>
    {%- endif -%}
  </a>

  <div class="ui-article-card__body">
    <p class="ui-article-card__meta">
      <span>{{ article.published_at | time_tag: format: 'date' }}</span>
    </p>
    <{{ heading_tag }} class="ui-article-card__title">
      <a href="{{ article.url }}">{{ article.title | escape }}</a>
    </{{ heading_tag }}>
    <p class="ui-article-card__excerpt">
      {%- if article.excerpt != blank -%}
        {{ article.excerpt | strip_html | truncatewords: 18 }}
      {%- else -%}
        {{ article.content | strip_html | truncatewords: 18 }}
      {%- endif -%}
    </p>
    {%- render 'ui-link', label: read_label, url: article.url, icon: 'arrow-right', class: 'ui-article-card__link' -%}
  </div>
</article>
