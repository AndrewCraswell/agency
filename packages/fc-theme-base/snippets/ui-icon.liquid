{% comment %}
  Renders an inline SVG icon.

  Accepts:
  - icon: {String} One of shield-check, sliders, close, chevron-down, arrow-right
{% endcomment %}

{%- case icon -%}
  {%- when 'shield-check' -%}
    <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true">
      <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>
      <path d="m9 12 2 2 4-4"/>
    </svg>
  {%- when 'sliders' -%}
    <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" focusable="false" aria-hidden="true">
      <path d="M3 6h11M17 6h4M3 12h4M10 12h11M3 18h11M17 18h4"/>
      <circle cx="15.5" cy="6" r="2.2"/><circle cx="8.5" cy="12" r="2.2"/><circle cx="15.5" cy="18" r="2.2"/>
    </svg>
  {%- when 'close' -%}
    <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" focusable="false" aria-hidden="true">
      <path d="M18 6 6 18M6 6l12 12"/>
    </svg>
  {%- when 'chevron-down' -%}
    <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true">
      <path d="m6 9 6 6 6-6"/>
    </svg>
  {%- when 'arrow-right' -%}
    <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true">
      <path d="M5 12h14M13 6l6 6-6 6"/>
    </svg>
{%- endcase -%}
