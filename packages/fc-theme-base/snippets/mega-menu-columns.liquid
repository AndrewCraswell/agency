{% comment %}
  Renders the L2 heading + L3 link columns shared by the complex and weapon builder views.
  L2 entries with no children of their own do not earn a column each, so they collect into
  a single stacked column at the end.

  Accepts:
  - link: {Link} the top level menu entry (required).

  Usage:
  {% render 'mega-menu-columns', link: link %}
{% endcomment %}

<div class="fc-mega__columns">
  {%- for childlink in link.links -%}
    {%- if childlink.links != blank -%}
      {%- capture child_context_url -%}
        {%- render 'collection-context-url', url: childlink.url, current_label: childlink.title -%}
      {%- endcapture -%}
      <div class="fc-mega__column">
        <a
          class="fc-mega__column-heading"
          href="{{ child_context_url }}"
          {% if childlink.current %}
            aria-current="page"
          {% endif %}
        >
          {{ childlink.title | escape }}
        </a>

        <ul class="fc-mega__column-links list-unstyled" role="list">
          {%- for grandchildlink in childlink.links -%}
            {%- liquid
              assign grandchild_label = grandchildlink.title
              if grandchild_label == 'Mens'
                assign grandchild_label = 'Men'
              elsif grandchild_label == 'Womens'
                assign grandchild_label = 'Women'
              endif
            -%}
            {%- capture grandchild_context_url -%}
              {%- render 'collection-context-url',
                url: grandchildlink.url,
                parent_label: childlink.title,
                parent_url: child_context_url,
                current_label: grandchild_label
              -%}
            {%- endcapture -%}
            <li>
              <a
                class="fc-mega__link"
                href="{{ grandchild_context_url }}"
                {% if grandchildlink.current %}
                  aria-current="page"
                {% endif %}
              >
                {{ grandchild_label | escape }}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  {%- endfor -%}

  {%- liquid
    assign standalone_count = 0
    for childlink in link.links
      if childlink.links == blank
        assign standalone_count = standalone_count | plus: 1
      endif
    endfor
  -%}

  {%- if standalone_count > 0 -%}
    <div class="fc-mega__column fc-mega__column--standalone">
      {%- for childlink in link.links -%}
        {%- if childlink.links == blank -%}
          {%- capture standalone_context_url -%}
            {%- render 'collection-context-url', url: childlink.url, current_label: childlink.title -%}
          {%- endcapture -%}
          <a
            class="fc-mega__column-heading"
            href="{{ standalone_context_url }}"
            {% if childlink.current %}
              aria-current="page"
            {% endif %}
          >
            {{ childlink.title | escape }}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>
