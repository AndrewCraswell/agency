{%- liquid
  assign from_id = id_prefix | append: filter.label | append: '-GTE'
  assign to_id = id_prefix | append: filter.label | append: '-LTE'
  assign from_label = 'products.facets.from' | t
  assign to_label = 'products.facets.to' | t
  assign maximum = filter.range_max | money_without_currency
  assign from_value = ''
  assign to_value = ''
  if filter.min_value.value != nil
    assign from_value = filter.min_value.value | money_without_currency
  endif
  if filter.max_value.value != nil
    assign to_value = filter.max_value.value | money_without_currency
  endif
-%}
<div class="ui-price-fields">
  {% render 'ui-text-field', id: from_id, name: filter.min_value.param_name, label: from_label, value: from_value, placeholder: '0', prefix: cart.currency.symbol, inputmode: 'decimal', range_min: 0, range_max: maximum %}
  {% render 'ui-text-field', id: to_id, name: filter.max_value.param_name, label: to_label, value: to_value, placeholder: maximum, prefix: cart.currency.symbol, inputmode: 'decimal', range_min: 0, range_max: maximum %}
</div>
