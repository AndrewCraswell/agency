{%- comment -%}
  Renders structured filter-option blocks in the Pencil collection order.

  Accepts:
  - blocks: {Block[]} Filter option blocks
  - current_tags: {String[]} Active collection tags
  - section_id: {String} Owning section id
  - default_active_tags: {String} Delimited tags selected before filtering
{%- endcomment -%}
{%- assign filter_groups = 'sub-category|discipline|gender|size|level|price|brand|color|experience' | split: '|' -%}

<nav class="collection-curated-filters" aria-label="Product filters">
  {%- for group_key in filter_groups -%}
    {%- liquid
      assign group_label = group_key | upcase
      assign presentation = 'checkbox'
      if group_key == 'size'
        assign presentation = 'chip'
      elsif group_key == 'color'
        assign presentation = 'swatch'
      endif
    -%}
    <section
      class="collection-filter-group collection-filter-group--{{ presentation }}"
      aria-labelledby="CollectionFilter-{{ section_id }}-{{ group_key }}"
    >
      <h3 id="CollectionFilter-{{ section_id }}-{{ group_key }}">{{ group_label }}</h3>
      <ul class="collection-filter-group__options list-unstyled">
        {%- for block in blocks -%}
          {%- if block.type == 'filter_option' and block.settings.group == group_key -%}
            {%- render 'collection-filter-option',
              block: block,
              presentation: presentation,
              current_tags: current_tags,
              default_active_tags: default_active_tags
            -%}
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </section>
  {%- endfor -%}
</nav>