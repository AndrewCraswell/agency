{% comment %}
  Renders a header search modal. Should be used with 'header.liquid'

  The bar, results and footer are one full-bleed surface dropping below the header,
  matching Docs/Search in FencingClubWebsite.pen.

  Accepts:
  - input_id: {String} Id for the search input element (required)

  Usage:
  {% render 'header-search', input_id: 'My-Id'%}
{% endcomment %}

<details-modal class="header__search">
  <details>
    <summary
      class="header__icon header__icon--search header__icon--summary link focus-inset modal__toggle"
      aria-haspopup="dialog"
      aria-label="{{ 'general.search.search' | t }}"
    >
      <span>
        <span class="svg-wrapper header__icon-open">
          {% render 'fc-icon', icon: 'search', size: 22 %}
        </span>
        <span class="svg-wrapper header__icon-close">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </span>
      </span>
    </summary>
    <div
      class="search-modal modal__content"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'general.search.search' | t }}"
    >
      <div class="modal-overlay"></div>
      <div class="search-modal__content" tabindex="-1">
        {%- if settings.predictive_search_enabled -%}
          <predictive-search class="search-panel" data-loading-text="{{ 'accessibility.loading' | t }}">
        {%- else -%}
          <search-form class="search-panel">
        {%- endif -%}
        <form action="{{ routes.search_url }}" method="get" role="search" class="search-panel__form">
          <div class="search-panel__bar">
            <span class="search-panel__icon">
              {%- render 'fc-icon', icon: 'search', size: 22 -%}
            </span>
            <label class="visually-hidden" for="{{ input_id }}">{{ 'general.search.search' | t }}</label>
            <input
              class="search-panel__input"
              id="{{ input_id }}"
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="{{ 'general.search.placeholder' | t }}"
              {%- if settings.predictive_search_enabled -%}
                aria-controls="{{ input_id }}-results"
                autocorrect="off"
                autocomplete="off"
                autocapitalize="off"
                spellcheck="false"
              {%- endif -%}
            >
            <input type="hidden" name="options[prefix]" value="last">
            <span class="search-panel__spinner" aria-hidden="true">
              {%- render 'fc-icon', icon: 'loader-circle', size: 18 -%}
            </span>
            <button
              type="button"
              class="search-panel__close modal__close-button focus-inset"
              aria-label="{{ 'accessibility.close' | t }}"
            >
              {%- render 'fc-icon', icon: 'x', size: 20 -%}
            </button>
          </div>

          {%- if settings.predictive_search_enabled -%}
            <div id="{{ input_id }}-results" class="predictive-search predictive-search--header" tabindex="-1" data-predictive-search role="region" aria-label="{{ 'general.search.search' | t | escape }}">
              {%- render 'predictive-search-skeleton' -%}
            </div>
            {%- render 'predictive-search-idle', id_prefix: input_id, within_modal: true -%}

            <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
          {%- endif -%}
        </form>
        {%- if settings.predictive_search_enabled -%}
          </predictive-search>
        {%- else -%}
          </search-form>
        {%- endif -%}
      </div>
    </div>
  </details>
</details-modal>
