{% doc %}
  Cart panel using the same product rows as the full cart page.
{% enddoc %}
{{ 'component-cart-items.css' | asset_url | stylesheet_tag }}
{{ 'cart-experience.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'cart-controls.js' | asset_url }}" defer="defer"></script>
<cart-drawer class="drawer fc-cart-panel{% if cart == empty %} is-empty{% endif %}">
  <div id="CartDrawer" class="cart-drawer">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div>
    <div class="drawer__inner" role="dialog" aria-modal="true" aria-label="{{ 'sections.cart.title' | t }}" tabindex="-1">
      <header class="drawer__header">
        <h2 class="drawer__heading">{{ 'sections.cart.title' | t }} <span class="fc-cart-count">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span></h2>
        <button class="drawer__close fc-cart-icon-button" type="button" onclick="this.closest('cart-drawer').close()" aria-label="{{ 'accessibility.close' | t }}">{% render 'fc-icon', icon: 'x', size: 20 %}</button>
      </header>
      {%- if cart == empty -%}
        <div class="drawer__inner-empty"><h2>{{ 'sections.cart.empty' | t }}</h2><a href="{{ routes.all_products_collection_url }}" class="button">{{ 'general.continue_shopping' | t }}</a></div>
      {%- endif -%}
      <cart-drawer-items view-event-payload="{{ cart | standard_event_data: 'view', context: 'dialog' | escape }}" view-event-trigger="manual" {% if cart == empty %}class="is-empty"{% endif %}>
        <form action="{{ routes.cart_url }}" id="CartDrawer-Form" class="cart-drawer__form" method="post">
          <div id="CartDrawer-CartItems" class="drawer__contents js-contents">
            {% render 'cart-lines', context: 'drawer' %}
            <p id="CartDrawer-LiveRegionText" class="visually-hidden" role="status"></p>
            <p id="CartDrawer-LineItemStatus" class="visually-hidden" aria-hidden="true" role="status">{{ 'accessibility.loading' | t }}</p>
          </div>
          <div id="CartDrawer-CartErrors" role="alert"></div>
        </form>
        {%- if cart != empty -%}<div class="fc-cart-tools">
          {% render 'cart-discount', context: 'drawer' %}
          {%- if settings.show_cart_note -%}{% render 'cart-note-editor', context: 'drawer', form_id: 'CartDrawer-Form' %}{%- endif -%}
          <a class="fc-cart-view" href="{{ routes.cart_url }}">{{ 'general.cart.view' | t: count: cart.item_count }}</a>
        </div>{%- endif -%}
      </cart-drawer-items>
      <footer class="drawer__footer cart-drawer__footer">
        <div class="fc-cart-panel__breakdown">{% render 'cart-subtotal' %}
          {%- for discount in cart.cart_level_discount_applications -%}<div class="fc-cart-saving"><span>{{ discount.title | escape }}</span><span>-{{ discount.total_allocated_amount | money }}</span></div>{%- endfor -%}
        </div>
        {% render 'cart-checkout', form_id: 'CartDrawer-Form', context: 'drawer' %}
      </footer>
    </div>
  </div>
</cart-drawer>