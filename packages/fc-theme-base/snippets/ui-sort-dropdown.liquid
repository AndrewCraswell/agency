{%- comment -%}
  Renders the sort control shared by the collection and search pages.

  Accepts:
  - results: {Object} Collection or search object exposing sort_options (required)
  - sort_label: {String} Visible prefix, for example "Sort by" (required)
  - default_label: {String} Label to show when no sort is applied. Collections pass
    "Featured"; search omits it so the real default option name is used.
  - class: {String} Optional extra classes

  Uses the shared ui-select component.
{%- endcomment -%}
{%- liquid
  assign sort_by = results.sort_by | default: results.default_sort_by
-%}
<facet-filters-form class="ui-sort-dropdown{% if class %} {{ class }}{% endif %}">
  <form class="collection-toolbar__sort-form sorting" id="FacetSortForm">
    {%- capture sort_options -%}
          {%- for option in results.sort_options -%}
            {%- if results.sort_by == blank
              and default_label != blank
              and option.name == default_label
              and option.value != sort_by
            -%}
              {%- continue -%}
            {%- endif -%}
            {%- assign option_label = option.name -%}
            {%- if results.sort_by == blank and default_label != blank and option.value == sort_by -%}
              {%- assign option_label = default_label -%}
            {%- endif -%}
            <option value="{{ option.value | escape }}" {% if option.value == sort_by %}selected{% endif %}>{{ option_label | escape }}</option>
          {%- endfor -%}
    {%- endcapture -%}
    {% render 'ui-select', id: 'SortBy', name: 'sort_by', label: sort_label, prefix: sort_label, hide_label: true, options: sort_options %}
  </form>
</facet-filters-form>
