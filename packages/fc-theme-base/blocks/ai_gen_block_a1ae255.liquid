{% doc %}
  @prompt
    I want to generation a section that shows off our bags, with buttons to go to the Wheel Bags or Carry Bags
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-bag-showcase-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-bag-showcase__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-bag-showcase__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-bag-showcase__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 16px;
    font-weight: 700;
  }

  .ai-bag-showcase__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    opacity: 0.8;
  }

  .ai-bag-showcase__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-bag-showcase__card-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.card_border_radius }}px;
    background-color: {{ block.settings.card_background }};
  }

  .ai-bag-showcase__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
  }

  .ai-bag-showcase__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-bag-showcase__image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-bag-showcase__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-bag-showcase__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, rgba(0,0,0,0) 0%, rgba(0,0,0,{{ block.settings.overlay_opacity | divided_by: 100.0 }}) 100%);
  }

  .ai-bag-showcase__content-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 30px;
    z-index: 2;
  }

  .ai-bag-showcase__card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    color: {{ block.settings.card_text_color }};
    margin: 0 0 16px;
    font-weight: 700;
  }

  .ai-bag-showcase__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 28px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    transition: all 0.3s ease;
    border: 2px solid {{ block.settings.button_background }};
  }

  .ai-bag-showcase__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_background }};
  }

  @media screen and (max-width: 749px) {
    .ai-bag-showcase__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.grid_gap | times: 0.75 }}px;
    }

    .ai-bag-showcase__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-bag-showcase__subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.85 }}px;
    }

    .ai-bag-showcase__card-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.card_title_size | times: 0.8 }}px;
    }

    .ai-bag-showcase__content-{{ ai_gen_id }} {
      padding: 20px;
    }
  }
{% endstyle %}

<bag-showcase-{{ ai_gen_id }} class="ai-bag-showcase-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-bag-showcase__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-bag-showcase__header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-bag-showcase__title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <p class="ai-bag-showcase__subtitle-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-bag-showcase__grid-{{ ai_gen_id }}">
      <div class="ai-bag-showcase__card-{{ ai_gen_id }}">
        <div class="ai-bag-showcase__image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.wheel_bags_image %}
            <img
              src="{{ block.settings.wheel_bags_image | image_url: width: 800 }}"
              alt="{{ block.settings.wheel_bags_image.alt | escape }}"
              loading="lazy"
              width="800"
              height="800"
              class="ai-bag-showcase__image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-bag-showcase__image-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
          <div class="ai-bag-showcase__overlay-{{ ai_gen_id }}"></div>
          <div class="ai-bag-showcase__content-{{ ai_gen_id }}">
            <h3 class="ai-bag-showcase__card-title-{{ ai_gen_id }}">{{ block.settings.wheel_bags_title }}</h3>
            {% if block.settings.wheel_bags_collection %}
              <a href="{{ block.settings.wheel_bags_collection.url }}" class="ai-bag-showcase__button-{{ ai_gen_id }}">
                {{ block.settings.wheel_bags_button_text }}
              </a>
            {% endif %}
          </div>
        </div>
      </div>

      <div class="ai-bag-showcase__card-{{ ai_gen_id }}">
        <div class="ai-bag-showcase__image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.carry_bags_image %}
            <img
              src="{{ block.settings.carry_bags_image | image_url: width: 800 }}"
              alt="{{ block.settings.carry_bags_image.alt | escape }}"
              loading="lazy"
              width="800"
              height="800"
              class="ai-bag-showcase__image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-bag-showcase__image-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
          <div class="ai-bag-showcase__overlay-{{ ai_gen_id }}"></div>
          <div class="ai-bag-showcase__content-{{ ai_gen_id }}">
            <h3 class="ai-bag-showcase__card-title-{{ ai_gen_id }}">{{ block.settings.carry_bags_title }}</h3>
            {% if block.settings.carry_bags_collection %}
              <a href="{{ block.settings.carry_bags_collection.url }}" class="ai-bag-showcase__button-{{ ai_gen_id }}">
                {{ block.settings.carry_bags_button_text }}
              </a>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</bag-showcase-{{ ai_gen_id }}>

<script>
  (function() {
    class BagShowcase{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('bag-showcase-{{ ai_gen_id }}', BagShowcase{{ ai_gen_id }});
  })();
</script>

