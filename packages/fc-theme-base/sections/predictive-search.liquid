{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{%- liquid
  assign suggestion_limit = 4
  assign category_limit = 3
  assign product_limit = 4
  assign guide_limit = 2

  assign found_queries = predictive_search.resources.queries
  assign found_collections = predictive_search.resources.collections
  assign found_products = predictive_search.resources.products
  assign found_articles = predictive_search.resources.articles
  assign found_pages = predictive_search.resources.pages

  assign query_count = found_queries.size
  if query_count > suggestion_limit
    assign query_count = suggestion_limit
  endif

  assign category_count = found_collections.size
  if category_count > category_limit
    assign category_count = category_limit
  endif

  assign product_count = found_products.size
  if product_count > product_limit
    assign product_count = product_limit
  endif

  comment
    Articles and pages share one "Guides and support" allowance, so pages only take
    whatever slots the articles leave behind.
  endcomment
  assign article_count = found_articles.size
  if article_count > guide_limit
    assign article_count = guide_limit
  endif
  assign page_room = guide_limit | minus: article_count
  assign page_count = found_pages.size
  if page_count > page_room
    assign page_count = page_room
  endif
  assign guide_count = article_count | plus: page_count

  assign rail_count = query_count | plus: category_count
  assign main_count = product_count | plus: guide_count
  assign total_results = rail_count | plus: main_count
-%}
<div id="predictive-search-results">
  {%- if predictive_search.performed -%}
    {%- if total_results > 0 -%}
      <div
        id="predictive-search-results-groups-wrapper"
        data-search-results-groups
        class="predictive-search__results-groups-wrapper{% if rail_count == 0 %} predictive-search__results-groups-wrapper--no-rail{% endif %}{% if main_count == 0 %} predictive-search__results-groups-wrapper--no-main{% endif %}"
      >
    {%- endif -%}
    {%- if rail_count > 0 -%}
      <div class="predictive-search__rail">
    {%- endif -%}
    {%- if query_count > 0 -%}
      {%- capture query_items -%}
          {%- for query in found_queries limit: query_count -%}
            <li
              id="predictive-search-option-query-{{ forloop.index }}"
              class="predictive-search__list-item"
              data-search-result
            >
              <a href="{{ query.url }}" class="predictive-search__item">
                <span class="predictive-search__item-icon">
                  {%- render 'fc-icon', icon: 'search', size: 15 -%}
                </span>
                <span class="predictive-search__item-query-result" aria-label="{{ query.text }}">
                  {{- query.styled_text -}}
                </span>
              </a>
            </li>
          {%- endfor -%}
      {%- endcapture -%}
      {%- assign suggestions_heading = 'templates.search.suggestions' | t -%}
      {%- render 'predictive-search-list',
        heading: suggestions_heading,
        heading_id: 'predictive-search-queries',
        list_id: 'predictive-search-results-queries-list',
        items: query_items,
        modifier: 'predictive-search__group--suggestions'
      -%}
    {%- endif -%}
    {%- if category_count > 0 -%}
      {%- capture category_items -%}
          {%- for collection in found_collections limit: category_count -%}
            <li
              id="predictive-search-option-collection-{{ forloop.index }}"
              class="predictive-search__list-item"
              data-search-result
            >
              <a href="{{ collection.url }}" class="predictive-search__item">
                <span class="predictive-search__item-icon">
                  {%- render 'fc-icon', icon: 'layout-grid', size: 15 -%}
                </span>
                <span class="predictive-search__item-title">{{ collection.title | escape }}</span>
                {%- if collection.products_count > 0 -%}
                  <span class="predictive-search__item-count">
                    {{- 'templates.search.product_count_with_count' | t: count: collection.products_count -}}
                  </span>
                {%- endif -%}
              </a>
            </li>
          {%- endfor -%}
      {%- endcapture -%}
      {%- assign categories_heading = 'templates.search.categories' | t -%}
      {%- render 'predictive-search-list',
        heading: categories_heading,
        heading_id: 'predictive-search-categories',
        list_id: 'predictive-search-results-categories-list',
        items: category_items,
        modifier: 'predictive-search__group--categories'
      -%}
    {%- endif -%}
    {%- if rail_count > 0 -%}
      </div>
    {%- endif -%}
    {%- if main_count > 0 -%}
      <div class="predictive-search__main">
        {%- if product_count > 0 -%}
          <div class="predictive-search__group predictive-search__group--products">
            <h2 id="predictive-search-products" class="predictive-search__heading">
              {{- 'templates.search.products' | t -}}
            </h2>
            <ul
              id="predictive-search-results-products-list"
              class="predictive-search__results-list predictive-search__products-grid list-unstyled"
              role="list"
              aria-labelledby="predictive-search-products"
            >
              {%- for product in found_products limit: product_count -%}
                <li
                  id="predictive-search-option-product-{{ forloop.index }}"
                  class="predictive-search__list-item predictive-search__list-item--product"
                  data-search-result
                >
                  <product-component view-event-payload="{{ product | standard_event_data: 'view', context: 'search' | escape }}">
                    {%- assign card_id = 'PredictiveSearchTitle-' | append: forloop.index -%}
                    {%- render 'ui-product-card',
                      product: product,
                      variant: 'search',
                      card_id: card_id,
                      show_price: settings.predictive_search_show_price,
                      image_width: 426,
                      image_widths: '168, 209, 336, 418',
                      image_sizes: '(min-width: 1100px) 209px, 50vw',
                      image_loading: 'eager'
                    -%}
                  </product-component>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
        {%- if guide_count > 0 -%}
          {%- capture guide_items -%}
              {%- for article in found_articles limit: article_count -%}
                <li
                  id="predictive-search-option-article-{{ forloop.index }}"
                  class="predictive-search__list-item"
                  data-search-result
                >
                  <a href="{{ article.url }}" class="predictive-search__item">
                    <span class="predictive-search__item-icon">
                      {%- render 'fc-icon', icon: 'book-open', size: 15 -%}
                    </span>
                    <span class="predictive-search__item-title predictive-search__item-title--guide">
                      {{- article.title | escape -}}
                    </span>
                    <span class="predictive-search__item-tag">{{ 'templates.search.article' | t }}</span>
                  </a>
                </li>
              {%- endfor -%}
              {%- for page in found_pages limit: page_count -%}
                <li
                  id="predictive-search-option-page-{{ forloop.index }}"
                  class="predictive-search__list-item"
                  data-search-result
                >
                  <a href="{{ page.url }}" class="predictive-search__item">
                    <span class="predictive-search__item-icon">
                      {%- render 'fc-icon', icon: 'life-buoy', size: 15 -%}
                    </span>
                    <span class="predictive-search__item-title predictive-search__item-title--guide">
                      {{- page.title | escape -}}
                    </span>
                    <span class="predictive-search__item-tag">{{ 'templates.search.page' | t }}</span>
                  </a>
                </li>
              {%- endfor -%}
          {%- endcapture -%}
          {%- assign guides_heading = 'templates.search.guides' | t -%}
          {%- render 'predictive-search-list',
            heading: guides_heading,
            heading_id: 'predictive-search-guides',
            list_id: 'predictive-search-results-guides-list',
            items: guide_items,
            modifier: 'predictive-search__group--guides'
          -%}
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- if total_results > 0 -%}
      </div>
    {%- else -%}
      <div id="predictive-search-results-groups-wrapper" class="predictive-search__empty" data-search-results-groups>
        <span class="predictive-search__empty-icon">
          {%- render 'fc-icon', icon: 'search-x', size: 26 -%}
        </span>
        <p class="predictive-search__empty-heading">
          {{- 'templates.search.no_results_heading' | t: terms: predictive_search.terms -}}
        </p>
        <p class="predictive-search__empty-hint">{{ 'templates.search.no_results_hint' | t }}</p>
        {%- assign browse_heading = 'templates.search.popular_categories' | t -%}
        {%- render 'predictive-search-categories',
          variant: 'chips',
          heading: browse_heading,
          hide_heading: true,
          id_prefix: 'predictive-search-option-empty-category'
        -%}
      </div>
    {%- endif -%}

    {%- render 'predictive-search-skeleton' -%}

    {%- if total_results > 0 -%}
      <div class="predictive-search__footer">
        <p class="predictive-search__hints" aria-hidden="true">
          <span class="predictive-search__hint">
            {%- render 'ui-kbd', icons: 'arrow-up,arrow-down' -%}
            {{ 'templates.search.keyboard_navigate' | t }}
          </span>
          <span class="predictive-search__hint">
            {%- render 'ui-kbd', icons: 'corner-down-left' -%}
            {{ 'templates.search.keyboard_open' | t }}
          </span>
          <span class="predictive-search__hint">
            {%- assign escape_label = 'templates.search.keyboard_escape' | t -%}
            {%- render 'ui-kbd', label: escape_label -%}
            {{ 'templates.search.keyboard_close' | t }}
          </span>
        </p>
        {%- assign view_all_label = 'templates.search.view_all_results' | t: terms: predictive_search.terms -%}
        {%- assign encoded_terms = predictive_search.terms | url_encode -%}
        {%- assign view_all_url = routes.search_url
          | append: '?q='
          | append: encoded_terms
          | append: '&options%5Bprefix%5D=last'
        -%}
        <div
          id="predictive-search-option-search-keywords"
          class="predictive-search__search-for-button predictive-search__list-item"
          data-search-result
        >
          {%- render 'ui-link',
            label: view_all_label,
            url: view_all_url,
            icon: 'arrow-right',
            class: 'predictive-search__item--term',
            label_class: 'predictive-search__view-all-label'
          -%}
        </div>
      </div>
    {%- elsif pages.contact != blank -%}
      <div class="predictive-search__footer predictive-search__footer--help">
        <p class="predictive-search__help">
          {{ 'templates.search.no_results_help' | t }}
          {%- assign contact_label = 'templates.search.no_results_contact' | t -%}
          {%- render 'ui-link', label: contact_label, url: pages.contact.url, icon: 'arrow-right' -%}
        </p>
      </div>
    {%- endif -%}

    <span
      class="hidden"
      data-predictive-search-live-region-count-value
      data-total-results="{{ total_results }}"
    >
      {% liquid
        if total_results == 0
          echo 'templates.search.no_results' | t: terms: predictive_search.terms
        else
          echo 'templates.search.results_with_count' | t: count: total_results | append: ': '
          if query_count > 0
            echo 'templates.search.results_suggestions_with_count' | t: count: query_count | append: ', '
          endif
          if guide_count > 0
            echo 'templates.search.results_guides_with_count' | t: count: guide_count | append: ', '
          endif
          if product_count > 0
            echo 'templates.search.results_products_with_count' | t: count: product_count
          endif
        endif
      %}
    </span>
  {%- endif -%}
</div>
