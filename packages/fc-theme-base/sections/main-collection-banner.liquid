{{ 'section-main-collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'collection-breadcrumbs.js' | asset_url }}" defer="defer"></script>

{%- comment -%}
  Category pills come from a menu whose handle matches the collection, so any
  collection can offer them without section blocks.
{%- endcomment -%}
{%- assign category_links = linklists[collection.handle].links -%}

<header class="collection-intro">
  {%- render 'ui-breadcrumbs',
    root_label: section.settings.home_label,
    root_url: routes.root_url,
    current_label: collection.title,
    contextual: true
  -%}

  <h1 class="collection-intro__title">{{ collection.title | escape }}</h1>

  {%- if section.settings.show_collection_description and collection.description != blank -%}
    <div class="collection-intro__description rte">{{ collection.description }}</div>
  {%- endif -%}

  {%- if section.settings.show_category_pills and category_links.size > 0 -%}
    <nav class="collection-intro__pills" aria-label="{{ section.settings.category_label | escape }}">
      {%- for link in category_links -%}
        {%- capture category_url -%}
          {%- render 'collection-context-url',
            url: link.url,
            parent_label: collection.title,
            parent_url: collection.url,
            current_label: link.title
          -%}
        {%- endcapture -%}
        {%- render 'ui-pill', label: link.title, url: category_url -%}
      {%- endfor -%}
    </nav>
  {%- endif -%}
</header>

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "class": "section",
  "settings": [
    { "type": "text", "id": "home_label", "label": "Home label", "default": "Home" },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_description.label"
    },
    { "type": "checkbox", "id": "show_category_pills", "label": "Show category links", "default": true },
    {
      "type": "paragraph",
      "content": "Category links come from the navigation menu whose handle matches the collection handle."
    },
    { "type": "text", "id": "category_label", "label": "Category navigation label", "default": "Shop categories" }
  ]
}
{% endschema %}
