{{ 'section-home.css' | asset_url | stylesheet_tag }}

<div class="fc-home">
  <section class="fc-home__section" aria-labelledby="CategoryGrid-{{ section.id }}">
    <div class="fc-home__inner">
      {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
        <header class="fc-home__head">
          {%- if section.settings.eyebrow != blank -%}
            <p class="fc-home__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="fc-home__h44" id="CategoryGrid-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
        </header>
      {%- endif -%}

      <div class="fc-home__cats">
        {%- for block in section.blocks -%}
          {%- assign cat = block.settings.collection -%}
          {%- assign cat_name = block.settings.title | default: cat.title -%}
          {%- assign cat_url = cat.url | default: routes.collections_url -%}
          <article class="fc-home__cat" {{ block.shopify_attributes }}>
            {%- assign card_image = block.settings.image | default: cat.featured_image -%}
            <a class="fc-home__cat-image-link" href="{{ cat_url }}" aria-label="{{ cat_name | escape }}">
              {%- if card_image -%}
                {{
                  card_image
                  | image_url: width: 800
                  | image_tag:
                    class: 'fc-home__cat-photo',
                    widths: '395, 592, 790',
                    sizes: '(min-width: 990px) 395px, 100vw',
                    alt: cat_name,
                    loading: 'lazy'
                }}
              {%- else -%}
                <span class="fc-home__cat-photo fc-home__cat-photo--placeholder"></span>
              {%- endif -%}
            </a>
            <span class="fc-home__cat-info">
              <span class="fc-home__cat-text">
                <a class="fc-home__cat-name" href="{{ cat_url }}">{{ cat_name | escape }}</a>
                {%- if section.settings.show_count -%}
                  <span class="fc-home__cat-count">
                    {{- cat.all_products_count | default: 0 }}
                    {{ cat.all_products_count | default: 0 | pluralize: 'item', 'items' -}}
                  </span>
                {%- endif -%}
              </span>
              {%- if section.settings.link_label != blank -%}
                {%- render 'ui-link',
                  label: section.settings.link_label,
                  url: cat_url,
                  icon: 'arrow-right',
                  class: 'fc-home__cat-shop'
                -%}
              {%- endif -%}
            </span>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Category grid",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "BROWSE THE RANGE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Category" },
    { "type": "checkbox", "id": "show_count", "label": "Show product count", "default": true },
    { "type": "text", "id": "link_label", "label": "Card link label", "default": "Shop" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title", "info": "Defaults to the collection title." },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Defaults to the collection image." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category grid",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
