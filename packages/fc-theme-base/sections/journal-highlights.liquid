{{ 'section-home.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign blog = blogs[section.settings.blog]
-%}

{%- if blog != blank and blog.articles_count > 0 -%}
  <div class="fc-home">
    <section class="fc-home__journal-section" aria-labelledby="Journal-{{ section.id }}">
      <div class="fc-home__inner">
        <header class="fc-home__head-row fc-home__head-row--end">
          <div class="fc-home__head">
            {%- if section.settings.eyebrow != blank -%}
              <p class="fc-home__eyebrow fc-home__eyebrow--journal">{{ section.settings.eyebrow | escape }}</p>
            {%- endif -%}
            {%- if section.settings.heading != blank -%}
              <h2 class="fc-home__h40" id="Journal-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
            {%- endif -%}
          </div>
          {%- if section.settings.link_label != blank -%}
            {%- render 'ui-link',
              label: section.settings.link_label,
              url: blog.url,
              icon: 'arrow-right',
              class: 'fc-home__viewall fc-home__viewall--sm'
            -%}
          {%- endif -%}
        </header>

        <div class="fc-home__journal">
          {%- for article in blog.articles limit: 3 -%}
            <article class="fc-home__post">
              <a
                class="fc-home__post-image-link"
                href="{{ article.url }}"
                aria-label="{{ article.title | escape }}"
              >
                {%- if article.image -%}
                  {{
                    article.image
                    | image_url: width: 790
                    | image_tag:
                      class: 'fc-home__post-image',
                      widths: '395, 592, 790',
                      sizes: '(min-width: 990px) 395px, 100vw',
                      alt: article.image.alt | default: article.title,
                      loading: 'lazy'
                  }}
                {%- else -%}
                  <span class="fc-home__post-image fc-home__post-image--placeholder"></span>
                {%- endif -%}
              </a>
              <div class="fc-home__post-body">
                <p class="fc-home__post-meta">
                  <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                    {{- article.published_at | date: '%b %-d, %Y' -}}
                  </time>
                </p>
                <h3 class="fc-home__post-title">
                  <a class="fc-home__post-title-link" href="{{ article.url }}">{{ article.title | escape }}</a>
                </h3>
                <p class="fc-home__post-excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 18 }}</p>
                {%- render 'ui-link',
                  label: section.settings.read_label,
                  url: article.url,
                  icon: 'arrow-right',
                  class: 'fc-home__post-link'
                -%}
              </div>
            </article>
          {%- endfor -%}
        </div>
      </div>
    </section>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Journal",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE JOURNAL" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the Journal" },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog",
      "info": "Shows the three most recent posts. The section is hidden when no blog is selected."
    },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all posts" },
    { "type": "text", "id": "read_label", "label": "Read more label", "default": "Read more" }
  ],
  "presets": [{ "name": "Journal" }]
}
{% endschema %}
