{{ 'component-facets.css' | asset_url | stylesheet_tag }}
{{ 'section-main-collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'collection-curated-products.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'collection-sort.js' | asset_url }}" defer="defer"></script>
{%- unless section.settings.quick_add == 'none' -%}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    --collection-columns: {{ section.settings.columns_desktop }};
    --collection-mobile-columns: {{ section.settings.columns_mobile }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{%- liquid
  assign use_curated_filters = false
  if section.settings.enable_curated_filters
    if section.settings.curated_filter_collection_handle == blank or section.settings.curated_filter_collection_handle == collection.handle
      assign use_curated_filters = true
    endif
  endif
  assign use_curated_products = false
  if section.settings.enable_curated_products
    if section.settings.curated_product_collection_handle == blank or section.settings.curated_product_collection_handle == collection.handle
      assign use_curated_products = true
    endif
  endif
  assign toolbar_count_label = blank
  if use_curated_products
    assign toolbar_count_label = section.settings.curated_product_count_label
  endif
  assign curated_product_blocks = section.blocks | where: 'type', 'curated_product'
-%}

<collection-component
  view-event-payload="{{ collection | standard_event_data: 'view' | escape }}"
  data-collection-id="{{ collection.id }}"
>
  <div class="collection-product-area section-{{ section.id }}-padding">
    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- if settings.structured_data_enabled -%}
        {%- assign structured_data_position_offset = paginate.current_page
          | minus: 1
          | times: paginate.page_size
        -%}
        {%- render 'structured-data',
          collection_item_list_enabled: true,
          collection_item_list: collection.products,
          collection_item_count: paginate.items,
          collection_position_offset: structured_data_position_offset
        -%}
      {%- endif -%}
      <div class="collection-layout{% unless section.settings.enable_filtering %} collection-layout--no-filters{% endunless %} facets-vertical">
        {%- if section.settings.enable_filtering -%}
          <aside
            aria-labelledby="CollectionFilters-{{ section.id }}"
            class="collection-filter-panel facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}"
            id="main-collection-filters"
            data-id="{{ section.id }}"
          >
            <div class="collection-filter-panel__header">
              <h2 id="CollectionFilters-{{ section.id }}">{{ section.settings.filter_heading | escape }}</h2>
              <facet-remove>
                <a href="{{ collection.url }}">{{ section.settings.clear_all_label | escape }}</a>
              </facet-remove>
            </div>
            {%- if use_curated_filters -%}
              {%- liquid
                assign desktop_filter_id = section.id | append: '-desktop'
                assign mobile_filter_id = section.id | append: '-mobile'
              -%}
              <div class="collection-curated-filters-desktop">
                {%- render 'collection-curated-filters',
                  blocks: section.blocks,
                  current_tags: current_tags,
                  section_id: desktop_filter_id,
                  default_active_tags: section.settings.default_active_filter_tags
                -%}
              </div>
              <details class="collection-curated-filters-mobile">
                <summary>
                  <span class="svg-wrapper">{{- 'icon-filter.svg' | inline_asset_content -}}</span>
                  <span>{{ section.settings.mobile_filter_label | escape }}</span>
                </summary>
                <div class="collection-curated-filters-mobile__panel">
                  <div class="collection-curated-filters-mobile__header">
                    <strong>{{ section.settings.filter_heading | escape }}</strong>
                    <div class="collection-curated-filters-mobile__actions">
                      <a href="{{ collection.url }}">{{ section.settings.clear_all_label | escape }}</a>
                      <button
                        type="button"
                        aria-label="{{ 'accessibility.close' | t }}"
                        onclick="this.closest('details').removeAttribute('open')"
                      >
                        {%- render 'fc-icon', icon: 'x', size: 20 -%}
                      </button>
                    </div>
                  </div>
                  {%- render 'collection-curated-filters',
                    blocks: section.blocks,
                    current_tags: current_tags,
                    section_id: mobile_filter_id,
                    default_active_tags: section.settings.default_active_filter_tags
                  -%}
                </div>
              </details>
            {%- else -%}
              {% render 'facets',
                results: collection,
                enable_filtering: section.settings.enable_filtering,
                enable_sorting: false,
                filter_type: 'vertical',
                paginate: paginate,
                expand_filters: true,
                show_product_count: false
              %}
            {%- endif -%}
          </aside>
        {%- endif -%}

        <div
          class="collection-grid-column product-grid-container"
          id="ProductGridContainer"
        >
          <curated-collection-products
            class="collection"
            {% if use_curated_products %}data-curated{% endif %}
          >
            {%- render 'collection-toolbar',
              results: collection,
              enable_sorting: section.settings.enable_sorting,
              sort_label: section.settings.sort_label,
              count_label: toolbar_count_label
            -%}

            {%- if collection.products.size == 0 and use_curated_products == false -%}
              <div class="collection--empty" id="product-grid" data-id="{{ section.id }}">
                <div class="loading-overlay gradient"></div>
                <div class="title-wrapper center">
                  <h2 class="title title--primary">
                    {{ 'sections.collection_template.empty' | t -}}
                    <br>
                    {{
                      'sections.collection_template.use_fewer_filters_html'
                      | t: link: collection.url, class: 'underlined-link link'
                    }}
                  </h2>
                </div>
              </div>
            {%- else -%}
              <div class="loading-overlay gradient"></div>
              <ul
                id="product-grid"
                data-id="{{ section.id }}"
                class="collection-product-grid"
              >
                {%- if use_curated_products -%}
                  {%- for block in curated_product_blocks -%}
                      {%- assign card_id = 'CollectionProduct-' | append: section.id | append: '-' | append: block.id -%}
                      <li
                        data-title="{{ block.settings.title | downcase | escape }}"
                        data-price="{{ block.settings.price | remove: '$' | remove: ',' | escape }}"
                        data-position="{{ forloop.index }}"
                        {{ block.shopify_attributes }}
                      >
                        {%- render 'ui-product-card',
                          title: block.settings.title,
                          url: block.settings.link,
                          product_type: block.settings.product_type,
                          price_label: block.settings.price,
                          image_asset: block.settings.image_asset,
                          image_alt: block.settings.image_alt,
                          variant: 'home',
                          card_id: card_id,
                          badge_label: block.settings.badge,
                          show_type: true,
                          show_price: true,
                          show_add: true,
                          add_label: section.settings.add_label,
                          section_id: section.id,
                          image_loading: 'eager'
                        -%}
                      </li>
                  {%- endfor -%}
                {%- else -%}
                {%- for product in collection.products -%}
                  {%- liquid
                    assign badge_label = blank
                    if product.compare_at_price > product.price
                      assign badge_label = 'SALE'
                    endif
                    for product_tag in product.tags
                      assign normalized_tag = product_tag | downcase
                      if normalized_tag == 'best seller' or normalized_tag == 'new'
                        assign badge_label = product_tag | upcase
                        break
                      endif
                    endfor
                    assign show_add = false
                    unless section.settings.quick_add == 'none'
                      assign show_add = true
                    endunless
                    assign card_id = 'CollectionProduct-' | append: section.id | append: '-' | append: product.id
                  -%}
                  <li>
                    {%- render 'ui-product-card',
                      product: product,
                      variant: 'home',
                      card_id: card_id,
                      badge_label: badge_label,
                      show_type: true,
                      show_price: true,
                      show_add: show_add,
                      add_label: section.settings.add_label,
                      section_id: section.id,
                      trim_price: true,
                      image_sizes: '(min-width: 990px) 300px, (min-width: 750px) calc((100vw - 104px) / 2), calc((100vw - 52px) / 2)',
                      image_widths: '300, 450, 600',
                      image_loading: 'lazy'
                    -%}
                  </li>
                {%- endfor -%}
                {%- endif -%}
              </ul>

              {%- if use_curated_products and section.settings.curated_load_more_url != blank -%}
                <nav class="ui-pagination collection-load-more" aria-label="{{ 'general.pagination.label' | t }}">
                  <a class="ui-pagination__next" href="{{ section.settings.curated_load_more_url }}">
                    {{- section.settings.load_more_label | escape -}}
                  </a>
                </nav>
              {%- else -%}
                {%- render 'ui-pagination',
                  paginate: paginate,
                  anchor: 'product-grid',
                  mode: 'next',
                  next_label: section.settings.load_more_label,
                  class: 'collection-load-more'
                -%}
              {%- endif -%}
            {%- endif -%}
          </curated-collection-products>
        </div>
      </div>
    {%- endpaginate -%}
  </div>
</collection-component>

{% schema %}
{
  "name": "t:sections.main-collection-product-grid.name",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 6,
      "max": 36,
      "step": 3,
      "default": 9,
      "label": "t:sections.main-collection-product-grid.settings.products_per_page.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "t:sections.main-collection-product-grid.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "t:sections.main-collection-product-grid.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__2.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "quick_add",
      "default": "standard",
      "label": "t:sections.main-collection-product-grid.settings.quick_add.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.main-collection-product-grid.settings.quick_add.options.option_1"
        },
        {
          "value": "standard",
          "label": "t:sections.main-collection-product-grid.settings.quick_add.options.option_2"
        }
      ]
    },
    { "type": "text", "id": "add_label", "label": "Add button label", "default": "Add" },
    { "type": "checkbox", "id": "enable_curated_products", "label": "Use curated products", "default": false },
    {
      "type": "text",
      "id": "curated_product_collection_handle",
      "label": "Curated product collection handle",
      "info": "Curated product blocks appear only on this collection. Leave empty to use them on every collection.",
      "default": "clothing"
    },
    { "type": "text", "id": "curated_product_count_label", "label": "Curated product count", "default": "48 products" },
    { "type": "url", "id": "curated_load_more_url", "label": "Curated load more link" },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header__1.content"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_filtering.label",
      "info": "t:sections.main-collection-product-grid.settings.enable_filtering.info"
    },
    { "type": "checkbox", "id": "enable_curated_filters", "label": "Use curated filters", "default": false },
    {
      "type": "text",
      "id": "curated_filter_collection_handle",
      "label": "Curated filter collection handle",
      "info": "Curated filter blocks appear only on this collection. Leave empty to use them on every collection.",
      "default": "clothing"
    },
    { "type": "text", "id": "mobile_filter_label", "label": "Mobile filter label", "default": "Filter" },
    {
      "type": "text",
      "id": "default_active_filter_tags",
      "label": "Selected filter tags",
      "info": "Wrap every tag in vertical bars. Used only before the customer filters.",
      "default": "|Jackets|Plastrons|Foil|Women|Level 2 - 800N FIE|$100-$200|UNIC|"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_sorting.label"
    },
    { "type": "text", "id": "filter_heading", "label": "Filter heading", "default": "Filters" },
    { "type": "text", "id": "clear_all_label", "label": "Clear filters label", "default": "Clear all" },
    { "type": "text", "id": "sort_label", "label": "Sort prefix", "default": "Sort:" },
    { "type": "text", "id": "load_more_label", "label": "Next page label", "default": "Load more" },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 90
    }
  ],
  "blocks": [
    {
      "type": "filter_option",
      "name": "Filter option",
      "settings": [
        {
          "type": "select",
          "id": "group",
          "label": "Group",
          "options": [
            { "value": "sub-category", "label": "Sub-category" },
            { "value": "discipline", "label": "Discipline" },
            { "value": "gender", "label": "Gender" },
            { "value": "size", "label": "Size" },
            { "value": "level", "label": "Level" },
            { "value": "price", "label": "Price" },
            { "value": "brand", "label": "Brand" },
            { "value": "color", "label": "Color" },
            { "value": "experience", "label": "Experience" }
          ],
          "default": "sub-category"
        },
        { "type": "text", "id": "label", "label": "Label", "default": "Option" },
        { "type": "text", "id": "tag", "label": "Product tag", "info": "Defaults to the label when empty." },
        { "type": "checkbox", "id": "show_count", "label": "Show count", "default": false },
        { "type": "range", "id": "count", "label": "Count", "min": 0, "max": 100, "step": 1, "default": 0 },
        { "type": "color", "id": "swatch", "label": "Swatch color", "default": "#ffffff" }
      ]
    },
    {
      "type": "curated_product",
      "name": "Curated product",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Product" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "product_type", "label": "Product type", "default": "Foils" },
        { "type": "text", "id": "price", "label": "Price", "default": "$0" },
        { "type": "text", "id": "badge", "label": "Badge", "default": "BEST SELLER" },
        { "type": "text", "id": "image_asset", "label": "Theme image asset filename" },
        { "type": "text", "id": "image_alt", "label": "Image alt text" }
      ]
    }
  ]
}
{% endschema %}
