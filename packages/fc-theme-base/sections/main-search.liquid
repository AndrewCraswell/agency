{{ 'section-main-search.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
  {{ 'component-facets.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.enable_sorting -%}
{%- endif -%}

<script src="{{ 'main-search.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign sort_by = search.sort_by | default: search.default_sort_by
  assign terms = search.terms | escape
  assign search_url = '?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% paginate search.results by 50 %}
  {%- liquid
    assign encoded_terms = search.terms | url_encode
    assign clear_filters_url = routes.search_url | append: '?q=' | append: encoded_terms | append: '&options%5Bprefix%5D=last'

    assign product_results = search.results | where: 'object_type', 'product'
    assign page_results = search.results | where: 'object_type', 'page'
    assign article_results = search.results | where: 'object_type', 'article'
    assign product_count = product_results.size
    assign page_count = page_results.size
    assign article_count = article_results.size
    assign content_count = page_count | plus: article_count

    assign active_filter_count = 0
    for filter in search.filters
      assign active_filter_count = active_filter_count | plus: filter.active_values.size
      if filter.type == 'price_range'
        if filter.min_value.value != blank
          assign active_filter_count = active_filter_count | plus: 1
        endif
        if filter.max_value.value != blank
          assign active_filter_count = active_filter_count | plus: 1
        endif
      endif
    endfor

    assign search_input_id = 'MainSearch-' | append: section.id
    assign search_placeholder = 'general.search.placeholder' | t
    assign search_button_label = 'general.search.search' | t
    assign contact_label = 'templates.search.no_results_contact' | t
  -%}

  <div class="search-results section-{{ section.id }}-padding">
    <div class="search-results__band">
      <h1 class="search-results__title">{{ 'templates.search.title' | t }}</h1>
      {%- render 'ui-search-form',
        input_id: search_input_id,
        label: search_placeholder,
        button_label: search_button_label,
        value: search.terms,
        class: 'search-results__form'
      -%}
      {%- comment -%}
        The empty state names the query itself, so a "0 results" line above it would repeat that.
      {%- endcomment -%}
      {%- if search.performed and search.results_count > 0 -%}
        <p class="search-results__summary" role="status">
          {{- 'templates.search.results_with_count_and_term' | t: terms: search.terms, count: search.results_count -}}
        </p>
      {%- endif -%}
    </div>

    {%- if search.performed -%}
      <div id="ProductGridContainer">
        {%- comment -%}
          facets.js requires .collection and #ProductCount to exist on every render, including
          when a filter leaves no products. Without them it throws before issuing the fetch.
        {%- endcomment -%}
        <div class="collection">
          <span
            id="ProductCount"
            class="visually-hidden"
            role="status"
            data-product-count="{{ product_count }}"
            data-total-count="{{ search.results_count }}"
          >
            {{- 'templates.search.matching_products_with_count' | t: count: product_count -}}
          </span>
        {%- if product_count > 0 -%}
          <section class="search-results__section" aria-labelledby="SearchProducts-{{ section.id }}">
            <div class="search-results__section-header">
              <p class="search-results__eyebrow">{{ section.settings.products_eyebrow | escape }}</p>
              <h2 class="search-results__heading" id="SearchProducts-{{ section.id }}">
                <span class="search-results__heading-count">
                  {{- 'templates.search.matching_products_with_count' | t: count: product_count -}}
                </span>
                <span class="search-results__heading-loading">{{ section.settings.loading_label | escape }}</span>
              </h2>
            </div>

            {%- if search.filters != empty -%}
              {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
                <div class="search-results__controls" id="main-search-filters" data-id="{{ section.id }}">
                  {%- comment -%}
                    Sorting is rendered from our own component, so Dawn's native select stays off.
                  {%- endcomment -%}
                  {% render 'facets',
                    results: search,
                    enable_filtering: section.settings.enable_filtering,
                    enable_sorting: false,
                    filter_type: 'horizontal',
                    paginate: paginate
                  %}

                  {%- if section.settings.enable_sorting -%}
                    {%- render 'ui-sort-dropdown',
                      results: search,
                      sort_label: section.settings.sort_label,
                      class: 'search-results__sort'
                    -%}
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endif -%}

            <ul
              class="search-results__product-grid"
              id="product-grid"
              data-id="{{ section.id }}"
              role="list"
            >
              {%- for item in product_results -%}
                {%- liquid
                  assign badge_label = blank
                  if item.compare_at_price > item.price
                    assign badge_label = 'SALE'
                  endif
                  assign card_id = 'SearchProduct-' | append: section.id | append: '-' | append: item.id
                -%}
                <li>
                  {%- render 'ui-product-card',
                    product: item,
                    variant: 'home',
                    card_id: card_id,
                    badge_label: badge_label,
                    show_type: true,
                    show_price: true,
                    show_add: true,
                    add_label: section.settings.add_label,
                    section_id: section.id,
                    trim_price: true,
                    image_sizes: '(min-width: 990px) 300px, (min-width: 750px) calc((100vw - 116px) / 2), calc((100vw - 52px) / 2)',
                    image_widths: '300, 450, 600',
                    image_loading: 'lazy'
                  -%}
                </li>
              {%- endfor -%}
            </ul>

            {%- render 'ui-product-card-skeleton', count: 4 -%}
          </section>
        {%- endif -%}

        {%- comment -%}
          Pages lead articles: a page is usually the direct answer, an article the deeper read.
        {%- endcomment -%}
        {%- if content_count > 0 -%}
          <section
            class="search-results__section search-results__section--content"
            aria-labelledby="SearchContent-{{ section.id }}"
          >
            <div class="search-results__section-header">
              <p class="search-results__eyebrow">{{ section.settings.content_eyebrow | escape }}</p>
              <h2 class="search-results__heading" id="SearchContent-{{ section.id }}">
                {{- 'templates.search.related_reads_with_count' | t: count: content_count -}}
              </h2>
            </div>

            {%- if page_count > 0 -%}
              <ul class="search-results__pages" role="list">
                {%- for item in page_results -%}
                  {%- render 'ui-page-result-row', page: item, heading_level: 3 -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}

            {%- if article_count > 0 -%}
              <ul class="search-results__articles" role="list">
                {%- for item in article_results -%}
                  <li>
                    {%- render 'ui-article-card',
                      article: item,
                      read_label: section.settings.article_link_label,
                      heading_level: 3
                    -%}
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </section>
        {%- endif -%}

        {%- comment -%}
          Shopify strips articles and pages from search.results as soon as a product
          filter is applied, so say that rather than letting the count drop silently.
        {%- endcomment -%}
        {%- if active_filter_count > 0 -%}
          <div class="search-results__section">
            <p class="search-results__notice">
              <span>{{ section.settings.filters_notice | escape }}</span>
              <a href="{{ clear_filters_url }}">{{ section.settings.clear_filters_label | escape }}</a>
            </p>
          </div>
        {%- endif -%}

        {%- if search.results_count == 0 -%}
          <div class="search-results__empty">
            <div class="search-results__empty-copy">
              <h2 class="search-results__empty-heading">
                {{- 'templates.search.no_results_heading' | t: terms: search.terms -}}
              </h2>
              <p class="search-results__empty-hint">{{ 'templates.search.no_results_hint' | t }}</p>
            </div>

            {%- assign empty_links = linklists[settings.popular_categories_menu].links -%}
            {%- if empty_links.size > 0 -%}
              <div class="search-results__empty-categories">
                <p class="search-results__empty-label">{{ section.settings.empty_categories_label | escape }}</p>
                <ul class="search-results__empty-chips" role="list">
                  {%- for link in empty_links limit: 6 -%}
                    <li>{%- render 'ui-pill', label: link.title, url: link.url -%}</li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}

            <p class="search-results__empty-help">
              <span>{{ section.settings.empty_help_prompt | escape }}</span>
              {%- render 'ui-link', label: contact_label, url: pages.contact.url, icon: 'arrow-right' -%}
            </p>
          </div>
        {%- endif -%}

        {%- if paginate.pages > 1 -%}
          <div class="search-results__section search-results__section--pagination">
            {% render 'pagination', paginate: paginate %}
          </div>
        {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
{% endpaginate %}

{% schema %}
{
  "name": "t:sections.main-search.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "t:sections.main-search.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "t:sections.main-search.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.main-search.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.main-search.settings.columns_mobile.options__2.label"
        }
      ]
    },    
    {
      "type": "header",
      "content": "t:sections.main-search.settings.header__1.content"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.main-search.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.main-search.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.main-search.settings.image_ratio.options__3.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.main-search.settings.image_ratio.label"
    },
    {
      "type": "select",
      "id": "image_shape",
      "options": [
        {
          "value": "default",
          "label": "t:sections.all.image_shape.options__1.label"
        },
        {
          "value": "arch",
          "label": "t:sections.all.image_shape.options__2.label"
        },
        {
          "value": "blob",
          "label": "t:sections.all.image_shape.options__3.label"
        },
        {
          "value": "chevronleft",
          "label": "t:sections.all.image_shape.options__4.label"
        },
        {
          "value": "chevronright",
          "label": "t:sections.all.image_shape.options__5.label"
        },
        {
          "value": "diamond",
          "label": "t:sections.all.image_shape.options__6.label"
        },
        {
          "value": "parallelogram",
          "label": "t:sections.all.image_shape.options__7.label"
        },
        {
          "value": "round",
          "label": "t:sections.all.image_shape.options__8.label"
        }
      ],
      "default": "default",
      "label": "t:sections.all.image_shape.label"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": false,
      "label": "t:sections.main-search.settings.show_secondary_image.label"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "t:sections.main-search.settings.show_vendor.label"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "t:sections.main-search.settings.show_rating.label",
      "info": "t:sections.main-search.settings.show_rating.info"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header__1.content"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_filtering.label",
      "info": "t:sections.main-collection-product-grid.settings.enable_filtering.info"
    },
    {
      "type": "select",
      "id": "filter_type",
      "options": [
        {
          "value": "horizontal",
          "label": "t:sections.main-collection-product-grid.settings.filter_type.options__1.label"
        },
        {
          "value": "vertical",
          "label": "t:sections.main-collection-product-grid.settings.filter_type.options__2.label"
        },
        {
          "value": "drawer",
          "label": "t:sections.main-collection-product-grid.settings.filter_type.options__3.label"
        }
      ],
      "default": "horizontal",
      "label": "t:sections.main-collection-product-grid.settings.filter_type.label"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_sorting.label"
    },
    {
      "type": "text",
      "id": "sort_label",
      "default": "Sort by",
      "label": "Sort label"
    },
    {
      "type": "text",
      "id": "loading_label",
      "default": "Updating results…",
      "label": "Loading heading"
    },
    {
      "type": "header",
      "content": "Empty state"
    },
    {
      "type": "paragraph",
      "content": "Category shortcuts come from the Popular categories menu in Theme settings > Search."
    },
    {
      "type": "text",
      "id": "empty_categories_label",
      "label": "Popular categories label",
      "default": "Popular categories"
    },
    {
      "type": "text",
      "id": "empty_help_prompt",
      "label": "Empty state help prompt",
      "default": "Not finding something?"
    },
    {
      "type": "header",
      "content": "Result sections"
    },
    {
      "type": "text",
      "id": "products_eyebrow",
      "label": "Products section label",
      "default": "Products"
    },
    {
      "type": "text",
      "id": "content_eyebrow",
      "label": "Pages and articles section label",
      "default": "Pages & articles"
    },
    {
      "type": "textarea",
      "id": "filters_notice",
      "label": "Filtered results notice",
      "info": "Shown when a product filter is active, because Shopify removes pages and articles from filtered search results.",
      "default": "Pages and articles are hidden while product filters are active."
    },
    {
      "type": "text",
      "id": "clear_filters_label",
      "label": "Clear filters link label",
      "default": "Clear filters"
    },
    {
      "type": "text",
      "id": "add_label",
      "label": "Product add button label",
      "default": "Add"
    },
    {
      "type": "header",
      "content": "t:sections.main-search.settings.header__2.content"
    },
    {
      "type": "text",
      "id": "article_link_label",
      "label": "Article link label",
      "default": "Read more"
    },
    {
      "type": "checkbox",
      "id": "article_show_date",
      "default": true,
      "label": "t:sections.main-search.settings.article_show_date.label"
    },
    {
      "type": "checkbox",
      "id": "article_show_author",
      "default": false,
      "label": "t:sections.main-search.settings.article_show_author.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
