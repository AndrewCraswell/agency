      "settings": {
        "color_scheme": "scheme-footer",
        "newsletter_enable": false,
        "enable_follow_on_shop": false,
        "show_social": false,
        "enable_country_selector": false,
        "enable_language_selector": false,
        "payment_enable": true,
        "copyright_name": "Fencing Club",
        "rights_text": "All rights reserved.",
        "legal_menu": "",
        "margin_top": 0,
        "padding_top": 72,
        "padding_bottom": 40
