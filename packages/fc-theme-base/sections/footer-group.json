        "heading": {
          "type": "heading",
          "settings": {
            "heading": "Get first access to new gear & restocks",
            "heading_size": "h2"
          }
        },
        "paragraph": {
          "type": "paragraph",
          "settings": {
            "text": "<p>Join the list for early drops, limited restocks, and fitting guides. No noise, just the essentials.</p>"
          }
        },
        "email_form": {
          "type": "email_form"
        }
      },
      "block_order": ["heading", "paragraph", "email_form"],
      "settings": {
        "color_scheme": "scheme-footer",
        "full_width": true,
        "layout": "split",
        "padding_top": 52,
        "padding_bottom": 52
      }
    },
    "footer": {
      "type": "footer",
      "blocks": {
        "brand": {
          "type": "brand_information",
          "settings": {
            "show_social": true
          }
        },
        "shop": {
          "type": "link_list",
          "settings": {
            "heading": "Shop",
            "menu": "footer-shop"
          }
        },
        "support": {
          "type": "link_list",
          "settings": {
            "heading": "Support",
            "menu": "footer-support"
          }
        },
        "company": {
          "type": "link_list",
          "settings": {
            "heading": "Company",
            "menu": "footer-company"
          }
        },
        "contact": {
          "type": "contact",
          "settings": {
            "heading": "Contact"
          }
        }
