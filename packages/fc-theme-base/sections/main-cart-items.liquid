{{ 'component-cart.css' | asset_url | stylesheet_tag }}
{{ 'component-cart-items.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-discounts.css' | asset_url | stylesheet_tag }}
{{ 'cart-experience.css' | asset_url | stylesheet_tag }}
{%- unless settings.cart_type == 'drawer' -%}<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>{%- endunless -%}
<script src="{{ 'cart-controls.js' | asset_url }}" defer="defer"></script>
<cart-items class="fc-cart-page{% if cart == empty %} is-empty{% endif %}" view-event-payload="{{ cart | standard_event_data: 'view', context: 'page' | escape }}">
  <header class="fc-cart-page__header title-wrapper-with-link">
    <h1>{{ 'sections.cart.title' | t }} <span class="fc-cart-count" data-cart-count>{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span></h1>
    <a href="{{ routes.all_products_collection_url }}"><span class="fc-cart-back">{% render 'fc-icon', icon: 'arrow-right', size: 16 %}</span>{{ 'general.continue_shopping' | t }}</a>
  </header>
  <div class="cart__warnings">
    <h1 class="cart__empty-text">{{ 'sections.cart.empty' | t }}</h1>
    <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'general.continue_shopping' | t }}</a>
  </div>
  <form action="{{ routes.cart_url }}" class="cart__contents" method="post" id="cart">
    <div id="main-cart-items" data-id="{{ section.id }}"><div class="js-contents">{% render 'cart-lines', context: 'page' %}</div></div>
    <p class="visually-hidden" id="cart-live-region-text" role="status"></p>
    <p class="visually-hidden" id="shopping-cart-line-item-status" aria-hidden="true" role="status">{{ 'accessibility.loading' | t }}</p>
    <noscript><button type="submit" name="update" class="button">{{ 'sections.cart.update' | t }}</button></noscript>
  </form>
</cart-items>
{% schema %}
{
  "name": "t:sections.main-cart-items.name",
  "class": "fc-cart-items-section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 36 }
  ]
}
{% endschema %}