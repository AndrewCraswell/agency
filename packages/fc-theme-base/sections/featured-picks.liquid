{{ 'section-home.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  The first two cards stack in the left column; the third renders full height beside them.
{%- endcomment -%}

<div class="fc-home">
  <section class="fc-home__section" aria-labelledby="FeaturedPicks-{{ section.id }}">
    <div class="fc-home__inner">
      {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
        <header class="fc-home__head">
          {%- if section.settings.eyebrow != blank -%}
            <p class="fc-home__eyebrow fc-home__eyebrow--soft">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="fc-home__h36" id="FeaturedPicks-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
        </header>
      {%- endif -%}

      <div class="fc-home__picks">
        <div class="fc-home__picks-col">
          {%- for block in section.blocks limit: 2 -%}
            {%- render 'featured-pick-card', block: block, tall: false -%}
          {%- endfor -%}
        </div>

        {%- for block in section.blocks offset: 2 limit: 1 -%}
          {%- render 'featured-pick-card', block: block, tall: true -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Featured picks",
  "tag": "section",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "GEAR UP YOUR WAY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured picks" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "header", "content": "Links", "info": "Each link shows as a pill button. Leave a label empty to hide it." },
        { "type": "text", "id": "link_1_label", "label": "Link 1 label" },
        { "type": "url", "id": "link_1_url", "label": "Link 1" },
        { "type": "text", "id": "link_2_label", "label": "Link 2 label" },
        { "type": "url", "id": "link_2_url", "label": "Link 2" },
        { "type": "text", "id": "link_3_label", "label": "Link 3 label" },
        { "type": "url", "id": "link_3_url", "label": "Link 3" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured picks",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "Build Your Own Kit",
            "description": "Everything to get on the strip — uniform, blade, and mask bundled together.",
            "link_1_label": "Foil Kits",
            "link_2_label": "Épée Kits",
            "link_3_label": "Sabre Kits"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Weapon Builder",
            "description": "Assemble a competition-ready blade part by part, tuned exactly how you like it.",
            "link_1_label": "Foil Weapon",
            "link_2_label": "Épée Weapon",
            "link_3_label": "Sabre Weapon"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Team Fencing Bag",
            "description": "Roomy, durable bags to haul your whole setup — from the club to the competition.",
            "link_1_label": "Wheel Bags",
            "link_2_label": "Carry Bags"
          }
        }
      ]
    }
  ]
}
{% endschema %}
