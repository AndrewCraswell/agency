{%- liquid
  assign current_label = page.title
  assign parent_page = section.settings.parent_page
  if request.page_type == 'metaobject' and metaobject.system.type == 'size_chart'
    assign current_label = metaobject.title.value
    if parent_page == blank
      assign parent_page = settings.size_chart_index_page | default: pages['size-charts']
    endif
  endif
-%}
<div class="page-breadcrumbs">
  {% render 'ui-breadcrumbs', root_label: 'Home', root_url: routes.root_url, parent_label: parent_page.title, parent_url: parent_page.url, current_label: current_label %}
</div>

{% stylesheet %}
  .page-breadcrumbs { padding: 1.4rem 1.6rem; }
  .page-breadcrumbs .ui-breadcrumbs { flex-wrap: wrap; font-size: 1.2rem; line-height: 2rem; letter-spacing: 0; }
  .page-breadcrumbs [aria-current] { min-width: 0; overflow-wrap: anywhere; }
  @media (min-width: 750px) { .page-breadcrumbs { padding-inline: 3.2rem; } }
  @media (min-width: 1100px) { .page-breadcrumbs { padding: 1.8rem max(3.2rem, calc((100% - 124.8rem) / 2)); } }
{% endstylesheet %}

{% schema %}
{
  "name": "Page breadcrumbs",
  "tag": "section",
  "settings": [
    { "type": "page", "id": "parent_page", "label": "Parent page", "info": "Optional. Size chart pages use the shared directory page when empty." }
  ]
}
{% endschema %}