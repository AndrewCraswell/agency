{{ 'size-chart.css' | asset_url | stylesheet_tag }}

{%- assign directory_heading = section.settings.heading | default: page.title -%}
<div class="size-charts-page">
  <div class="size-charts-page__main size-charts-page__main--columns-{{ section.settings.columns | default: '2' }}">
    <h1 class="size-charts-page__title">{{ directory_heading | escape }}</h1>
    {% render 'size-chart-directory' %}
  </div>
</div>

{% schema %}
{
  "name": "Size charts directory",
  "tag": "section",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty to use the page title." },
    { "type": "select", "id": "columns", "label": "Columns on larger screens", "default": "2", "options": [
      { "value": "1", "label": "One" }, { "value": "2", "label": "Two" }, { "value": "3", "label": "Three" }
    ] },
    { "type": "paragraph", "content": "Manage group headings and chart membership in Content > Metaobjects > Size chart group. Select and order these groups in Theme settings > Size charts. Groups are shared with chart-page navigation." }
  ]
}
{% endschema %}