{{ 'section-main-404.css' | asset_url | stylesheet_tag }}
{{ 'component-support-band.css' | asset_url | stylesheet_tag }}

<section class="not-found">
  <div class="not-found__hero">
    <div class="not-found__content">
      <p class="not-found__code" aria-hidden="true">404</p>
      <h1 class="not-found__heading">{{ section.settings.heading | escape }}</h1>
      <p class="not-found__text">{{ section.settings.text | escape }}</p>

      {%- assign search_input_id = 'NotFoundSearch-' | append: section.id -%}
      {%- render 'ui-search-form',
        input_id: search_input_id,
        label: section.settings.search_label,
        button_label: section.settings.search_button_label,
        value: search.terms,
        class: 'not-found__search'
      -%}

      {%- render 'ui-link',
        label: section.settings.home_label,
        url: routes.root_url,
        icon: 'arrow-right',
        icon_position: 'before',
        reverse_icon: true,
        class: 'not-found__home-link'
      -%}
    </div>
  </div>

  {%- if section.settings.show_support_band -%}
    <div class="not-found__support">
      {%- assign contact_url = section.settings.support_primary_url | default: pages.contact.url -%}
      {%- assign browse_url = section.settings.support_secondary_url
        | default: routes.all_products_collection_url
      -%}
      {%- render 'ui-support-band',
        heading: section.settings.support_heading,
        text: section.settings.support_text,
        primary_label: section.settings.support_primary_label,
        primary_url: contact_url,
        secondary_label: section.settings.support_secondary_label,
        secondary_url: browse_url
      -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "404 page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We couldn't find that page."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "The product may have been discontinued or renamed, or the link may be out of date."
    },
    {
      "type": "text",
      "id": "search_label",
      "label": "Search label",
      "default": "Search for a product or page"
    },
    {
      "type": "text",
      "id": "search_button_label",
      "label": "Search button label",
      "default": "Search"
    },
    {
      "type": "text",
      "id": "home_label",
      "label": "Home link label",
      "default": "Back to homepage"
    },
    { "type": "header", "content": "Support card" },
    {
      "type": "checkbox",
      "id": "show_support_band",
      "label": "Show support card",
      "default": true
    },
    {
      "type": "text",
      "id": "support_heading",
      "label": "Heading",
      "default": "Looking for something we no longer stock?"
    },
    {
      "type": "textarea",
      "id": "support_text",
      "label": "Text",
      "default": "Tell us the model and we'll tell you what replaced it, or find you the closest equivalent."
    },
    {
      "type": "text",
      "id": "support_primary_label",
      "label": "Primary button label",
      "default": "Contact us"
    },
    { "type": "url", "id": "support_primary_url", "label": "Primary button link" },
    {
      "type": "text",
      "id": "support_secondary_label",
      "label": "Secondary button label",
      "default": "Browse all gear"
    },
    { "type": "url", "id": "support_secondary_url", "label": "Secondary button link" }
  ]
}
{% endschema %}
