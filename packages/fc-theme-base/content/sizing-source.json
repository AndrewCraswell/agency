  "guides": [
    { "key": "body", "title": "Chest and height", "image": "media/body.png", "alt": "Fencer showing chest circumference and standing height measurements.", "instructions": "Chest: Wrap a soft tape around the fullest part of your chest, under your arms. Keep it level and breathe normally.\n\nHeight: Stand upright and measure from the floor to the top of your head." },
    { "key": "pants", "title": "Waist and hips", "image": "media/pants.png", "alt": "Fencer showing where to measure waist and hip circumference.", "instructions": "Waist: Measure around your natural waist.\nHips: Measure around the fullest part of your hips.\nThen check your height against the same size." },
    { "key": "head", "title": "Head circumference", "image": "media/head.png", "alt": "Measuring tape passing beneath the chin and over the crown of the head.", "instructions": "Wrap a soft tape under your chin, up one side of your face, over your head, and down the other side to your chin. Keep it snug." },
    { "key": "hand", "title": "Hand circumference", "image": "media/hand.png", "alt": "Tape around the widest part of the hand below the knuckles, with the thumb outside the loop.", "instructions": "Wrap a soft tape around the widest part of your fencing hand, just below the knuckles. Keep your thumb outside the loop and the tape snug." },
    { "key": "socks", "title": "Sole and leg length", "image": "media/socks.png", "alt": "Sock measurements: A marks the sole from heel to toe; B marks the leg from heel upwards.", "instructions": "A - Sole length: Measure from your heel to your longest toe.\n\nB - Leg length: Measure from your heel to the height you want above your knee." }
  ],
  "advice": {
    "jackets": { "heading": "Between sizes?", "text": "For a close, athletic fit, choose the size that matches your measurements. Choose one size larger for extra shoulder room or a looser layer underneath.\n\nLamé jackets fit over a fencing jacket of the same size. No extra sizing adjustment is needed." },
    "pants": { "heading": "Between sizes?", "text": "If your hips fall in a larger size range, choose that size for room to move. Between sizes, choose larger for more room or smaller for a closer fit." },
    "underarm": { "heading": "Start with your height", "text": "Match your height first. If you're between sizes, use your chest measurement to help choose." },
    "chest": { "heading": "Between sizes?", "text": "Choose the larger size when your chest measurement falls between two sizes." },
    "masks": { "heading": "Adjust the fit", "text": "Between sizes, choose the larger size. If your mask feels loose or tight, ask your coach or an experienced teammate to help adjust it before exchanging sizes." },
    "gloves": { "heading": "Between sizes?", "text": "Choose the larger size when your hand measurement falls between two sizes." },
    "socks": { "heading": "Shoe size reference", "text": "Shoe sizes are US Mens sizes. The length columns give the sock's sole (A) and leg (B) measurements. If you're between sizes, choose the larger size." }
  },
