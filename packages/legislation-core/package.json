  "files": [
    "src",
    "infra",
    "scripts",
    "drizzle.config.ts"
  ],
  "scripts": {
    "check:types": "tsc --noEmit",
    "db:check": "drizzle-kit check --config=drizzle.config.ts",
    "db:down": "docker compose -f infra/local/compose.yaml down",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "tsx scripts/database.ts migrate",
    "db:reconcile-vote-date": "tsx scripts/reconcile-vote-date.ts",
    "db:reconcile-vote-order-indexes": "tsx scripts/reconcile-vote-order-indexes.ts",
    "db:query-stats": "tsx scripts/query-statistics.ts",
    "db:reset": "docker compose -f infra/local/compose.yaml down --volumes",
    "db:status": "docker compose -f infra/local/compose.yaml ps",
    "db:up": "docker compose -f infra/local/compose.yaml up -d --wait",
    "db:wait": "tsx scripts/database.ts wait",
    "lint": "oxlint --max-warnings=0",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:database": "vitest run --project database"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.8",
    "pg": "^8.22.0",
    "tiktoken": "1.0.22",
    "tiny-invariant": "^1.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/oxlint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.0",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  }
}
