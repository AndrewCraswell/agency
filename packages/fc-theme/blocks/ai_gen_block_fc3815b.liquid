{% doc %}
  @prompt
    I want a Shop By Brand section which highlights categories of brands we sell other than Fencing Club
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-shop-by-brand-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-shop-by-brand__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-shop-by-brand__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-shop-by-brand__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 12px;
    font-weight: 700;
    letter-spacing: 0.5px;
  }

  .ai-shop-by-brand__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    line-height: 1.6;
  }

  .ai-shop-by-brand__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-shop-by-brand__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }
  }

  .ai-shop-by-brand__item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.card_border_radius }}px;
    background-color: {{ block.settings.card_background }};
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-shop-by-brand__item-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .ai-shop-by-brand__link-{{ ai_gen_id }} {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .ai-shop-by-brand__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: {{ block.settings.image_background }};
  }

  .ai-shop-by-brand__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-shop-by-brand__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.image_background }};
  }

  .ai-shop-by-brand__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-shop-by-brand__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, {{ block.settings.overlay_opacity }}) 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ai-shop-by-brand__item-{{ ai_gen_id }}:hover .ai-shop-by-brand__overlay-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-shop-by-brand__content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    text-align: center;
  }

  .ai-shop-by-brand__brand-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.brand_name_size }}px;
    color: {{ block.settings.brand_name_color }};
    margin: 0 0 8px;
    font-weight: 600;
    letter-spacing: 0.5px;
  }

  .ai-shop-by-brand__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-shop-by-brand__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
  }

  .ai-shop-by-brand__empty-state-{{ ai_gen_id }} p {
    font-size: 16px;
    margin: 0;
  }
{% endstyle %}

<shop-by-brand-{{ ai_gen_id }}
  class="ai-shop-by-brand-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-shop-by-brand__container-{{ ai_gen_id }}">
    {% if block.settings.title != blank or block.settings.subtitle != blank %}
      <div class="ai-shop-by-brand__header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-shop-by-brand__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <div class="ai-shop-by-brand__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</div>
        {% endif %}
      </div>
    {% endif %}

    {% assign has_brands = false %}
    {% for i in (1..6) %}
      {% assign brand_enabled_key = 'brand_' | append: i | append: '_enabled' %}
      {% if block.settings[brand_enabled_key] %}
        {% assign has_brands = true %}
        {% break %}
      {% endif %}
    {% endfor %}

    {% if has_brands %}
      <div class="ai-shop-by-brand__grid-{{ ai_gen_id }}">
        {% for i in (1..6) %}
          {% liquid
            assign brand_enabled_key = 'brand_' | append: i | append: '_enabled'
            assign brand_name_key = 'brand_' | append: i | append: '_name'
            assign brand_image_key = 'brand_' | append: i | append: '_image'
            assign brand_description_key = 'brand_' | append: i | append: '_description'
            assign brand_link_key = 'brand_' | append: i | append: '_link'

            assign brand_enabled = block.settings[brand_enabled_key]
            assign brand_name = block.settings[brand_name_key]
            assign brand_image = block.settings[brand_image_key]
            assign brand_description = block.settings[brand_description_key]
            assign brand_link = block.settings[brand_link_key]
          %}

          {% if brand_enabled %}
            <div class="ai-shop-by-brand__item-{{ ai_gen_id }}">
              {% if brand_link != blank %}
                <a href="{{ brand_link }}" class="ai-shop-by-brand__link-{{ ai_gen_id }}">
              {% endif %}

              <div class="ai-shop-by-brand__image-wrapper-{{ ai_gen_id }}">
                {% if brand_image %}
                  <img
                    src="{{ brand_image | image_url: width: 800 }}"
                    alt="{{ brand_name | escape }}"
                    loading="lazy"
                    width="800"
                    height="800"
                    class="ai-shop-by-brand__image-{{ ai_gen_id }}"
                  >
                {% else %}
                  <div class="ai-shop-by-brand__placeholder-{{ ai_gen_id }}">
                    {{ 'collection-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
                <div class="ai-shop-by-brand__overlay-{{ ai_gen_id }}"></div>
              </div>

              <div class="ai-shop-by-brand__content-{{ ai_gen_id }}">
                {% if brand_name != blank %}
                  <h3 class="ai-shop-by-brand__brand-name-{{ ai_gen_id }}">{{ brand_name }}</h3>
                {% endif %}
                {% if brand_description != blank %}
                  <p class="ai-shop-by-brand__description-{{ ai_gen_id }}">{{ brand_description }}</p>
                {% endif %}
              </div>

              {% if brand_link != blank %}
                </a>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-shop-by-brand__empty-state-{{ ai_gen_id }}">
        <p>Enable and configure brand categories to showcase your partner brands</p>
      </div>
    {% endif %}
  </div>
</shop-by-brand-{{ ai_gen_id }}>

<script>
  (function() {
    class ShopByBrand{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.items = this.querySelectorAll('.ai-shop-by-brand__item-{{ ai_gen_id }}');
        this.setupAccessibility();
      }

      setupAccessibility() {
        this.items.forEach((item) => {
          const link = item.querySelector('.ai-shop-by-brand__link-{{ ai_gen_id }}');
          if (link) {
            link.setAttribute('role', 'link');
          }
        });
      }
    }

    customElements.define('shop-by-brand-{{ ai_gen_id }}', ShopByBrand{{ ai_gen_id }});
  })();
</script>

