{% doc %}
  @prompt
    I want a section that highlights our Kids category, showing the mask, vest, and full sets
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-kids-category-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-kids-category__container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-kids-category__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-kids-category__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 12px;
    font-weight: 700;
    letter-spacing: 0.025em;
  }

  .ai-kids-category__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
    margin: 0;
    line-height: 1.6;
  }

  .ai-kids-category__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-kids-category__item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.card_border_radius }}px;
    background-color: {{ block.settings.card_background }};
    border: 1px solid {{ block.settings.card_border_color }};
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-kids-category__item-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .ai-kids-category__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: {{ block.settings.image_background }};
  }

  .ai-kids-category__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-kids-category__image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.image_background }};
  }

  .ai-kids-category__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-kids-category__content-{{ ai_gen_id }} {
    padding: 24px 20px;
    text-align: center;
  }

  .ai-kids-category__item-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.item_title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 8px;
    font-weight: 700;
    letter-spacing: 0.025em;
  }

  .ai-kids-category__item-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.item_description_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
    margin: 0 0 16px;
    line-height: 1.5;
  }

  .ai-kids-category__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 28px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.05em;
    transition: background-color 0.3s ease, transform 0.2s ease;
  }

  .ai-kids-category__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
    transform: scale(1.02);
  }

  @media screen and (max-width: 989px) {
    .ai-kids-category__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-kids-category__item-{{ ai_gen_id }}:last-child {
      grid-column: 1 / -1;
      max-width: 500px;
      margin: 0 auto;
      width: 100%;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-kids-category-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.7 }}px 16px;
    }

    .ai-kids-category__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.grid_gap | times: 0.8 }}px;
    }

    .ai-kids-category__item-{{ ai_gen_id }}:last-child {
      grid-column: auto;
      max-width: 100%;
    }

    .ai-kids-category__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-kids-category__subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-kids-category-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-kids-category__container-{{ ai_gen_id }}">
    {% if block.settings.title != blank or block.settings.subtitle != blank %}
      <div class="ai-kids-category__header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-kids-category__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <div class="ai-kids-category__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-kids-category__grid-{{ ai_gen_id }}">
      <div class="ai-kids-category__item-{{ ai_gen_id }}">
        <div class="ai-kids-category__image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.mask_image %}
            <img
              src="{{ block.settings.mask_image | image_url: width: 800 }}"
              alt="{{ block.settings.mask_image.alt | escape }}"
              loading="lazy"
              width="800"
              height="800"
              class="ai-kids-category__image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-kids-category__image-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        <div class="ai-kids-category__content-{{ ai_gen_id }}">
          <h3 class="ai-kids-category__item-title-{{ ai_gen_id }}">{{ block.settings.mask_title }}</h3>
          {% if block.settings.mask_description != blank %}
            <p class="ai-kids-category__item-description-{{ ai_gen_id }}">{{ block.settings.mask_description }}</p>
          {% endif %}
          {% if block.settings.mask_link != blank %}
            <a href="{{ block.settings.mask_link }}" class="ai-kids-category__button-{{ ai_gen_id }}">
              {{ block.settings.button_text }}
            </a>
          {% endif %}
        </div>
      </div>

      <div class="ai-kids-category__item-{{ ai_gen_id }}">
        <div class="ai-kids-category__image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.vest_image %}
            <img
              src="{{ block.settings.vest_image | image_url: width: 800 }}"
              alt="{{ block.settings.vest_image.alt | escape }}"
              loading="lazy"
              width="800"
              height="800"
              class="ai-kids-category__image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-kids-category__image-placeholder-{{ ai_gen_id }}">
              {{ 'product-2' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        <div class="ai-kids-category__content-{{ ai_gen_id }}">
          <h3 class="ai-kids-category__item-title-{{ ai_gen_id }}">{{ block.settings.vest_title }}</h3>
          {% if block.settings.vest_description != blank %}
            <p class="ai-kids-category__item-description-{{ ai_gen_id }}">{{ block.settings.vest_description }}</p>
          {% endif %}
          {% if block.settings.vest_link != blank %}
            <a href="{{ block.settings.vest_link }}" class="ai-kids-category__button-{{ ai_gen_id }}">
              {{ block.settings.button_text }}
            </a>
          {% endif %}
        </div>
      </div>

      <div class="ai-kids-category__item-{{ ai_gen_id }}">
        <div class="ai-kids-category__image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.sets_image %}
            <img
              src="{{ block.settings.sets_image | image_url: width: 800 }}"
              alt="{{ block.settings.sets_image.alt | escape }}"
              loading="lazy"
              width="800"
              height="800"
              class="ai-kids-category__image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-kids-category__image-placeholder-{{ ai_gen_id }}">
              {{ 'product-3' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        <div class="ai-kids-category__content-{{ ai_gen_id }}">
          <h3 class="ai-kids-category__item-title-{{ ai_gen_id }}">{{ block.settings.sets_title }}</h3>
          {% if block.settings.sets_description != blank %}
            <p class="ai-kids-category__item-description-{{ ai_gen_id }}">{{ block.settings.sets_description }}</p>
          {% endif %}
          {% if block.settings.sets_link != blank %}
            <a href="{{ block.settings.sets_link }}" class="ai-kids-category__button-{{ ai_gen_id }}">
              {{ block.settings.button_text }}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

