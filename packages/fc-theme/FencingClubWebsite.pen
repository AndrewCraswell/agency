                              "id": "JbQDE",
                              "name": "Policy heading 8",
                              "context": "Source H2. Anchor policy-section-8",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "What if my package is delayed or lost?",
                              "lineHeight": 1.35,
