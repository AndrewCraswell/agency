                          "fill": "$ink",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "When you direct, request us or otherwise consent to our disclosure of certain information to third parties, such as to ship you products or through your use of social media widgets or login integrations, with your consent.",
                          "lineHeight": 1.6,
                          "fontFamily": "$font-body",
                          "fontSize": 16,
                          "fontWeight": "normal"
                        }
                      ]
