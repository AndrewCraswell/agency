                              "padding": 12,
                              "children": [
                                {
                                  "type": "text",
                                  "id": "blU92",
                                  "name": "Policy table text disclosure 1-1",
                                  "fill": "$ink",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "Vendors and third parties who perform services on our behalf (such as Internet service providers, payment processors, fulfillment partners, customer support partners and data analytics providers)\n\nBusiness and marketing partners\n\nAffiliates",
                                  "lineHeight": 1.6,
                                  "fontFamily": "$font-body",
