                      "fontFamily": "$font-body",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "RJPCg",
                      "name": "Policy heading spacing 50",
                      "width": "fill_container",
                      "layout": "vertical",
                      "padding": [
