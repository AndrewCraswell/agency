                          "id": "MCk4Z",
                          "name": "Policy section 6",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 16,
                          "children": [
                            {
                              "type": "text",
                              "id": "yP70J",
                              "name": "Policy heading 6",
                              "context": "Source H2. Anchor policy-section-6",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Will my order ship in multiple packages?",
                              "lineHeight": 1.35,
                              "fontFamily": "$font-display",
                              "fontSize": 22,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "SARYH",
                              "name": "Policy paragraph 6-1",
                              "context": "Published policy paragraph, verbatim. Inline source links: support@fencing.club -> mailto:support@fencing.club; account order history -> https://account.fencing.club/; Refund Policy -> https://fencing.club/policies/refund-policy. Preserve only links present in this paragraph.",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Orders containing multiple items may ship in separate packages depending on item availability and packaging requirements. There is no additional charge for split shipments. Each package will receive its own tracking number.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
