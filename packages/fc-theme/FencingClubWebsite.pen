                    {
                      "type": "frame",
                      "id": "FDtp5",
                      "name": "Policy article",
                      "context": "Render Shopify policy rich text semantically: headings, paragraphs, lists, links and tables. Do not hide legal text behind accordions. Reading width 760px; mobile 16px gutters. Browser find, text selection and print remain available.",
                      "width": 760,
                      "layout": "vertical",
                      "gap": 32,
                      "children": [
                        {
                          "type": "frame",
                          "id": "roAHy",
                          "name": "Policy section 1",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 16,
                          "children": [
                            {
                              "type": "text",
                              "id": "RjISY",
                              "name": "Policy heading 1",
                              "context": "Source H2. Anchor policy-section-1",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "How fast will my order be dispatched?",
                              "lineHeight": 1.35,
                              "fontFamily": "$font-display",
                              "fontSize": 22,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "DckVq",
                              "name": "Policy paragraph 1-1",
                              "context": "Published policy paragraph, verbatim. Inline source links: support@fencing.club -> mailto:support@fencing.club; account order history -> https://account.fencing.club/; Refund Policy -> https://fencing.club/policies/refund-policy. Preserve only links present in this paragraph.",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "We process orders Monday through Friday, US Pacific Time. Orders are typically processed and dispatched within 1 business day. Orders placed by 1:00 PM Pacific Time on a business day will generally ship the same day.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "vWtvb",
                              "name": "Policy paragraph 1-2",
                              "context": "Published policy paragraph, verbatim. Inline source links: support@fencing.club -> mailto:support@fencing.club; account order history -> https://account.fencing.club/; Refund Policy -> https://fencing.club/policies/refund-policy. Preserve only links present in this paragraph.",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Orders placed after the cutoff time, on weekends, or on US federal holidays will be processed the next business day. Processing times may be extended during peak periods such as holidays, major promotions, tournaments, or periods of high order volume.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "N0ObSH",
                              "name": "Policy paragraph 1-3",
                              "context": "Published policy text. Preserve inline anchors with underlined accessible link styling in the actual rich-text renderer: support@fencing.club -> mailto:support@fencing.club. The .pen stores link destinations in this context because text href is not retained by the editor.",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "If you have specific shipping needs, please contact us via online chat or at support@fencing.club before placing your order.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "beTQd",
                          "name": "Policy section 2",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 16,
                          "children": [
                            {
                              "type": "text",
                              "id": "v9wzh",
                              "name": "Policy heading 2",
                              "context": "Source H2. Anchor policy-section-2",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "How long before my order arrives?",
                              "lineHeight": 1.35,
                              "fontFamily": "$font-display",
                              "fontSize": 22,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "rcxuH",
                              "name": "Policy paragraph 2-1",
                              "context": "Published policy paragraph, verbatim. Inline source links: support@fencing.club -> mailto:support@fencing.club; account order history -> https://account.fencing.club/; Refund Policy -> https://fencing.club/policies/refund-policy. Preserve only links present in this paragraph.",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "For orders shipped within the United States, delivery typically takes 5–8 business days when using ground shipping options. Faster shipping services may be available at checkout and typically arrive within 2–3 business days after dispatch.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "kpBZU",
                              "name": "Policy paragraph 2-2",
                              "context": "Published policy paragraph, verbatim. Inline source links: support@fencing.club -> mailto:support@fencing.club; account order history -> https://account.fencing.club/; Refund Policy -> https://fencing.club/policies/refund-policy. Preserve only links present in this paragraph.",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Delivery times consist of order processing time plus carrier transit time. Estimated delivery dates shown at checkout are provided by the carrier and are not guaranteed.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "uznu2",
                              "name": "Policy paragraph 2-3",
                              "context": "Published policy paragraph, verbatim. Inline source links: support@fencing.club -> mailto:support@fencing.club; account order history -> https://account.fencing.club/; Refund Policy -> https://fencing.club/policies/refund-policy. Preserve only links present in this paragraph.",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Shipping costs, available shipping services, and delivery estimates are calculated and displayed during checkout before payment is completed.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "r3fd0P",
                          "name": "Policy section 3",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 16,
                          "children": [
                            {
                              "type": "text",
                              "id": "mSVed",
                              "name": "Policy heading 3",
                              "context": "Source H2. Anchor policy-section-3",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "How do you ship?",
                              "lineHeight": 1.35,
                              "fontFamily": "$font-display",
                              "fontSize": 22,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "izH3z",
                              "name": "Policy paragraph 3-1",
                              "context": "Published policy paragraph, verbatim. Inline source links: support@fencing.club -> mailto:support@fencing.club; account order history -> https://account.fencing.club/; Refund Policy -> https://fencing.club/policies/refund-policy. Preserve only links present in this paragraph.",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "We ship domestically within the United States using USPS, UPS, and FedEx. We ship to residential addresses, PO Boxes, and APO/FPO addresses.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "K9cOa",
                              "name": "Policy paragraph 3-2",
                              "context": "Published policy paragraph, verbatim. Inline source links: support@fencing.club -> mailto:support@fencing.club; account order history -> https://account.fencing.club/; Refund Policy -> https://fencing.club/policies/refund-policy. Preserve only links present in this paragraph.",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "For international orders, we offer DHL and UPS worldwide shipping where available.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "XT5JZ",
                          "name": "Policy section 4",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 16,
                          "children": [
                            {
                              "type": "text",
                              "id": "J6SFQH",
                              "name": "Policy heading 4",
                              "context": "Source H2. Anchor policy-section-4",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Do you ship internationally?",
                              "lineHeight": 1.35,
                              "fontFamily": "$font-display",
                              "fontSize": 22,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "tAnII",
                              "name": "Policy paragraph 4-1",
                              "context": "Published policy paragraph, verbatim. Inline source links: support@fencing.club -> mailto:support@fencing.club; account order history -> https://account.fencing.club/; Refund Policy -> https://fencing.club/policies/refund-policy. Preserve only links present in this paragraph.",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "We ship to most countries worldwide. We do not ship to countries subject to trade embargoes or other shipping restrictions. The estimated delivery time is 7-25 business days depending on destination.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "Hx12S",
                          "name": "Policy section 5",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 16,
                          "children": [
                            {
                              "type": "text",
                              "id": "n0Qt5",
                              "name": "Policy heading 5",
                              "context": "Source H2. Anchor policy-section-5",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Who pays duties, customs, and tariffs?",
                              "lineHeight": 1.35,
                              "fontFamily": "$font-display",
                              "fontSize": 22,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "gyrxI",
                              "name": "Policy paragraph 5-1",
                              "context": "Published policy paragraph, verbatim. Inline source links: support@fencing.club -> mailto:support@fencing.club; account order history -> https://account.fencing.club/; Refund Policy -> https://fencing.club/policies/refund-policy. Preserve only links present in this paragraph.",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "For international orders, we ship duties paid (DDP). All applicable duties, customs fees, and import taxes are included at checkout. You will not be responsible for additional customs charges upon delivery.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "g4J8v",
                              "name": "Policy paragraph 5-2",
                              "context": "Published policy paragraph, verbatim. Inline source links: support@fencing.club -> mailto:support@fencing.club; account order history -> https://account.fencing.club/; Refund Policy -> https://fencing.club/policies/refund-policy. Preserve only links present in this paragraph.",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "While duties are prepaid, international delivery times may vary due to customs clearance processes outside of our control.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "MCk4Z",
                          "name": "Policy section 6",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 16,
                          "children": [
                            {
                              "type": "text",
                              "id": "yP70J",
                              "name": "Policy heading 6",
                              "context": "Source H2. Anchor policy-section-6",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Will my order ship in multiple packages?",
                              "lineHeight": 1.35,
                              "fontFamily": "$font-display",
                              "fontSize": 22,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "SARYH",
                              "name": "Policy paragraph 6-1",
                              "context": "Published policy paragraph, verbatim. Inline source links: support@fencing.club -> mailto:support@fencing.club; account order history -> https://account.fencing.club/; Refund Policy -> https://fencing.club/policies/refund-policy. Preserve only links present in this paragraph.",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Orders containing multiple items may ship in separate packages depending on item availability and packaging requirements. There is no additional charge for split shipments. Each package will receive its own tracking number.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "KRGV8",
                          "name": "Policy section 7",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 16,
                          "children": [
                            {
                              "type": "text",
                              "id": "GApNv",
                              "name": "Policy heading 7",
                              "context": "Source H2. Anchor policy-section-7",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "How do I track my order?",
                              "lineHeight": 1.35,
                              "fontFamily": "$font-display",
                              "fontSize": 22,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "hQ7cF",
                              "name": "Policy paragraph 7-1",
                              "context": "Published policy text. Preserve inline anchors with underlined accessible link styling in the actual rich-text renderer: account order history -> https://account.fencing.club/. The .pen stores link destinations in this context because text href is not retained by the editor.",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Once your order ships, you will receive an email notification with tracking information. You can also track your order at any time by accessing your account order history.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
