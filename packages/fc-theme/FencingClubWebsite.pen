                          "id": "xp4BR",
                          "name": "Policy H3 19",
                          "context": "Published H3. Anchor policy-block-19",
                          "fill": "$ink",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Information We Obtain from Third Parties",
                          "lineHeight": 1.35,
                          "fontFamily": "$font-display",
                          "fontSize": 18,
