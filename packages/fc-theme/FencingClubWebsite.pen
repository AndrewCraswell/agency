                          ],
                          "children": [
                            {
                              "type": "text",
                              "id": "ocdXT",
                              "name": "Policy H3 25",
                              "context": "Published H3. Anchor policy-block-25",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "How We Use Your Personal Information",
                              "lineHeight": 1.35,
                              "fontFamily": "$font-display",
                              "fontSize": 18,
                              "fontWeight": "600"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "nAt1S",
                          "name": "Policy list item 26",
                          "width": "fill_container",
                          "gap": 12,
                          "children": [
                            {
                              "type": "text",
                              "id": "kaRnx",
                              "name": "List marker 26",
                              "fill": "$ink",
                              "content": "-",
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "eEoVr",
                              "name": "Policy list text 26",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Providing Products and Services. We use your personal information to provide you with the Services in order to perform our contract with you, including to process your payments, fulfill your orders, to send notifications to you related to your account, purchases, returns, exchanges or other transactions, to create, maintain and otherwise manage your account, to arrange for shipping, facilitate any returns and exchanges and other features and functionalities related to your account. We may also enhance your shopping experience by enabling Shopify to match your account with other Shopify services that you may choose to use. In this case, Shopify will process your information as set forth in its Privacy Policy and Consumer Privacy Policy.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "hucsm",
                          "name": "Policy list item 27",
                          "width": "fill_container",
                          "gap": 12,
                          "children": [
                            {
                              "type": "text",
                              "id": "in17o",
                              "name": "List marker 27",
                              "fill": "$ink",
                              "content": "-",
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "BtIDi",
                              "name": "Policy list text 27",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Marketing and Advertising. We may use your personal information for marketing and promotional purposes, such as to send marketing, advertising and promotional communications by email, text message or postal mail, and to show you advertisements for products or services. This may include using your personal information to better tailor the Services and advertising on our Site and other websites. If you are an EEA resident, the legal basis for these data processing activities is our legitimate interest in selling our products, according to Art. 6 (1) (f) GDPR.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "MMKhE",
                          "name": "Policy list item 28",
                          "width": "fill_container",
                          "gap": 12,
                          "children": [
                            {
                              "type": "text",
                              "id": "at7bV",
                              "name": "List marker 28",
                              "fill": "$ink",
                              "content": "-",
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "MOX61",
                              "name": "Policy list text 28",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Security and Fraud Prevention. We use your personal information to detect, investigate or take action regarding possible fraudulent, illegal or malicious activity. If you choose to use the Services and register an account, you are responsible for keeping your account credentials safe. We highly recommend that you do not share your username, password, or other access details with anyone else. If you believe your account has been compromised, please contact us immediately. If you are an EEA resident, the legal basis for these data processing activities is our legitimate interest in keeping our website secure for you and other customers, according to Art. 6 (1) (f) GDPR.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "n1Mnm",
                          "name": "Policy list item 29",
                          "width": "fill_container",
                          "gap": 12,
                          "children": [
                            {
                              "type": "text",
                              "id": "fbb89",
                              "name": "List marker 29",
                              "fill": "$ink",
                              "content": "-",
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "ZU0LL",
                              "name": "Policy list text 29",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Communicating with You and Service Improvement. We use your personal information to provide you with customer support and improve our Services. This is in our legitimate interests in order to be responsive to you, to provide effective services to you, and to maintain our business relationship with you according to Art. 6 (1) (f) GDPR.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "h4n24i",
                          "name": "Policy heading spacing 30",
                          "width": "fill_container",
                          "layout": "vertical",
                          "padding": [
                            16,
                            0,
                            0,
                            0
                          ],
                          "children": [
                            {
                              "type": "text",
                              "id": "tolHB",
                              "name": "Policy H2 30",
                              "context": "Published H2. Anchor policy-block-30",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Cookies",
                              "lineHeight": 1.4,
                              "fontFamily": "$font-display",
                              "fontSize": 20,
                              "fontWeight": "600"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "HXd5g",
                          "name": "Policy paragraph 31",
                          "context": "Published policy text. Preserve inline anchors with underlined accessible link styling in the actual rich-text renderer: https://www.shopify.com/legal/cookies -> https://www.shopify.com/legal/cookies. The .pen stores link destinations in this context because text href is not retained by the editor.",
                          "fill": "$ink",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Like many websites, we use Cookies on our Site. For specific information about the Cookies that we use related to powering our store with Shopify, see https://www.shopify.com/legal/cookies. We use Cookies to power and improve our Site and our Services (including to remember your actions and preferences), to run analytics and better understand user interaction with the Services (in our legitimate interests to administer, improve and optimize the Services). We may also permit third parties and services providers to use Cookies on our Site to better tailor the services, products and advertising on our Site and other websites.",
                          "lineHeight": 1.6,
                          "fontFamily": "$font-body",
                          "fontSize": 16,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "gXibX",
                          "name": "Policy paragraph 32",
                          "context": "Published Privacy Policy paragraph; retain wording and source anchors. Capture date 2026-09-06.",
                          "fill": "$ink",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Most browsers automatically accept Cookies by default, but you can choose to set your browser to remove or reject Cookies through your browser controls. Please keep in mind that removing or blocking Cookies can negatively impact your user experience and may cause some of the Services, including certain features and general functionality, to work incorrectly or no longer be available. Additionally, blocking Cookies may not completely prevent how we share information with third parties such as our advertising partners.",
                          "lineHeight": 1.6,
                          "fontFamily": "$font-body",
                          "fontSize": 16,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "wRwzA",
                          "name": "Policy paragraph 33",
                          "context": "Published policy text. Preserve inline anchors with underlined accessible link styling in the actual rich-text renderer: https://globalprivacycontrol.org/ -> https://globalprivacycontrol.org/. The .pen stores link destinations in this context because text href is not retained by the editor.",
                          "fill": "$ink",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Our website also recognizes the Global Privacy Control (GPC) signal, which enables you to opt-out of certain uses or disclosures of your information. If you notify us of your preference through GPC, we will treat such signal as a valid request to opt out of sharing / targeted advertising for the associated browser or device, and, if we are able to associate the device sending the signal to a Shopify account, we will apply the opt out request to the account as well. To learn more about Global Privacy Control, you can visit https://globalprivacycontrol.org/. Other than the Global Privacy Control, we do not recognize other “Do Not Track” signals that may be sent from your web browser or device.",
                          "lineHeight": 1.6,
                          "fontFamily": "$font-body",
                          "fontSize": 16,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "frame",
                          "id": "D1fqb",
                          "name": "Policy heading spacing 34",
                          "width": "fill_container",
                          "layout": "vertical",
                          "padding": [
                            16,
                            0,
                            0,
                            0
                          ],
                          "children": [
                            {
                              "type": "text",
                              "id": "zO8Fi",
                              "name": "Policy H2 34",
                              "context": "Published H2. Anchor policy-block-34",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "How We Disclose Personal Information",
                              "lineHeight": 1.4,
                              "fontFamily": "$font-display",
                              "fontSize": 20,
                              "fontWeight": "600"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "Pzghp",
                          "name": "Policy paragraph 35",
                          "context": "Published Privacy Policy paragraph; retain wording and source anchors. Capture date 2026-09-06.",
                          "fill": "$ink",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "In certain circumstances, we may disclose your personal information to third parties for contract fulfillment purposes, legitimate purposes and other reasons subject to this Privacy Policy. Such circumstances may include:",
                          "lineHeight": 1.6,
                          "fontFamily": "$font-body",
                          "fontSize": 16,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "frame",
                          "id": "ai4jR",
                          "name": "Policy list item 36",
                          "width": "fill_container",
                          "gap": 12,
                          "children": [
                            {
                              "type": "text",
                              "id": "J2UuH",
                              "name": "List marker 36",
                              "fill": "$ink",
                              "content": "-",
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "m2KN7B",
                              "name": "Policy list text 36",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "With vendors or other third parties who perform services on our behalf (e.g., IT management, payment processing, data analytics, customer support, cloud storage, fulfillment and shipping).",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "x2p65j",
                          "name": "Policy list item 37",
                          "width": "fill_container",
                          "gap": 12,
                          "children": [
                            {
                              "type": "text",
                              "id": "T442fT",
                              "name": "List marker 37",
                              "fill": "$ink",
                              "content": "-",
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "fwHiO",
                              "name": "Policy list text 37",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "With business and marketing partners to provide services and advertise to you. Our business and marketing partners will use your information in accordance with their own privacy notices.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
