                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Security and Retention of Your Information",
                              "lineHeight": 1.4,
                              "fontFamily": "$font-display",
                              "fontSize": 20,
