                              "id": "MshXD",
                              "name": "Policy H2 47",
                              "context": "Published H2. Anchor policy-block-47",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "User Generated Content",
                              "lineHeight": 1.4,
                              "fontFamily": "$font-display",
                              "fontSize": 20,
