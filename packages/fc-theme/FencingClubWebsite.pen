                            },
                            {
                              "type": "text",
                              "id": "mW6u0",
                              "name": "Policy list text 23",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "When you visit our Site, open or click on emails we send you, or interact with our Services or advertisements, we, or third parties we work with, may automatically collect certain information using online tracking technologies such as pixels, web beacons, software developer kits, third-party libraries, and cookies.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "PVo07",
                          "name": "Policy paragraph 24",
                          "context": "Published Privacy Policy paragraph; retain wording and source anchors. Capture date 2026-09-06.",
                          "fill": "$ink",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Any information we obtain from third parties will be treated in accordance with this Privacy Policy. Also see the section below, Third Party Websites and Links.",
                          "lineHeight": 1.6,
                          "fontFamily": "$font-body",
                          "fontSize": 16,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "frame",
