                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "g4EfK",
                      "name": "Policy paragraph 11",
                      "context": "Published Privacy Policy paragraph; retain wording and source anchors. Capture date 2026-09-06.",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Information that you directly submit to us through our Services may include:",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
