                          "fill": "$ink",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "For the purpose of applicable data protection laws and if not explicitly stated otherwise, we are the data controller of your personal information.",
                          "lineHeight": 1.6,
