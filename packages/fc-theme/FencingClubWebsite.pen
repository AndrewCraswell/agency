        {
          "type": "frame",
          "id": "vHert",
          "name": "Spec — Results Page",
          "width": "fill_container",
          "gap": 48,
          "children": [
            {
              "type": "frame",
              "id": "B3Bx3M",
              "name": "Column A",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 28,
              "children": [
                {
                  "type": "frame",
                  "id": "dNLIo",
                  "name": "Result types",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 8,
                  "children": [
                    {
                      "type": "text",
                      "id": "VFNH2",
                      "name": "Heading",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Result types",
                      "fontFamily": "$font-display",
                      "fontSize": 17,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "Btp5b",
                      "name": "Body",
                      "fill": "$ink-soft",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "search.results returns products, articles and pages only. Collections are never returned — they appear in predictive search alone, where they render as Categories. Verified live: “masks” and “weapons” return products and articles but no collection.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 14.5,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "YiUWX",
                  "name": "Sort options",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 8,
                  "children": [
                    {
                      "type": "text",
                      "id": "e1nMaN",
                      "name": "Heading",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Sort options",
                      "fontFamily": "$font-display",
                      "fontSize": 17,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "c5fcI",
                      "name": "Body",
                      "fill": "$ink-soft",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "search.sort_options returns exactly three values: relevance (default while a query exists), price-ascending and price-descending. The richer collection sorts — featured, best selling, alphabetical and date — are not offered on search.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 14.5,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "HMaia",
                  "name": "Filters",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 8,
                  "children": [
                    {
                      "type": "text",
                      "id": "MT4QK",
                      "name": "Heading",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Filters",
                      "fontFamily": "$font-display",
                      "fontSize": 17,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "mXWfs",
                      "name": "Body",
                      "fill": "$ink-soft",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "filter.v.availability and filter.v.price are variant-level product filters. Neither can apply to an article or a page.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 14.5,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "x13Yhk",
                  "name": "Result order",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 8,
                  "children": [
                    {
                      "type": "text",
                      "id": "NuBhZ",
                      "name": "Heading",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Result order",
                      "fontFamily": "$font-display",
                      "fontSize": 17,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "OrbG1",
                      "name": "Body",
                      "fill": "$ink-soft",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Results are grouped, not relevance-ordered. Products come first, then pages, then articles. Within Pages & Articles, pages lead because they are usually the direct answer — someone searching “returns” or “size chart” wants the page, not a post about it. A highly relevant article will therefore sit below a weaker page match. This is intentional; do not iterate search.results in raw order.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 14.5,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            },
            {
              "type": "frame",
              "id": "GIGUk",
              "name": "Column B",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 28,
              "children": [
                {
                  "type": "frame",
                  "id": "Zzf6v",
                  "name": "Scoped controls — intentional divergence",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 8,
                  "children": [
                    {
                      "type": "text",
                      "id": "TORO1",
                      "name": "Heading",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Scoped controls — intentional divergence",
                      "fontFamily": "$font-display",
                      "fontSize": 17,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "eDh0S",
                      "name": "Body",
                      "fill": "$ink-soft",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Filter and sort sit inside the Products section because all three only affect products. Today main-search.liquid drops every article and page the moment a product filter is applied: “mask” falls from 3 results to 1 with no explanation on screen. This design specifies that filtering narrows the Products section only and leaves Pages & Articles at its full count. Implementing it requires a change to main-search.liquid.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 14.5,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "B2AV0",
                  "name": "Page results",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 8,
                  "children": [
                    {
                      "type": "text",
                      "id": "Yqvf6",
                      "name": "Heading",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Page results",
                      "fontFamily": "$font-display",
                      "fontSize": 17,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "UHG2a",
                      "name": "Body",
                      "fill": "$ink-soft",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Pages carry no image, so they use Page Result Row — a compact hairline-separated row with a file-text icon, title and one-line excerpt. They deliberately do not use Blog Card: a tinted block standing in for a missing photo reads as a broken thumbnail and gives a utility page the same weight as a photographed article.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 14.5,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "b67AQ",
                  "name": "Empty and filtered states",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 8,
                  "children": [
                    {
                      "type": "text",
                      "id": "hX73G",
                      "name": "Heading",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Empty and filtered states",
                      "fontFamily": "$font-display",
                      "fontSize": 17,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "QeA0X",
                      "name": "Body",
                      "fill": "$ink-soft",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "When a filter removes every product, keep the Products heading and show an empty note rather than hiding the section, so the count change is visible. Pages & Articles stays rendered regardless.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 14.5,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "y0y2p",
                  "name": "Mobile controls",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 8,
                  "children": [
                    {
                      "type": "text",
                      "id": "PNJv1",
                      "name": "Heading",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Mobile controls",
                      "fontFamily": "$font-display",
                      "fontSize": 17,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "XbgIT",
                      "name": "Body",
                      "fill": "$ink-soft",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Availability, Price and Sort do not fit across 350px, so they collapse into a single full-width “Filter and sort” control that opens a sheet. This matches the mobile pattern already in facets.liquid.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 14.5,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            }
          ]
        },
