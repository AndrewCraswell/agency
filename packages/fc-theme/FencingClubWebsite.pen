                          "fill": "$ink",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "SECTION 7 - OPTIONAL TOOLS",
                          "lineHeight": 1.35,
                          "fontFamily": "$font-display",
                          "fontSize": 22,
                          "fontWeight": "600"
