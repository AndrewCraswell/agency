                          "gap": 16,
                          "children": [
                            {
                              "type": "text",
                              "id": "Lmi0l",
                              "name": "Policy heading 5",
                              "context": "Source H2. Anchor policy-section-5",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Who pays duties, customs, and tariffs?",
                              "lineHeight": 1.35,
                              "fontFamily": "$font-display",
                              "fontSize": 22,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "jmjWM",
                              "name": "Policy paragraph 5-1",
                              "context": "Published policy paragraph, verbatim. Inline source links: support@fencing.club -> mailto:support@fencing.club; account order history -> https://account.fencing.club/; Refund Policy -> https://fencing.club/policies/refund-policy. Preserve only links present in this paragraph.",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "For international orders, we ship duties paid (DDP). All applicable duties, customs fees, and import taxes are included at checkout. You will not be responsible for additional customs charges upon delivery.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "OMdSK",
                              "name": "Policy paragraph 5-2",
                              "context": "Published policy paragraph, verbatim. Inline source links: support@fencing.club -> mailto:support@fencing.club; account order history -> https://account.fencing.club/; Refund Policy -> https://fencing.club/policies/refund-policy. Preserve only links present in this paragraph.",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "While duties are prepaid, international delivery times may vary due to customs clearance processes outside of our control.",
