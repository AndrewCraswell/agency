                              "type": "text",
                              "id": "AMrFi",
                              "name": "Policy list text 21",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Companies who support our Site and Services, such as Shopify.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "RYX1K",
                          "name": "Policy list item 22",
                          "width": "fill_container",
