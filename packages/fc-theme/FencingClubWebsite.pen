                        0
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "WeegK",
                          "name": "Policy H2 5",
                          "context": "Published H2. Anchor policy-block-5",
                          "fill": "$ink",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "How We Collect and Use Your Personal Information",
                          "lineHeight": 1.35,
                          "fontFamily": "$font-display",
                          "fontSize": 22,
                          "fontWeight": "600"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "D4huu",
                      "name": "Policy paragraph 6",
                      "context": "Published Privacy Policy paragraph; retain wording and source anchors. Capture date 2026-09-06.",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "To provide the Services, we collect and have collected over the past 12 months personal information about you from a variety of sources, as set out below. The information that we collect and use varies depending on how you interact with us.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "nfkxS",
                      "name": "Policy paragraph 7",
                      "context": "Published Privacy Policy paragraph; retain wording and source anchors. Capture date 2026-09-06.",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "In addition to the specific uses set out below, we may use information we collect about you to communicate with you, provide or improve or improve the Services, comply with any applicable legal obligations, enforce any applicable terms of service, and to protect or defend the Services, our rights, and the rights of our users or others.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "Th73E",
                      "name": "Policy heading spacing 8",
