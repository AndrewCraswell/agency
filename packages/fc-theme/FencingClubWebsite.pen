                      "name": "Policy article",
                      "context": "Render Shopify policy rich text semantically: headings, paragraphs, lists, links and tables. Do not hide legal text behind accordions. Reading width 760px; mobile 16px gutters. Browser find, text selection and print remain available.",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 32,
                      "children": [
                        {
                          "type": "frame",
                          "id": "vUdbB",
                          "name": "Policy section 1",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 16,
                          "children": [
                            {
                              "type": "text",
                              "id": "MOEj5",
                              "name": "Policy heading 1",
                              "context": "Source H2. Anchor policy-section-1",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "How fast will my order be dispatched?",
                              "lineHeight": 1.35,
                              "fontFamily": "$font-display",
                              "fontSize": 22,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "VokTo",
                              "name": "Policy paragraph 1-1",
                              "context": "Published policy paragraph, verbatim. Inline source links: support@fencing.club -> mailto:support@fencing.club; account order history -> https://account.fencing.club/; Refund Policy -> https://fencing.club/policies/refund-policy. Preserve only links present in this paragraph.",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "We process orders Monday through Friday, US Pacific Time. Orders are typically processed and dispatched within 1 business day. Orders placed by 1:00 PM Pacific Time on a business day will generally ship the same day.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "RzYaq",
                              "name": "Policy paragraph 1-2",
                              "context": "Published policy paragraph, verbatim. Inline source links: support@fencing.club -> mailto:support@fencing.club; account order history -> https://account.fencing.club/; Refund Policy -> https://fencing.club/policies/refund-policy. Preserve only links present in this paragraph.",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Orders placed after the cutoff time, on weekends, or on US federal holidays will be processed the next business day. Processing times may be extended during peak periods such as holidays, major promotions, tournaments, or periods of high order volume.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "cRWxY",
                              "name": "Policy paragraph 1-3",
                              "context": "Published policy text. Preserve inline anchors with underlined accessible link styling in the actual rich-text renderer: support@fencing.club -> mailto:support@fencing.club. The .pen stores link destinations in this context because text href is not retained by the editor.",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "If you have specific shipping needs, please contact us via online chat or at support@fencing.club before placing your order.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "p6B7jd",
                          "name": "Policy section 2",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 16,
                          "children": [
                            {
                              "type": "text",
                              "id": "k2K9J",
                              "name": "Policy heading 2",
                              "context": "Source H2. Anchor policy-section-2",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "How long before my order arrives?",
                              "lineHeight": 1.35,
                              "fontFamily": "$font-display",
                              "fontSize": 22,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "O6j8OW",
                              "name": "Policy paragraph 2-1",
                              "context": "Published policy paragraph, verbatim. Inline source links: support@fencing.club -> mailto:support@fencing.club; account order history -> https://account.fencing.club/; Refund Policy -> https://fencing.club/policies/refund-policy. Preserve only links present in this paragraph.",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "For orders shipped within the United States, delivery typically takes 5–8 business days when using ground shipping options. Faster shipping services may be available at checkout and typically arrive within 2–3 business days after dispatch.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "St21i",
                              "name": "Policy paragraph 2-2",
                              "context": "Published policy paragraph, verbatim. Inline source links: support@fencing.club -> mailto:support@fencing.club; account order history -> https://account.fencing.club/; Refund Policy -> https://fencing.club/policies/refund-policy. Preserve only links present in this paragraph.",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Delivery times consist of order processing time plus carrier transit time. Estimated delivery dates shown at checkout are provided by the carrier and are not guaranteed.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "PtMAs",
                              "name": "Policy paragraph 2-3",
                              "context": "Published policy paragraph, verbatim. Inline source links: support@fencing.club -> mailto:support@fencing.club; account order history -> https://account.fencing.club/; Refund Policy -> https://fencing.club/policies/refund-policy. Preserve only links present in this paragraph.",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Shipping costs, available shipping services, and delivery estimates are calculated and displayed during checkout before payment is completed.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "rZfV4",
                          "name": "Policy section 3",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 16,
                          "children": [
                            {
                              "type": "text",
                              "id": "pAPJo",
                              "name": "Policy heading 3",
                              "context": "Source H2. Anchor policy-section-3",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "How do you ship?",
                              "lineHeight": 1.35,
                              "fontFamily": "$font-display",
                              "fontSize": 22,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "Q6XOsY",
                              "name": "Policy paragraph 3-1",
                              "context": "Published policy paragraph, verbatim. Inline source links: support@fencing.club -> mailto:support@fencing.club; account order history -> https://account.fencing.club/; Refund Policy -> https://fencing.club/policies/refund-policy. Preserve only links present in this paragraph.",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "We ship domestically within the United States using USPS, UPS, and FedEx. We ship to residential addresses, PO Boxes, and APO/FPO addresses.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
