                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Information We Obtain from Third Parties",
                              "lineHeight": 1.35,
                              "fontFamily": "$font-display",
                              "fontSize": 18,
                              "fontWeight": "600"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "KE24s",
                          "name": "Policy paragraph 20",
                          "context": "Published Privacy Policy paragraph; retain wording and source anchors. Capture date 2026-09-06.",
                          "fill": "$ink",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Finally, we may obtain information about you from third parties, including from vendors and service providers who may collect information on our behalf, such as:",
                          "lineHeight": 1.6,
                          "fontFamily": "$font-body",
                          "fontSize": 16,
