                  "fontFamily": "$font-body",
                  "fontSize": 12,
                  "fontWeight": "600",
                  "letterSpacing": 2
                },
                {
                  "type": "text",
                  "id": "WjUCG",
                  "name": "Heading",
                  "fill": "$ink",
                  "content": "The clubs we call home",
                  "lineHeight": 1.1,
                  "fontFamily": "$font-display",
                  "fontSize": 38,
                  "fontWeight": "800",
                  "letterSpacing": -1
                },
                {
                  "type": "text",
                  "id": "E603Kk",
                  "name": "Intro",
                  "fill": "$ink-soft",
                  "textGrowth": "fixed-width",
                  "width": 780,
                  "content": "We're active members at clubs across USA Fencing's Region 1. Most weeks you'll find our team on the strip — fencing épée at Kaizen Academy and Olympic Epee Masters, foil at Rain City Fencing Center, and open fencing at Salle Auriol.",
                  "lineHeight": 1.6,
                  "fontFamily": "$font-body",
                  "fontSize": 17,
