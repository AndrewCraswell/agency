                              "name": "Policy heading 7",
                              "context": "Source H2. Anchor policy-section-7",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "How do I track my order?",
                              "lineHeight": 1.35,
                              "fontFamily": "$font-display",
                              "fontSize": 22,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "hQ7cF",
                              "name": "Policy paragraph 7-1",
                              "context": "Published policy text. Preserve inline anchors with underlined accessible link styling in the actual rich-text renderer: account order history -> https://account.fencing.club/. The .pen stores link destinations in this context because text href is not retained by the editor.",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Once your order ships, you will receive an email notification with tracking information. You can also track your order at any time by accessing your account order history.",
