                      "children": [
                        {
                          "type": "text",
                          "id": "PWiPW",
                          "name": "Policy H3 10",
                          "context": "Published H3. Anchor policy-block-10",
                          "fill": "$ink",
                          "textGrowth": "fixed-width",
