                        {
                          "type": "text",
                          "id": "w4fZ7J",
                          "name": "Policy paragraph 59",
                          "context": "Published Privacy Policy paragraph; retain wording and source anchors. Capture date 2026-09-06.",
                          "fill": "$ink",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Depending on where you live, you may have some or all of the rights listed below in relation to your personal information. However, these rights are not absolute, may apply only in certain circumstances and, in certain cases, we may decline your request as permitted by law.",
                          "lineHeight": 1.6,
                          "fontFamily": "$font-body",
                          "fontSize": 16,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "frame",
                          "id": "B3sxZ",
                          "name": "Policy list item 60",
                          "width": "fill_container",
                          "gap": 12,
                          "children": [
                            {
                              "type": "text",
