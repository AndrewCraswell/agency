                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "Gsn4G",
                          "name": "Text",
                          "fill": "$ink",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Wipe the blade down after practice to keep rust and pitting away.",
                          "lineHeight": 1.7,
                          "fontFamily": "Inter",
                          "fontSize": 17,
                          "fontWeight": "normal"
                        }
