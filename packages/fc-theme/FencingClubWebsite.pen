                        {
                          "type": "frame",
                          "id": "pP3r9",
                          "name": "Policy section 3",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 16,
                          "children": [
                            {
                              "type": "text",
                              "id": "TQ7Cq",
                              "name": "Policy heading 3",
                              "context": "Published H2. Anchor policy-section-3",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "How can I start a return for an order?",
                              "lineHeight": 1.35,
                              "fontFamily": "$font-display",
                              "fontSize": 22,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "Aw3pj",
                              "name": "Policy paragraph 3-1",
                              "context": "Published policy text. Preserve inline anchors with underlined accessible link styling in the actual rich-text renderer: order history -> https://account.fencing.club/orders. The .pen stores link destinations in this context because text href is not retained by the editor.",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "To start a return, log in to your customer account and visit your order history. Select the order you wish to return and use the \"Request return\" option available on the order details page.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "waf9X",
                              "name": "Policy paragraph 3-2",
                              "context": "Verbatim published paragraph. Source inline links: order history -> https://account.fencing.club/orders; support@fencing.club -> mailto:support@fencing.club. Address line breaks preserved.",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Returns that meet the eligibility criteria outlined in this policy will be approved. For eligible domestic returns, we will email a prepaid return shipping label as an attachment or download link, along with instructions on how and where to send your package.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "qtbBW",
                              "name": "Policy paragraph 3-3",
                              "context": "Verbatim published paragraph. Source inline links: order history -> https://account.fencing.club/orders; support@fencing.club -> mailto:support@fencing.club. Address line breaks preserved.",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Items sent back without first requesting a return through your customer account will not be accepted.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "loXm2",
                              "name": "Policy paragraph 3-4",
                              "context": "Published policy text. Preserve inline anchors with underlined accessible link styling in the actual rich-text renderer: support@fencing.club -> mailto:support@fencing.club. The .pen stores link destinations in this context because text href is not retained by the editor.",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "If you have questions or are unable to access your account, please contact us at support@fencing.club.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "o2auP",
                          "name": "Policy section 4",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 16,
                          "children": [
                            {
                              "type": "text",
                              "id": "c7pXn",
                              "name": "Policy heading 4",
                              "context": "Published H2. Anchor policy-section-4",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Where should I send my return to?",
                              "lineHeight": 1.35,
                              "fontFamily": "$font-display",
                              "fontSize": 22,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "OcxGc",
                              "name": "Policy paragraph 4-1",
                              "context": "Verbatim published paragraph. Source inline links: order history -> https://account.fencing.club/orders; support@fencing.club -> mailto:support@fencing.club. Address line breaks preserved.",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "After initiating a return, a prepaid shipping label will be provided with the destination shipping address:",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "rznae",
                              "name": "Policy paragraph 4-2",
                              "context": "Verbatim published paragraph. Source inline links: order history -> https://account.fencing.club/orders; support@fencing.club -> mailto:support@fencing.club. Address line breaks preserved.",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Fencing Club\nAttn: Returns\n17190 128th Pl NE\nWoodinville, WA 98072\nUnited States",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "J06q5",
                          "name": "Policy section 5",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 16,
                          "children": [
                            {
                              "type": "text",
                              "id": "H8JjJg",
                              "name": "Policy heading 5",
                              "context": "Published H2. Anchor policy-section-5",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "What if I want to cancel or change my order?",
                              "lineHeight": 1.35,
                              "fontFamily": "$font-display",
                              "fontSize": 22,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "XAoem",
                              "name": "Policy paragraph 5-1",
                              "context": "Published policy text. Preserve inline anchors with underlined accessible link styling in the actual rich-text renderer: support@fencing.club -> mailto:support@fencing.club. The .pen stores link destinations in this context because text href is not retained by the editor.",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "We process orders quickly, and changes or cancellations are not guaranteed once fulfillment has begun. Please email us at support@fencing.club as soon as possible, and we will do our best to accommodate your request.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "OVUU3",
                              "name": "Policy paragraph 5-2",
                              "context": "Verbatim published paragraph. Source inline links: order history -> https://account.fencing.club/orders; support@fencing.club -> mailto:support@fencing.club. Address line breaks preserved.",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "If an order cannot be cancelled, it may still be returned in accordance with this Return & Refund Policy once delivered.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "IPf1G",
                          "name": "Policy section 6",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 16,
                          "children": [
                            {
                              "type": "text",
                              "id": "nLZUq",
                              "name": "Policy heading 6",
                              "context": "Published H2. Anchor policy-section-6",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "What if I received a damaged or wrong item?",
                              "lineHeight": 1.35,
                              "fontFamily": "$font-display",
                              "fontSize": 22,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "O5hNt",
                              "name": "Policy paragraph 6-1",
                              "context": "Verbatim published paragraph. Source inline links: order history -> https://account.fencing.club/orders; support@fencing.club -> mailto:support@fencing.club. Address line breaks preserved.",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Please inspect your order upon receipt and contact us if the item is defective, damaged, or incorrect so that we can evaluate the issue and make it right. Damaged or incorrect items may be returned in accordance with the return timeframe outlined in this policy.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "FEN03",
                          "name": "Policy section 7",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 16,
                          "children": [
                            {
                              "type": "text",
                              "id": "cA1gh",
                              "name": "Policy heading 7",
                              "context": "Published H2. Anchor policy-section-7",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Can I exchange an item?",
                              "lineHeight": 1.35,
                              "fontFamily": "$font-display",
                              "fontSize": 22,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "tW43o",
                              "name": "Policy paragraph 7-1",
                              "context": "Verbatim published paragraph. Source inline links: order history -> https://account.fencing.club/orders; support@fencing.club -> mailto:support@fencing.club. Address line breaks preserved.",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "The fastest way to ensure you receive the item you want is to return the original item and, once the return is accepted, place a separate order for the replacement item.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "JJ4cc",
                          "name": "Policy section 8",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 16,
                          "children": [
                            {
                              "type": "text",
                              "id": "ILyue",
                              "name": "Policy heading 8",
                              "context": "Published H2. Anchor policy-section-8",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "When can I expect my refund?",
                              "lineHeight": 1.35,
                              "fontFamily": "$font-display",
                              "fontSize": 22,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "F8mvrI",
                              "name": "Policy paragraph 8-1",
                              "context": "Verbatim published paragraph. Source inline links: order history -> https://account.fencing.club/orders; support@fencing.club -> mailto:support@fencing.club. Address line breaks preserved.",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Once we receive and inspect your return, we will notify you whether your refund is approved. If approved, refunds are issued to the original payment method within 10 business days.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "W6Ug1J",
                              "name": "Policy paragraph 8-2",
                              "context": "Verbatim published paragraph. Source inline links: order history -> https://account.fencing.club/orders; support@fencing.club -> mailto:support@fencing.club. Address line breaks preserved.",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Original outbound shipping charges are non-refundable, except where required by law or if the return is due to our error (defective, damaged, or incorrect item).",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "zdC4b",
                              "name": "Policy paragraph 8-3",
                              "context": "Verbatim published paragraph. Source inline links: order history -> https://account.fencing.club/orders; support@fencing.club -> mailto:support@fencing.club. Address line breaks preserved.",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Please note that it may take additional time for your bank or credit card company to process and post the refund.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
                    }
