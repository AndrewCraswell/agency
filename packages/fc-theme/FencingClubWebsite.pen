                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "BvkJm",
                      "name": "Policy paragraph 43",
                      "context": "Published Privacy Policy paragraph; retain wording and source anchors. Capture date 2026-09-06.",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "We do not use or disclose sensitive personal information without your consent or for the purposes of inferring characteristics about you.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "wXdsk",
                      "name": "Policy paragraph 44",
                      "context": "Published Privacy Policy paragraph; retain wording and source anchors. Capture date 2026-09-06.",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "With your consent we share personal information for the purpose of engaging in advertising and marketing activities, as follows.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "jGl5Y",
                      "name": "Policy paragraph 45",
                      "context": "Published Privacy Policy paragraph; retain wording and source anchors. Capture date 2026-09-06.",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "We have “sold” and “shared” (as those terms are defined in applicable law) personal information over the preceding 12 months for the purpose of engaging in advertising and marketing activities, as follows.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "ip9VY",
                      "name": "Privacy marketing table",
                      "context": "Published two-column table. Mobile stacks each row as a labelled record, preserving every cell and association. Desktop uses scoped table header cells.",
                      "width": "fill_container",
                      "layout": "vertical",
