      "name": "Docs / Policies and cart recovery handoff",
      "context": "Design handoff, not customer-facing text or a legal review. Policy body fidelity verified against captured site text. Runtime interaction testing is still required when implementing these static designs.",
      "width": 1800,
      "fill": "$surface",
      "layout": "vertical",
      "gap": 24,
      "padding": 32,
      "children": [
        {
          "type": "text",
          "id": "Ilm8g",
