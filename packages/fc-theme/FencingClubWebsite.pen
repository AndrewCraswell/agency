                          "type": "text",
                          "id": "jEU5a",
                          "name": "Policy H2 76",
                          "context": "Published H2. Anchor policy-block-76",
                          "fill": "$ink",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Contact",
                          "lineHeight": 1.35,
                          "fontFamily": "$font-display",
                          "fontSize": 22,
                          "fontWeight": "600"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "JQmdE",
                      "name": "Policy paragraph 77",
                      "context": "Published Privacy Policy paragraph; retain wording and source anchors. Capture date 2026-09-06.",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Should you have any questions about our privacy practices or this Privacy Policy, or if you would like to exercise any of the rights available to you, please call or email us at support@fencing.club or contact us at Fencing Club, 17190 128th Pl NE, Woodinville WA 98072, United States.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "Lo2es",
                      "name": "Policy paragraph 78",
