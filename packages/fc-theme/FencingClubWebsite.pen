                    },
                    {
                      "type": "frame",
                      "id": "SOoB7",
                      "name": "Policy list item 64",
                      "width": "fill_container",
                      "gap": 12,
                      "children": [
                        {
                          "type": "text",
                          "id": "LiiUG",
                          "name": "List marker 64",
                          "fill": "$ink",
                          "content": "-",
                          "fontFamily": "$font-body",
                          "fontSize": 16,
