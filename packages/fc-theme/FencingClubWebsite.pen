                            "bottom": 1
                          },
                          "children": [
                            {
                              "type": "frame",
                              "id": "XGdfg",
                              "name": "Privacy table cell 1-0",
                              "width": "fill_container",
                              "layout": "vertical",
                              "padding": 12,
                              "children": [
                                {
                                  "type": "text",
                                  "id": "I7Q9m",
                                  "name": "Policy table text disclosure 1-0",
                                  "fill": "$ink",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "Identifiers such as basic contact details and certain order and account information\n\nPersonal information categories listed in the California Customer Records statute such as basic contact details and certain order and account information\n\nCommercial information such as order information, shopping information and customer support information\n\nInternet or other similar network activity, such as Usage Data\n\nGeolocation data such as locations determined by an IP address or other technical measures",
                                  "lineHeight": 1.6,
                                  "fontFamily": "$font-body",
                                  "fontSize": 14,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
