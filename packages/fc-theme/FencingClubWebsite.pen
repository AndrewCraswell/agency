                          "name": "Policy list text 15",
                          "fill": "$ink",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Customer support information including the information you choose to include in communications with us, for example, when sending a message through the Services.",
                          "lineHeight": 1.6,
                          "fontFamily": "$font-body",
                          "fontSize": 16,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "usHOf",
                      "name": "Policy paragraph 16",
                      "context": "Published Privacy Policy paragraph; retain wording and source anchors. Capture date 2026-09-06.",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Some features of the Services may require you to directly provide us with certain information about yourself. You may elect not to provide this information, but doing so may prevent you from using or accessing these features.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "w4MMIu",
                      "name": "Policy heading spacing 17",
                      "width": "fill_container",
                      "layout": "vertical",
                      "padding": [
                        16,
