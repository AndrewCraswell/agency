                          "id": "P2guT",
                          "name": "Policy list item 62",
                          "width": "fill_container",
                          "gap": 12,
                          "children": [
                            {
                              "type": "text",
                              "id": "d5r1vB",
                              "name": "List marker 62",
                              "fill": "$ink",
                              "content": "-",
                              "fontFamily": "$font-body",
                              "fontSize": 16,
