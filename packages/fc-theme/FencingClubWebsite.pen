                    },
                    {
                      "type": "frame",
                      "id": "NAWqq",
                      "name": "Component/Size chart / Standard socks / cm",
                      "context": "Canonical published chart data; sizes selectable horizontally as columns, measurement names as sticky rows. Data preserved exactly. Only selected columns shown; no calculator or recommendations. Shared by page and flyout; choice is display state, not product sizing configuration.",
                      "reusable": true,
                      "width": "fill_container",
                      "fill": "$bg",
                      "layout": "vertical",
                      "gap": 16,
                      "children": [
                        {
                          "type": "frame",
                          "id": "NJhe9",
                          "name": "Size selection",
                          "context": "Toggle size columns using one width-aware wrapping button group. Preserve source order, aria-pressed selection and all size options. No product variant mutation. Canvas row positions mirror the available width in each page and flyout.",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 8,
                          "children": [
                            {
                              "type": "text",
                              "id": "H4wEte",
                              "name": "Size selection label",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Sizes to compare",
                              "lineHeight": 1.5,
                              "fontFamily": "$font-body",
                              "fontSize": 13,
                              "fontWeight": "600"
                            },
                            {
                              "type": "frame",
