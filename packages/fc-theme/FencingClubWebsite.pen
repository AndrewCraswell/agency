                      "width": "fill_container",
                      "gap": 12,
                      "children": [
                        {
                          "type": "text",
                          "id": "HXi8n",
                          "name": "List marker 68",
                          "fill": "$ink",
                          "content": "-",
                          "fontFamily": "$font-body",
