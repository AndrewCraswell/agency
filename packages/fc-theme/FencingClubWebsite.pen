                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "If a carrier officially declares a shipment lost or undeliverable, we will offer a replacement or a refund in accordance with our policies.",
                              "lineHeight": 1.6,
