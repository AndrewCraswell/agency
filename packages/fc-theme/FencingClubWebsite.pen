                          "context": "Published Privacy Policy paragraph; retain wording and source anchors. Capture date 2026-09-06.",
                          "fill": "$ink",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "We do not use or disclose sensitive personal information without your consent or for the purposes of inferring characteristics about you.",
                          "lineHeight": 1.6,
                          "fontFamily": "$font-body",
                          "fontSize": 16,
                          "fontWeight": "normal"
                        },
                        {
