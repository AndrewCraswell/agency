                          "name": "List marker 21",
                          "fill": "$ink",
                          "content": "-",
                          "fontFamily": "$font-body",
                          "fontSize": 16,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "Q2a0xv",
                          "name": "Policy list text 21",
                          "fill": "$ink",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Companies who support our Site and Services, such as Shopify.",
                          "lineHeight": 1.6,
                          "fontFamily": "$font-body",
