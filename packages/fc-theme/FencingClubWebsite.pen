                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "If your shipment appears delayed or tracking has not updated for an extended period, please contact us at support@fencing.club so we can assist you.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
