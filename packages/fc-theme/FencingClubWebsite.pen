          "width": "fill_container",
          "layout": "vertical",
          "gap": 8,
          "children": [
            {
              "type": "text",
              "id": "b0dwkZ",
              "name": "Policy sources heading",
              "fill": "$ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Policy sources",
              "lineHeight": 1.5,
              "fontFamily": "$font-body",
              "fontSize": 18,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "es4uv",
              "name": "Policy sources details",
              "fill": "$ink-soft",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Captured from fencing.club on 2026-09-06: /policies/shipping-policy, /policies/refund-policy, /policies/privacy-policy and /policies/terms-of-service. Privacy retains Last updated: July 8, 2026. Other dates were not invented. Every body matches the source after whitespace normalization, including lists and tables.",
              "lineHeight": 1.5,
              "fontFamily": "$font-body",
              "fontSize": 15,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "xAhEy",
          "name": "Responsive reading handoff",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 8,
          "children": [
            {
              "type": "text",
              "id": "Q1vjf3",
              "name": "Responsive reading heading",
              "fill": "$ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Responsive reading",
              "lineHeight": 1.5,
              "fontFamily": "$font-body",
              "fontSize": 18,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "Y0Y9n1",
              "name": "Responsive reading details",
              "fill": "$ink-soft",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Full content boards preserve all policy text. Viewport boards demonstrate native document scrolling. Desktop reading width 760px with side contents links; tablet uses full reading width; mobile has 16px gutters and collapsible contents navigation. No cross-policy navigation row or selector appears in the content area; policy links remain in the shared footer. The policy body itself never collapses. Privacy table rows stack with repeated header labels on mobile.",
              "lineHeight": 1.5,
              "fontFamily": "$font-body",
              "fontSize": 15,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "mVU74",
          "name": "Breadcrumbs and links handoff",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 8,
          "children": [
            {
              "type": "text",
              "id": "C0fN08",
              "name": "Breadcrumbs and links heading",
              "fill": "$ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Breadcrumbs and links",
              "lineHeight": 1.5,
              "fontFamily": "$font-body",
              "fontSize": 18,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "uOl3C",
              "name": "Breadcrumbs and links details",
              "fill": "$ink-soft",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Home leads directly to the current policy, About, Contact or FAQ. Article trail is Home, Journal, article title. Use native ordered-list navigation, ancestor links, decorative chevrons and aria-current=page on the final non-link. Current titles wrap. Source link targets are stored in layer context; Pencil does not retain href on these text nodes. Implement semantic inline anchors from the published rich text.",
              "lineHeight": 1.5,
              "fontFamily": "$font-body",
              "fontSize": 15,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "b1tfZ",
          "name": "Cart recovery contract handoff",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 8,
          "children": [
            {
              "type": "text",
              "id": "fGHgS",
              "name": "Cart recovery contract heading",
              "fill": "$ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Cart recovery contract",
              "lineHeight": 1.5,
              "fontFamily": "$font-body",
              "fontSize": 18,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "su5vK",
              "name": "Cart recovery contract details",
              "fill": "$ink-soft",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Initial load failure is not an empty cart. Loading and quantity changes mark only pending values unknown; checkout waits for the response. Failed changes retain confirmed quantities, prices, discounts and note drafts. Stock limits offer explicit valid quantities. Unavailable items stay visible and block checkout until removal succeeds. Retry targets only the failed operation.",
              "lineHeight": 1.5,
              "fontFamily": "$font-body",
              "fontSize": 15,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "q0sfdq",
          "name": "Focus and announcements handoff",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 8,
          "children": [
            {
              "type": "text",
              "id": "l3tuCX",
              "name": "Focus and announcements heading",
              "fill": "$ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Focus and announcements",
              "lineHeight": 1.5,
              "fontFamily": "$font-body",
              "fontSize": 18,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "XDTym",
              "name": "Focus and announcements details",
              "fill": "$ink-soft",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Use aria-busy and a polite status for loading/success; announce errors once near the affected input or action. Hide skeleton geometry from assistive technology. Keep keyboard focus stable through updates; after item removal move focus to Undo or the next item. Restore trigger focus when closing a flyout; full cart/policy pages are not focus traps. Reduced-motion mode uses static skeletons.",
              "lineHeight": 1.5,
              "fontFamily": "$font-body",
              "fontSize": 15,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "O9uRF",
          "name": "Checkout and gifts handoff",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 8,
          "children": [
            {
              "type": "text",
              "id": "sfJaq",
              "name": "Checkout and gifts heading",
              "fill": "$ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Checkout and gifts",
              "lineHeight": 1.5,
              "fontFamily": "$font-body",
              "fontSize": 18,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "dwkQ3",
              "name": "Checkout and gifts details",
              "fill": "$ink-soft",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Checkout submits the latest note exactly once before navigation. On failure retain cart and note; do not claim payment succeeded or failed. Gift radios apply per stable reward ID immediately; failed replacements restore the previous applied choice. Eligibility loss affects only the applicable reward. No kit/weapon edit controls or gift add/edit/delete controls.",
              "lineHeight": 1.5,
              "fontFamily": "$font-body",
              "fontSize": 15,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "ZXZg2",
          "name": "Localization handoff",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 8,
          "children": [
            {
              "type": "text",
              "id": "A0uMRU",
              "name": "Localization heading",
              "fill": "$ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Localization",
              "lineHeight": 1.5,
              "fontFamily": "$font-body",
              "fontSize": 18,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "i3TNI",
              "name": "Localization details",
              "fill": "$ink-soft",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Translate complete error messages with named values for quantity, stock limit, product name and money. Use locale plural rules for purchased-item counts. Keep gift headings count-free. Localize Home and On this page. Resource titles and policy text come from store-managed content, not hardcoded English fragments.",
              "lineHeight": 1.5,
              "fontFamily": "$font-body",
              "fontSize": 15,
              "fontWeight": "normal"
            }
          ]
        }
      ]
