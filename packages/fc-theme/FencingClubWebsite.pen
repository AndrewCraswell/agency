                        {
                          "type": "frame",
                          "id": "T68jh",
                          "name": "Terms section 5",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 16,
                          "children": [
                            {
                              "type": "text",
                              "id": "e85Ile",
                              "name": "Terms heading 5",
