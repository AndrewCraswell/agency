                        {
                          "type": "text",
                          "id": "ttJTJ",
                          "name": "Text",
                          "fill": "$ink",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Check that the guard has no sharp edges and the pommel is tight before every session.",
                          "lineHeight": 1.7,
                          "fontFamily": "Inter",
                          "fontSize": 17,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "OmQ6y",
                      "name": "Tip",
                      "width": "fill_container",
                      "gap": 12,
                      "children": [
                        {
                          "type": "text",
                          "id": "hz5T1",
                          "name": "Dash",
                          "fill": "$ink",
                          "content": "—",
                          "fontFamily": "Inter",
                          "fontSize": 17,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "zpHXo",
                          "name": "Text",
                          "fill": "$ink",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Grip lightly — if your knuckles are white, the foil is driving you.",
                          "lineHeight": 1.7,
                          "fontFamily": "Inter",
                          "fontSize": 17,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "I4dgA3",
                      "name": "Tip",
                      "width": "fill_container",
                      "gap": 12,
                      "children": [
                        {
