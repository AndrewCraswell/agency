{
  "name": "@repo/fc-templates",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node ./src/build.ts",
    "dev": "vite",
    "check:types": "tsc --noEmit",
    "check:unused": "knip --directory ../.. --workspace packages/fc-templates",
    "lint": "oxlint --max-warnings=0",
    "storybook": "storybook dev -p 6008",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tanstack/react-router": "0.0.1-rsc-tarball",
    "liquidjs": "10.27.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@repo/oxlint-config": "workspace:*",
    "@repo/storybook-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/node": "catalog:",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxlint": "^1.72.0",
    "storybook": "10.4.6",
    "typescript": "catalog:",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  }
}
