{
  "name": "@repo/fc-templates",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "shopify-emails build --dir src/emails --out dist",
    "cli": "shopify-emails",
    "dev": "shopify-emails preview --dir src/emails",
    "check:types": "tsc --noEmit",
    "check:unused": "knip --directory ../.. --workspace packages/fc-templates",
    "lint": "oxlint --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@repo/shopify-emails": "workspace:*",
    "react": "^19.2.0",
    "react-email": "^6.9.1"
  },
  "devDependencies": {
    "@react-email/ui": "^6.9.1",
    "@repo/oxlint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "^19.2.0",
    "@vitest/coverage-v8": "^4.1.9",
    "oxlint": "^1.72.0",
    "typescript": "catalog:",
    "vitest": "^4.1.9"
  }
}
