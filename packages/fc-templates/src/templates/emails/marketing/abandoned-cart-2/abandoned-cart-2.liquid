                  class="dk-muted"
                  style="
                    font-family: Inter, &quot;Segoe UI&quot;, Roboto, Helvetica, Arial, sans-serif;
                    font-size: 11px;
                    font-weight: 400;
                    line-height: 17px;
                    color: #5a5a60;
                    padding-top: 8px;
                  "
                >
                  This email was sent to {{ customer.email }} because you started an order at fencing.club.
                </div>

                <div
                  class="dk-muted"
                  style="
                    font-family: Inter, &quot;Segoe UI&quot;, Roboto, Helvetica, Arial, sans-serif;
                    font-size: 11px;
                    line-height: 17px;
                    color: #5a5a60;
                    padding-top: 8px;
                  "
                >
                  {{ unsubscribe_link }}
                </div>

                <div
                  class="dk-muted"
                  style="
                    font-family: Inter, &quot;Segoe UI&quot;, Roboto, Helvetica, Arial, sans-serif;
                    font-size: 11px;
                    font-weight: 400;
                    line-height: 17px;
                    color: #8a8a90;
                    padding-top: 10px;
                  "
                >
                  &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
                </div>

                {{ open_tracking_block }}
              </td>
            </tr>
          </table>
