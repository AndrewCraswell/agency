{%- comment -%}
  Fencing Club — printable packing slip, pasted into Settings > Shipping and delivery >
  Packing slip template. That editor renders one slip per shipment, not per order.

  A warehouse document: what to pick, how many, and where it ships. No prices, because the
  slip travels in the box and doubles as the customer's receipt of contents.

  `line_items_in_shipment` is what goes in this box and `shipping_quantity` is how many of the
  ordered units it carries, so a split order prints one slip per box instead of the whole order
  on each. `order.line_items` would ignore the split.

  Variable reference:
  https://help.shopify.com/en/manual/fulfillment/managing-orders/printing-orders/packing-slips/variable-reference
{%- endcomment -%}

{%- assign unit_count = 0 -%}
{%- for line_item in line_items_in_shipment -%}
  {%- assign unit_count = unit_count | plus: line_item.shipping_quantity -%}
{%- endfor -%}

<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;700;800&family=Inter:wght@400;600;700&display=swap"
/>

<style>
  @page {
    size: letter;
    margin: 0.5in 0.6in;

    @bottom-right {
      color: #3a3a42;
      content: "PAGE " counter(page) " OF " counter(pages);
      font-family: Inter, system-ui, sans-serif;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 1.5px;
    }
  }

  html,
  body {
    margin: 0;
  }

  .fc-slip {
    --ink: #000000;
    --muted: #000000;
    --rule: #8c8c94;
    --tint: #f4f4f2;
    --body: Inter, system-ui, -apple-system, "Segoe UI", sans-serif;
    --display: Archivo, system-ui, -apple-system, "Segoe UI", sans-serif;

    border-collapse: collapse;
    color: var(--ink);
    font-family: var(--body);
    font-size: 13.5px;
    height: 100vh;
    line-height: 1.35;
    print-color-adjust: exact;
    -webkit-print-color-adjust: exact;
    table-layout: fixed;
    width: 100%;
  }

  .fc-slip__content {
    height: 1px;
  }

  /* Zero-specificity reset so the layout classes below still win. */
  .fc-slip :where(td, th) {
    padding: 0;
    vertical-align: top;
  }

  /* Masthead */
  .fc-mast {
    border-collapse: collapse;
    width: 100%;
  }

  .fc-mast__logo {
    height: 66px;
    text-align: center;
    vertical-align: middle;
    width: 54px;
  }

  .fc-mast__logo img {
    display: block;
    height: 66px;
    margin: 0 auto;
    width: 54px;
  }

  .fc-mast__identity {
    padding-left: 14px;
    vertical-align: middle;
    white-space: nowrap;
  }

  .fc-mast__doctype {
    font-family: var(--display);
    font-size: 26px;
    font-weight: 700;
    letter-spacing: 2px;
  }

  .fc-mast__tagline {
    color: var(--muted);
    font-size: 13.5px;
    padding-top: 2px;
  }

  .fc-mast__meta {
    text-align: right;
    vertical-align: middle;
  }

  /* Meta band sits inline with the masthead, one cell per fact. */
  .fc-meta {
    border-collapse: collapse;
    margin-left: auto;
  }

  .fc-meta td {
    border-left: 1px solid var(--rule);
    padding: 0 18px;
    white-space: nowrap;
  }

  .fc-meta td:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .fc-meta td:last-child {
    padding-right: 0;
  }

  .fc-meta__value {
    font-size: 15.5px;
    font-weight: 700;
    padding-top: 4px;
  }

  .fc-label {
    color: var(--muted);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
  }

  .fc-rule {
    background: var(--ink);
    font-size: 0;
    height: 2px;
    line-height: 0;
  }

  /* Parties */
  .fc-section {
    border-collapse: collapse;
    width: 100%;
  }

  .fc-section__rail {
    padding-top: 20px;
    width: 140px;
  }

  .fc-parties {
    border-collapse: collapse;
    width: 100%;
  }

  .fc-parties td {
    padding-right: 32px;
    width: 50%;
  }

  .fc-party__label {
    color: var(--muted);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.8px;
  }

  .fc-party__name {
    font-size: 14.5px;
    font-weight: 700;
    padding-top: 7px;
  }

  .fc-party__line {
    color: var(--muted);
    font-size: 13.5px;
    padding-top: 2px;
  }

  /* Items */
  .fc-items {
    border-collapse: collapse;
    width: 100%;
  }

  .fc-items th {
    border-bottom: 1px solid var(--ink);
    color: var(--muted);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    padding: 7px 0;
    text-align: left;
  }

  .fc-items td {
    border-bottom: 1px solid var(--rule);
    padding: 8px 0;
    vertical-align: middle;
  }

  .fc-items__thumb {
    width: 56px;
  }

  .fc-items__thumb img {
    background: var(--tint);
    border: 1px solid var(--rule);
    border-radius: 6px;
    display: block;
    height: 44px;
    object-fit: contain;
    width: 44px;
  }

  .fc-items__placeholder {
    background: var(--tint);
    border: 1px solid var(--rule);
    border-radius: 6px;
    height: 44px;
    width: 44px;
  }

  .fc-item__title {
    font-size: 14.5px;
    font-weight: 600;
  }

  .fc-item__meta {
    padding-top: 2px;
  }

  .fc-item__meta-part {
    color: var(--muted);
    display: inline-block;
    font-size: 13px;
    padding-right: 14px;
    white-space: nowrap;
  }

  .fc-col-qty {
    text-align: right;
    width: 60px;
  }

  .fc-item__qty {
    font-size: 16px;
    font-weight: 700;
  }

  .fc-item__qty-ordered {
    color: var(--muted);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding-top: 2px;
  }

  .fc-count {
    color: var(--muted);
    font-size: 13.5px;
    padding-top: 8px;
    text-align: right;
  }

  .fc-count__units {
    color: var(--ink);
    font-weight: 700;
  }

  /* Customer note */
  .fc-note {
    border: 1px solid var(--rule);
    border-collapse: separate;
    border-radius: 6px;
    margin-top: 26px;
    width: 100%;
  }

  .fc-note td {
    padding: 10px 14px;
  }

  .fc-note__icon {
    padding-right: 0;
    vertical-align: top;
    width: 24px;
  }

  .fc-note__text {
    font-size: 14px;
    font-style: italic;
    line-height: 18px;
    padding-top: 3px;
  }

  .fc-note__notice {
    font-size: 14px;
    line-height: 18px;
    padding-top: 3px;
  }

  /* Repeated page footer: lives in <tfoot> so print engines render it at the
     foot of every page of a multi-page slip. */
  .fc-slip__footer td {
    padding-top: 26px;
  }

  .fc-footer {
    border-collapse: collapse;
    border-top: 1px solid var(--ink);
    width: 100%;
  }

  .fc-footer td {
    padding-top: 9px;
  }

  .fc-footer__brand {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    white-space: nowrap;
    width: 1%;
  }

  .fc-footer__contact {
    color: var(--muted);
    font-size: 12.5px;
    white-space: nowrap;
    width: 1%;
  }

  /* Beats the `.fc-footer td` padding shorthand on specificity, so the gap that used to come from a
     divider cell now comes from the contact cell itself. */
  .fc-footer td.fc-footer__contact {
    padding-left: 24px;
  }

  .fc-footer__contact svg {
    height: 12px;
    margin-right: 5px;
    vertical-align: -1px;
    width: 12px;
  }

  .fc-footer__thanks {
    font-size: 12.5px;
    font-weight: 600;
    text-align: right;
    white-space: nowrap;
  }

  /* Keep a row, the address block, and the note from splitting across a page break. */
  .fc-items tbody tr,
  .fc-parties,
  .fc-note {
    break-inside: avoid;
    page-break-inside: avoid;
  }
</style>

<table class="fc-slip">
  <tfoot class="fc-slip__footer">
    <tr>
      <td>
        <table class="fc-footer">
          <tr>
            <td class="fc-footer__brand">{{ shop.name | default: "Fencing Club" | upcase }}</td>
            <td class="fc-footer__contact">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="2" y="4" width="20" height="16" rx="2" />
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
              </svg>{{ shop.email | default: "support@fencing.club" }}
            </td>
            <td class="fc-footer__contact">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="10" />
                <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
                <path d="M2 12h20" />
              </svg>{{ shop.domain | default: "fencing.club" }}
            </td>
            <td class="fc-footer__thanks">Thanks for your business!</td>
          </tr>
        </table>
      </td>
    </tr>
  </tfoot>
  <tbody>
    <tr class="fc-slip__content">
      <td>
        <!-- Masthead -->
        <table class="fc-mast">
          <tr>
            <td class="fc-mast__logo">
              <img
                src="https://cdn.shopify.com/s/files/1/0848/2527/6713/files/Fencing_Club-05.png"
                alt="{{ shop.name | default: 'Fencing Club' }}"
              />
            </td>
            <td class="fc-mast__identity">
              <div class="fc-mast__doctype">PACKING SLIP</div>
              <div class="fc-mast__tagline">Keep this slip &mdash; it doubles as your receipt.</div>
            </td>
            <td class="fc-mast__meta">
              <table class="fc-meta">
                <tr>
                  <td>
                    <div class="fc-label">ORDER &#8470;</div>
                    <div class="fc-meta__value">{{ order.name }}</div>
                  </td>
                  <td>
                    <div class="fc-label">DATE</div>
                    <div class="fc-meta__value">{{ order.created_at | date: "%B %e, %Y" }}</div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td colspan="3" style="height: 14px; font-size: 0; line-height: 0;"></td>
          </tr>
          <tr>
            <td class="fc-rule" colspan="3"></td>
          </tr>
        </table>

        <!-- Parties -->
        <table class="fc-section">
          <tr>
            <td class="fc-section__rail" style="padding-top: 20px;">
              <div class="fc-party__label">PARTIES</div>
            </td>
            <td style="padding: 18px 0 16px;">
              <table class="fc-parties">
                <tr>
                  <td>
                    <div class="fc-party__label">BILL TO</div>
                    {%- assign bill_to = billing_address | default: shipping_address -%}
                    {%- if bill_to != blank -%}
                      <div class="fc-party__name">{{ bill_to.name }}</div>
                      {%- if bill_to.company != blank %}<div class="fc-party__line">{{ bill_to.company }}</div>{% endif %}
                      {%- if bill_to.address1 != blank %}<div class="fc-party__line">{{ bill_to.address1 }}</div>{% endif %}
                      {%- if bill_to.address2 != blank %}<div class="fc-party__line">{{ bill_to.address2 }}</div>{% endif %}
                      <div class="fc-party__line">{{ bill_to.city }} {{ bill_to.province_code }} {{ bill_to.zip }}</div>
                      <div class="fc-party__line">{{ bill_to.country }}</div>
                      {%- if bill_to.phone != blank %}<div class="fc-party__line">{{ bill_to.phone }}</div>{% endif %}
                    {%- else -%}
                      <div class="fc-party__line">{{ customer.email }}</div>
                    {%- endif -%}
                  </td>
                  <td>
                    {%- if shipping_address != blank -%}
                      <div class="fc-party__label">SHIP TO</div>
                      <div class="fc-party__name">{{ shipping_address.name }}</div>
                      {%- if shipping_address.company != blank %}<div class="fc-party__line">{{ shipping_address.company }}</div>{% endif %}
                      {%- if shipping_address.address1 != blank %}<div class="fc-party__line">{{ shipping_address.address1 }}</div>{% endif %}
                      {%- if shipping_address.address2 != blank %}<div class="fc-party__line">{{ shipping_address.address2 }}</div>{% endif %}
                      <div class="fc-party__line">{{ shipping_address.city }} {{ shipping_address.province_code }} {{ shipping_address.zip }}</div>
                      <div class="fc-party__line">{{ shipping_address.country }}</div>
                      {%- if shipping_address.phone != blank %}<div class="fc-party__line">{{ shipping_address.phone }}</div>{% endif %}
                    {%- endif -%}
                  </td>
                </tr>
              </table>
            </td>
          </tr>
        </table>

        <!-- Items -->
        <table class="fc-items">
          <thead>
            <tr>
              <th colspan="2" scope="col">ITEM</th>
              <th class="fc-col-qty" scope="col">QTY</th>
            </tr>
          </thead>
          <tbody>
            {%- for line_item in line_items_in_shipment %}
              <tr>
                <td class="fc-items__thumb">
                  {%- if line_item.image != blank -%}
                    <img src="{{ line_item.image | img_url: '100x100' }}" alt="" />
                  {%- else -%}
                    <div class="fc-items__placeholder"></div>
                  {%- endif -%}
                </td>
                <td>
                  <div class="fc-item__title">{{ line_item.title }}</div>
                  {%- if line_item.variant_title != blank %}
                    <div class="fc-item__meta">
                      <span class="fc-item__meta-part">{{ line_item.variant_title }}</span>
                    </div>
                  {%- endif %}
                </td>
                <td class="fc-col-qty">
                  <span class="fc-item__qty">&times; {{ line_item.shipping_quantity }}</span>
                  {%- if line_item.shipping_quantity < line_item.quantity %}
                    <div class="fc-item__qty-ordered">OF {{ line_item.quantity }}</div>
                  {%- endif %}
                </td>
              </tr>
            {%- endfor %}
          </tbody>
        </table>

        <div class="fc-count">
          {{ line_items_in_shipment.size }} line {% if line_items_in_shipment.size == 1 %}item{% else %}items{% endif %}
          &mdash;
          <span class="fc-count__units">{{ unit_count }} {% if unit_count == 1 %}unit{% else %}units{% endif %}</span>
        </div>
      </td>
    </tr>
    <tr class="fc-slip__spacer">
      <td></td>
    </tr>
    <tr class="fc-slip__content">
      <td>
        <!-- Split shipment -->
        {%- unless includes_all_line_items_in_order %}
          <table class="fc-note">
            <tr>
              <td class="fc-note__icon">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path
                    d="M21 8 12 3 3 8v8l9 5 9-5zM3 8l9 5 9-5M12 13v8"
                    stroke="#000000"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </td>
              <td>
                <div class="fc-label">SPLIT SHIPMENT</div>
                <div class="fc-note__notice">This box holds part of the order. The rest ships separately.</div>
              </td>
            </tr>
          </table>
        {%- endunless %}

        <!-- Customer note -->
        {%- if order.note != blank %}
          <table class="fc-note">
            <tr>
              <td class="fc-note__icon">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path
                    d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
                    stroke="#000000"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </td>
              <td>
                <div class="fc-label">CUSTOMER NOTE</div>
                <div class="fc-note__text">{{ order.note }}</div>
              </td>
            </tr>
          </table>
        {%- endif %}
      </td>
    </tr>
  </tbody>
</table>
