        .dk-text, .dk-text a { color: #f7f7f5 !important; }
        .dk-muted, .dk-muted a { color: #a0a0a6 !important; }
        /* A hairline is a filled block, so it takes a background rather than the text or border colour. */
        .dk-rule { background-color: #f7f7f5 !important; }
        .dk-hairline { background-color: #2e2e33 !important; }
        .dk-chip { background-color: #f7f7f5 !important; color: #101012 !important; }
        /* The gap a chip keeps from whatever it overlaps, which has to darken with the page. */
        .dk-ring { border-color: #141416 !important; }
        .dk-btn { background-color: #ffffff !important; color: #101012 !important; }
        .dk-num { background-color: #f7f7f5 !important; color: #101012 !important; }
        .dk-icon { background-color: #2a2a2e !important; }
      }

      [data-ogsb] .dk-page, [data-ogsc] .dk-page { background-color: #141416 !important; }
