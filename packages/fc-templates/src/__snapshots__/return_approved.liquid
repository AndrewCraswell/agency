    <table
      border="0"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      role="presentation"
      align="center">
      <tbody>
        <tr>
          <td
            dir="ltr"
            lang="en"
            style='background-color:#ffffff;font-family:Inter, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;margin:0;padding:0'>
            <table
              align="center"
              width="100%"
              class="wrapper dk-card"
              border="0"
              cellpadding="0"
              cellspacing="0"
              role="presentation"
              style="max-width:600px;background-color:#ffffff;margin:0 auto;width:100%">
              <tbody>
                <tr style="width:100%">
                  <td>
                    <table
                      align="center"
                      width="100%"
                      border="0"
                      cellpadding="0"
                      cellspacing="0"
                      role="presentation"
                      class="px dk-band"
                      style="background-color:#0b0b0c;text-align:center">
                      <tbody>
                        <tr>
                          <td style="padding:24px 32px">
                            <table
                              align="center"
                              width="100%"
                              border="0"
                              cellpadding="0"
                              cellspacing="0"
                              role="presentation"
                              style="margin:0 auto;width:auto">
                              <tbody style="width:100%">
                                <tr style="width:100%">
                                  <td
                                    data-id="__react-email-column"
                                    style="padding-right:12px;vertical-align:middle">
                                    {% if shop.email_logo_url %}<img
                                      alt="{{ shop.name | escape }}"
                                      src="{{ shop.email_logo_url | escape }}"
                                      style="display:block;outline:none;border:0;text-decoration:none"
                                      width="{{ shop.email_logo_width | escape }}" />{% else %}<img
                                      alt="{{ shop.name | escape }}"
                                      height="63"
                                      src="https://cdn.shopify.com/s/files/1/0848/2527/6713/files/email-logo-white.png?v=1784929023"
                                      style="display:block;outline:none;border:0;text-decoration:none"
                                      width="52" />{% endif %}
                                  </td>
                                  <td
                                    data-id="__react-email-column"
                                    style="text-align:left;vertical-align:middle">
                                    <div
                                      style='color:#f7f7f5;font-family:Archivo, "Helvetica Neue", Helvetica, Arial, sans-serif;font-size:24px;font-weight:700;letter-spacing:4px;line-height:29px'>
                                      {{ shop.name | upcase | escape }}
                                    </div>
                                    <div
                                      style='color:#a0a0a6;font-family:Inter, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;font-size:11px;font-weight:600;letter-spacing:2px;line-height:16px;padding-top:3px'>
                                      RETURN APPROVED
                                    </div>
                                  </td>
                                </tr>
                              </tbody>
                            </table>
                          </td>
                        </tr>
                      </tbody>
                    </table>
                    {% assign return_label_size = return.deliveries.first.return_label.public_file_url | size %}<!-- -->{% assign return_delivery_count = return.deliveries | size %}
                    <table
                      align="center"
                      width="100%"
                      border="0"
                      cellpadding="0"
                      cellspacing="0"
                      role="presentation"
                      class="px"
                      style="text-align:center">
                      <tbody>
                        <tr>
                          <td style="padding:40px 32px 0">
                            <h1
                              class="h1 dk-text"
                              style='color:#101012;font-family:Archivo, "Helvetica Neue", Helvetica, Arial, sans-serif;font-size:30px;font-weight:700;letter-spacing:-0.5px;line-height:36px;margin:0'>
                              Your return was approved
                            </h1>
                          </td>
                        </tr>
                      </tbody>
                    </table>
                    <table
                      align="center"
                      width="100%"
                      border="0"
                      cellpadding="0"
                      cellspacing="0"
