      [data-ogsb] .dk-ring, [data-ogsc] .dk-ring { border-color: #141416 !important; }
      [data-ogsb] .dk-btn { background-color: #ffffff !important; }
      [data-ogsc] .dk-btn { color: #101012 !important; }
      [data-ogsb] .dk-icon { background-color: #2a2a2e !important; }
