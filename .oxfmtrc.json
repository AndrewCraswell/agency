{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "semi": false,
  "trailingComma": "none",
  "proseWrap": "always",
  "sortImports": {
    "enabled": true,
    "newlinesBetween": false,
    "sortSpecifiers": true
  },
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/dist/**",
    "**/storybook-static/**",
    "**/coverage/**",
    "**/docs/**",
    "**/drizzle/migrations/meta/**",
    "**/.trigger/**",
    "**/.data/**",
    "**/next-env.d.ts",
    "**/*.shopify*.html",
    "**/fixtures/golden-vector-export.json",
    "pnpm-lock.yaml"
  ]
}
