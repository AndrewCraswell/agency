{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignore": ["beachball.config.js", "turbo/generators/templates/**"],
  "tags": ["-vendored"],
  "workspaces": {
    ".": {
      "entry": ["turbo/generators/config.ts"],
      "ignoreDependencies": ["@vitest/expect"],
      "ignoreBinaries": ["ado-npm-auth"]
    },
    "packages/fc-theme": {
      "entry": ["assets/*.js"],
      "ignore": ["assets/vendor-scripts-v11.js"]
    },
    "packages/fc-theme-base": {
      "entry": [
        "assets/*.js",
        "content/capture-migration.mjs",
        "tests/component-library/{library,privacy-fixture,workflows}.js",
        "tests/preview-size-charts.mjs"
      ]
    },
    "apps/scoring": {
      "entry": ["simulator/src/**/*.test.{ts,tsx}"],
      "ignoreDependencies": ["@repo/oxlint-config"]
    },
    "apps/legislation-web": {
      "entry": [
        ".storybook/{main,preview,mocks}.ts{,x}",
        "src/modules/conversations/stories/**/*.stories.tsx",
        "scripts/capture-storybook.ts",
        "src/modules/request-handling/api/next/http.ts!",
        "src/modules/legislation/runtime/runtime.ts!",
        "scripts/{next,tool,infra-what-if,smoke-dependencies,smoke-deployment,smoke-foundation,smoke-local}.mjs!",
        "scripts/smoke-api.ts!",
        "scripts/webhook-verification-receiver/receiver.mjs!",
        "tools/**/!(*.test|*-worker).{ts,mjs}!"
      ],
      "ignoreDependencies": ["@repo/oxlint-config", "@swc/helpers"]
    },
    "apps/legislation-ingestion": {
      "entry": [
        "trigger.config.ts!",
        "scripts/check-api-ingestion-contract.ts!",
        "scripts/tool.mjs!",
        "src/cli/{main,document-relay}.ts!",
        "src/trigger/tasks/**/!(*.test).ts!",
        "src/ingestion/regulations/workers/*.ts!",
        "src/ingestion/regulations/fixtures/pdf-fixture.ts",
        "python/{openstates_runner,prepare_openstates,openstates_source_policy,alaska_journal}.py!",
        "python/regulations/parse_xml.py!",
        "tools/**/!(*.test|*-worker).{ts,mjs}!"
      ],
      "ignoreDependencies": ["@repo/oxlint-config"]
    },
    "apps/legislation-mcp": {
      "entry": ["src/main.ts!", "scripts/smoke-deployment.mjs!"],
      "ignoreDependencies": ["@repo/oxlint-config"]
    },
    "packages/legislation-core": {
      "entry": ["scripts/database.ts!", "drizzle.config.ts!"],
      "ignoreDependencies": ["@repo/oxlint-config"]
    },
    "apps/blog-writer": {
      "entry": [
        "app/**/*.stories.tsx",
        ".storybook/{main,preview}.ts{,x}",
        "app/shopify.server.ts",
        "app/persistence/contracts.server.ts"
      ],
      "ignoreIssues": {
        "app/components/tiptap-icons/**": ["files", "exports", "duplicates"],
        "app/components/tiptap-node/**": ["files", "exports", "duplicates"],
        "app/components/tiptap-ui/**": ["files", "exports", "duplicates"],
        "app/components/tiptap-ui-primitive/**": ["files", "exports", "duplicates"],
        "app/hooks/**": ["files", "exports", "duplicates"],
        "app/lib/tiptap-utils.ts": ["files", "exports", "duplicates"]
      },
      "ignoreDependencies": [
        "@repo/oxlint-config",
        "@axe-core/playwright",
        "@playwright/test",
        "@storybook/addon-a11y",
        "@storybook/addon-vitest",
        "@chromatic-com/storybook",
        "@shopify/api-codegen-preset",
        "@t3-oss/env-core",
        "graphql-config",
        "msw",
        "react-error-boundary",
        "rollup-plugin-visualizer",
        "ts-extras",
        "ts-pattern"
      ],
      "ignoreBinaries": ["graphql-codegen", "shopify"]
    },
    "packages/fc-templates": {
      "entry": ["src/emails/marketing/*.tsx", "src/emails/notifications/*.tsx", "src/emails/printouts/*/*.tsx"],
      "ignoreDependencies": ["@repo/oxlint-config", "@react-email/ui"]
    },
    "packages/scoring-circuit": {
      "entry": ["src/*.test.{ts,tsx}"],
      "ignoreDependencies": ["@repo/oxlint-config"]
    },
    "packages/shopify-emails": {
      "ignoreDependencies": ["@repo/oxlint-config"]
    },
    "packages/shopify-content": {
      "ignoreDependencies": ["@repo/oxlint-config"]
    },
    "packages/storybook-config": {
      "ignoreDependencies": [
        "@repo/oxlint-config",
        "@chromatic-com/storybook",
        "@storybook/addon-a11y",
        "@storybook/addon-vitest"
      ]
    }
  }
}
