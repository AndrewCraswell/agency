{
  "name": "legislation-mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "build": "pnpm check:types && vite build",
    "start": "node dist/main.mjs",
    "dev": "tsx watch src/main.ts",
    "check:types": "tsc --noEmit",
    "lint": "oxlint --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:acceptance": "pnpm build && node --test scripts/built-acceptance.test.mjs",
    "smoke:deployment": "node scripts/smoke-deployment.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@repo/legislation-core": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/oxlint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "^4.1.9",
    "jose": "^6.2.8",
    "oxlint": "^1.72.0",
    "tsx": "^4.23.0",
    "typescript": "catalog:",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  }
}
