{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "production"
    },
    "location": {
      "value": "eastus2"
    },
    "registryPublicNetworkAccess": {
      "value": "Disabled"
    },
    "apiMinimumReplicas": {
      "value": 2
    },
    "apiMaximumReplicas": {
      "value": 5
    },
    "workerMinimumReplicas": {
      "value": 1
    },
    "workerMaximumReplicas": {
      "value": 3
    },
    "postgresSkuName": {
      "value": "Standard_D4ds_v5"
    },
    "postgresStorageSizeGB": {
      "value": 256
    },
    "backupRetentionDays": {
      "value": 35
    },
    "monitoringRetentionDays": {
      "value": 90
    }
  }
}
