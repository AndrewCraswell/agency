{
  "name": "agentic",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:types": "tsc --noEmit",
    "control-plane:api": "tsx --env-file=.env src/controlPlane/api.ts",
    "control-plane:worker": "tsx --env-file=.env src/controlPlane/worker.ts",
    "control-plane:reconcile": "tsx --env-file=.env src/controlPlane/reconciler.ts",
    "control-plane": "tsx --env-file=.env src/controlPlane/cli.ts",
    "db:check": "drizzle-kit check --config=drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "tsx --env-file=.env src/persistence/migrate.ts",
    "lint": "oxlint --max-warnings=0",
    "linear:tasks": "tsx --env-file=.env src/linear/cli.ts",
    "worker": "tsx src/prototype/cli.ts",
    "workflow": "tsx src/orchestrator/cli.ts",
    "test": "vitest run",
    "test:postgres": "node --env-file=.env ../../node_modules/vitest/vitest.mjs run src/orchestrator/checkpointRecovery.integration.test.ts src/persistence/migrate.integration.test.ts src/workflows/workflowLifecycle.integration.test.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@azure/keyvault-secrets": "^4.11.2",
    "@azure/storage-blob": "^12.33.0",
    "@daytona/sdk": "0.196.0",
    "@langchain/langgraph": "1.4.7",
    "@langchain/langgraph-checkpoint": "1.1.3",
    "@langchain/langgraph-checkpoint-postgres": "1.0.4",
    "@nangohq/node": "0.70.9",
    "cron-parser": "^5.6.2",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "langsmith": "0.8.1",
    "openai": "6.46.0",
    "pg": "^8.22.0",
    "tsx": "4.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.9",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.72.0",
    "typescript": "catalog:",
    "vitest": "^4.1.9"
  }
}
