{
  "name": "tutor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --clearScreen false --open",
    "prebuild": "pnpm runtime:completed-graph",
    "build": "tsc && vite build",
    "layout:completed-graph": "node scripts/layout-completed-graph.mjs && node scripts/build-completed-graph-runtime.mjs",
    "runtime:completed-graph": "node scripts/build-completed-graph-runtime.mjs",
    "preview": "vite preview",
    "verify": "run-s check test:coverage",
    "check": "run-p check:*",
    "check:format": "oxfmt --check",
    "check:lint": "pnpm lint",
    "check:types": "tsc --noEmit",
    "check:unused": "knip --directory ../.. --workspace apps/tutor",
    "lint": "oxlint --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@fluentui/react-components": "^9.74.3",
    "@fluentui/react-icons": "^2.0.333",
    "@xyflow/react": "12.11.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-error-boundary": "^6.1.2",
    "the-new-css-reset": "^1.11.3",
    "tiny-invariant": "^1.3.3"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "catalog:",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "babel-plugin-react-compiler": "^1.0.0",
    "happy-dom": "^20.10.6",
    "oxlint": "^1.72.0",
    "typescript": "catalog:",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  }
}
