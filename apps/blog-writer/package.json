{
  "name": "blog-writer",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "dev": "shopify app dev",
    "preview": "react-router-serve ./build/server/index.js",
    "verify": "run-s check test:coverage",
    "check": "run-p check:*",
    "check:format": "oxfmt --check",
    "check:lint": "oxlint --max-warnings=0",
    "check:types": "react-router typegen && tsc --noEmit",
    "check:unused": "knip --directory ../.. --workspace apps/blog-writer",
    "lint": "oxlint --max-warnings=0",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "start": "react-router-serve ./build/server/index.js",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "db:check": "drizzle-kit check --config=drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "tsx app/persistence/migrate.server.ts",
    "auth:langfuse": "node --env-file=.env -e \"const { LANGFUSE_PUBLIC_KEY: publicKey, LANGFUSE_SECRET_KEY: secretKey } = process.env; if (!publicKey || !secretKey) throw new Error('LANGFUSE_PUBLIC_KEY and LANGFUSE_SECRET_KEY are required'); console.log(Buffer.from(`${publicKey}:${secretKey}`).toString('base64'))\"",
    "shopify": "shopify",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0 <12.0.0"
  },
  "dependencies": {
