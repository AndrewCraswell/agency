    { "authority": "fie", "id": "SABRE-03", "document": "fie-material-rules-2026-08-en.pdf", "page": 81, "locator": "Annex B, C(a).7 and C(b).1-C(b).2" },
    { "authority": "implementation", "id": "SABRE-TEST-CONTACT-FLOOR", "document": "src/sabre.test.ts", "page": null, "locator": "captures a released target pulse only when its known duration reaches 100 microseconds" }
  ],
  "lineModel": { "revision": "sabre-logical-lines-1", "names": ["left.target", "right.target"] },
