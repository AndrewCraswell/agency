    ] },
    { "id": "below-floor", "atUs": 99, "atUncertaintyUs": 0, "mode": "snapshot", "lines": [
      { "line": "left.target", "state": "closed", "resistanceMilliOhms": null, "resistanceUncertaintyMilliOhms": null }, { "line": "right.target", "state": "closed", "resistanceMilliOhms": null, "resistanceUncertaintyMilliOhms": null }
    ] },
    { "id": "left-break-right-at-floor", "atUs": 100, "atUncertaintyUs": 0, "mode": "snapshot", "lines": [
