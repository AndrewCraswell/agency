    ] },
    { "id": "right-start-for-cutoff", "atUs": 170000, "atUncertaintyUs": 0, "mode": "snapshot", "lines": [
      { "line": "left.target", "state": "grounded", "resistanceMilliOhms": null, "resistanceUncertaintyMilliOhms": null }, { "line": "right.target", "state": "closed", "resistanceMilliOhms": null, "resistanceUncertaintyMilliOhms": null }
