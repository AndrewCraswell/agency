set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)

if(NOT DEFINED SCORING_ARM_GNU_TOOLCHAIN_ROOT)
  message(FATAL_ERROR "SCORING_ARM_GNU_TOOLCHAIN_ROOT must point to the pinned Arm GNU Toolchain root")
endif()

set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES SCORING_ARM_GNU_TOOLCHAIN_ROOT)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_C_COMPILER "${SCORING_ARM_GNU_TOOLCHAIN_ROOT}/bin/arm-none-eabi-gcc.exe")
set(CMAKE_ASM_COMPILER "${SCORING_ARM_GNU_TOOLCHAIN_ROOT}/bin/arm-none-eabi-gcc.exe")
set(CMAKE_OBJCOPY "${SCORING_ARM_GNU_TOOLCHAIN_ROOT}/bin/arm-none-eabi-objcopy.exe")
set(CMAKE_SIZE "${SCORING_ARM_GNU_TOOLCHAIN_ROOT}/bin/arm-none-eabi-size.exe")
set(CMAKE_NM "${SCORING_ARM_GNU_TOOLCHAIN_ROOT}/bin/arm-none-eabi-nm.exe")
