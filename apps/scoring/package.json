{
  "name": "scoring",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/epee.d.ts",
      "default": "./dist/epee.js"
    },
    "./device": {
      "types": "./dist/device.d.ts",
      "default": "./dist/device.js"
    },
    "./bout-state": {
      "types": "./dist/bout-state.d.ts",
      "default": "./dist/bout-state.js"
    },
    "./remote-control": {
      "types": "./dist/remote-control.d.ts",
      "default": "./dist/remote-control.js"
    },
    "./epee-resistance": {
      "types": "./dist/epee-resistance.d.ts",
      "default": "./dist/epee-resistance.js"
    },
    "./foil": {
      "types": "./dist/foil.d.ts",
      "default": "./dist/foil.js"
    },
    "./foil-insulation": {
      "types": "./dist/foil-insulation.d.ts",
      "default": "./dist/foil-insulation.js"
    },
    "./sabre": {
      "types": "./dist/sabre.d.ts",
      "default": "./dist/sabre.js"
    },
    "./timing-table": {
      "types": "./dist/timing-table.d.ts",
      "default": "./dist/timing-table.js"
    },
    "./timing-boundary": {
      "types": "./dist/timing-boundary.d.ts",
      "default": "./dist/timing-boundary.js"
    }
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:behavior-oracle": "node scripts/behavior-oracle.mjs --check",
    "check:format": "oxfmt --check",
    "check:golden-vectors": "pnpm build && node scripts/export-golden-vectors.mjs --check",
    "check:stm32-golden-fixture": "node firmware/stm32/tools/generate-golden-fixture.mjs --check",
    "check:lint": "pnpm lint",
    "check:types": "tsc --noEmit",
    "check:unused": "knip --directory ../.. --workspace apps/scoring",
    "export:golden-vectors": "pnpm build && node scripts/export-golden-vectors.mjs",
    "lint": "oxlint --max-warnings=0",
    "observe:scenarios": "pnpm build && node scripts/serve-scenario-observatory.mjs",
    "run:scenarios": "pnpm build && node scripts/run-scenarios.mjs",
    "test": "vitest run",
    "test:c-coverage": "node firmware/tools/check-coverage.mjs",
    "test:coverage": "vitest run --coverage",
    "test:product-release-host": "powershell -ExecutionPolicy Bypass -File firmware/product-update/scripts/run-host-tests.ps1 -Configuration Release",
    "test:stm32-host": "node firmware/stm32/tools/test-host.mjs",
    "test:watch": "vitest",
    "verify": "run-s check:format check:lint check:types check:unused check:behavior-oracle check:golden-vectors test:coverage test:c-coverage test:product-release-host test:stm32-host"
  },
  "devDependencies": {
    "@repo/oxlint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "^4.1.9",
    "oxlint": "^1.72.0",
    "typescript": "catalog:",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "ajv": "8.20.0"
  }
}
