                    24
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "LYnPA",
                      "name": "Feature",
                      "fill": "#171612",
                      "textGrowth": "fixed-width",
                      "width": 280,
                      "content": "External calendars",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 17,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "Yumzg",
                      "name": "Detail",
                      "fill": "#3D3B35",
                      "textGrowth": "fixed-width",
                      "width": 560,
                      "content": "Shows events from another calendar, such as a public holiday calendar, next to the posts in month and week views.",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "T0aN3",
                      "name": "Detail",
                      "fill": "#3D3B35",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The team adds a note to any day in the calendar, such as a holiday, a launch, or a day to avoid posting.",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "d3Ee7K",
                  "name": "Row Campaigns",
                  "width": "fill_container",
                  "stroke": "#E7E3D8",
                  "strokeWidth": {
                    "top": 1
                  },
                  "gap": 32,
                  "padding": [
                    16,
                    24
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "C7Ebag",
                      "name": "Feature",
                      "fill": "#171612",
                      "textGrowth": "fixed-width",
                      "width": 280,
                      "content": "Campaigns",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 17,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "iaWbr",
                      "name": "Detail",
                      "fill": "#3D3B35",
                      "textGrowth": "fixed-width",
                      "width": 560,
                      "content": "Groups posts under a named marketing push, such as a product launch, with its own dates, brief, tasks, files, and results.",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "lWV29",
                      "name": "Detail",
                      "fill": "#3D3B35",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Posts get labels, such as \"Summer menu\", and every view can filter by label. Campaigns brought in from other tools become labels.",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "x8vzu3",
                  "name": "Row Social listening",
                  "width": "fill_container",
                  "stroke": "#E7E3D8",
