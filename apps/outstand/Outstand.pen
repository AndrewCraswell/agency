            },
            {
              "type": "text",
              "id": "O19bTB",
              "name": "Metadata",
              "fill": "#69665D",
              "content": "Outstand is a tool for planning, approving, publishing, and measuring social media posts. Planable is its main competitor.",
              "fontFamily": "Inter",
              "fontSize": 19,
              "fontWeight": "500"
            },
            {
              "type": "text",
              "id": "NvbQ5",
              "name": "Note",
              "fill": "#69665D",
              "textGrowth": "fixed-width",
              "width": 1200,
              "content": "This board lists Planable features that aren't in these designs. The first table is final: those features are left out on purpose. The second table is still open: those features aren't designed yet, and the team needs to decide whether to add them. The same list lives in docs/product-overview.md.",
              "fontFamily": "Inter",
              "fontSize": 17,
