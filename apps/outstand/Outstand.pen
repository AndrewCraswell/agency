                      "name": "Feature",
                      "fill": "#171612",
                      "textGrowth": "fixed-width",
                      "width": 280,
                      "content": "Time and week settings",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 17,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "QdZxN",
                      "name": "Detail",
                      "fill": "#3D3B35",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Letting each person choose 12 or 24 hour time and which day the week starts. Outstand shows times like 1:00 PM everywhere.",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
