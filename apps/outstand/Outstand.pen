                  "name": "Row Lock after approval",
                  "width": "fill_container",
                  "stroke": "#E7E3D8",
                  "strokeWidth": {
                    "top": 1
                  },
                  "gap": 32,
                  "padding": [
                    16,
                    24
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "tTaUL",
                      "name": "Feature",
                      "fill": "#171612",
                      "textGrowth": "fixed-width",
                      "width": 280,
                      "content": "Lock after approval",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 17,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "bh1js",
                      "name": "Detail",
                      "fill": "#3D3B35",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Stops anyone from editing a post after it's been approved.",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "w9U4M",
                  "name": "Row Optional approval",
                  "width": "fill_container",
                  "stroke": "#E7E3D8",
                  "strokeWidth": {
                    "top": 1
                  },
                  "gap": 32,
                  "padding": [
                    16,
                    24
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "gWqqx",
                      "name": "Feature",
                      "fill": "#171612",
                      "textGrowth": "fixed-width",
                      "width": 280,
                      "content": "Optional approval",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 17,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "JmxPs",
                      "name": "Detail",
                      "fill": "#3D3B35",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Asking for approval without holding the post back. In Outstand, approval is either off or required before scheduling.",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "tF00S",
                  "name": "Row Review tools",
                  "width": "fill_container",
                  "stroke": "#E7E3D8",
                  "strokeWidth": {
                    "top": 1
                  },
                  "gap": 32,
                  "padding": [
                    16,
                    24
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "e2PUL",
                      "name": "Feature",
                      "fill": "#171612",
                      "textGrowth": "fixed-width",
                      "width": 280,
                      "content": "Richer review comments",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 17,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "U3Wl3",
                      "name": "Detail",
                      "fill": "#3D3B35",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Pinning a comment to a spot on an image, suggesting a caption edit, and marking a comment as resolved. Outstand's comments tool may support these, but nothing is designed yet.",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "v7B7Rb",
                  "name": "Row Native mobile apps",
                  "width": "fill_container",
                  "stroke": "#E7E3D8",
                  "strokeWidth": {
                    "top": 1
                  },
                  "gap": 32,
                  "padding": [
                    16,
                    24
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "sa4LW",
                      "name": "Feature",
                      "fill": "#171612",
                      "textGrowth": "fixed-width",
                      "width": 280,
                      "content": "Phone apps",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 17,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "aPogg",
                      "name": "Detail",
                      "fill": "#3D3B35",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Phone apps with push notifications, including finishing a post on the phone when a platform won't accept it directly. Outstand's mobile designs cover approving posts, notifications, and the Inbox only.",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "O6kLi7",
