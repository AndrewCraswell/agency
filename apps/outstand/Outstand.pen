                      "fill": "#171612",
                      "textGrowth": "fixed-width",
                      "width": 280,
                      "content": "Social listening",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 17,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "O9Jou8",
                      "name": "Detail",
                      "fill": "#3D3B35",
                      "textGrowth": "fixed-width",
                      "width": 560,
                      "content": "Finds public posts anywhere online that mention the brand, a topic, or a competitor, and tracks whether they're positive or negative. Planable sells it as a paid add-on.",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "EM0t4",
                      "name": "Detail",
                      "fill": "#3D3B35",
                      "textGrowth": "fixed-width",
