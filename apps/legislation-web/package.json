{
  "name": "legislation-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "build": "node scripts/next.mjs build",
    "check:format": "oxfmt --check",
    "check:lint": "pnpm lint",
    "check:types": "tsc --project tsconfig.json --noEmit",
    "db:check": "pnpm --filter @repo/legislation-core db:check",
    "db:down": "pnpm --filter @repo/legislation-core db:down",
    "db:generate": "pnpm --filter @repo/legislation-core db:generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:reset": "pnpm --filter @repo/legislation-core db:reset",
    "db:status": "pnpm --filter @repo/legislation-core db:status",
    "db:up": "pnpm --filter @repo/legislation-core db:up",
    "db:wait": "pnpm --filter @repo/legislation-core db:wait",
    "dev": "node scripts/next.mjs dev",
    "storybook": "storybook dev -p 6007 --host 127.0.0.1 --no-open",
    "storybook:build": "storybook build",
    "storybook:capture": "node --env-file-if-exists=.env --import tsx scripts/capture-storybook.ts",
    "docker:build": "docker build --file Dockerfile --tag legislation-web:local ../..",
    "infra:build": "az bicep build --file infra/bicep/main.bicep --outfile infra/bicep/main.json",
    "infra:lint": "az bicep lint --file infra/bicep/main.bicep",
    "infra:what-if": "node scripts/infra-what-if.mjs",
    "lint": "oxlint --max-warnings=0",
    "start": "node scripts/next.mjs start",
    "smoke:api": "tsx scripts/smoke-api.ts",
    "smoke:deployment": "node scripts/smoke-deployment.mjs",
    "smoke:dependencies": "node scripts/smoke-dependencies.mjs",
    "smoke:foundation": "node scripts/smoke-foundation.mjs",
    "smoke:local": "node scripts/smoke-local.mjs",
    "test": "vitest run --project web --project backend",
    "test:backend": "vitest run --project backend",
    "test:database": "vitest run --project database",
    "test:acceptance": "vitest run --project acceptance",
    "test:coverage": "vitest run --project web --project backend --coverage",
    "test:webhook-verification-receiver": "node --test scripts/webhook-verification-receiver/receiver.test.mjs",
    "test:watch": "vitest --project web --project backend",
    "tool": "node scripts/tool.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.97",
    "@azure/identity": "^4.13.1",
    "@azure/storage-blob": "^12.33.0",
    "@hookform/resolvers": "5.9.1",
    "@json-render/core": "0.20.0",
    "@json-render/react": "0.20.0",
    "@langfuse/otel": "^5.10.0",
    "@langfuse/tracing": "^5.10.0",
    "@langfuse/vercel-ai-sdk": "^5.11.0",
    "@mantine/hooks": "9.6.0",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@repo/legislation-core": "workspace:*",
    "@sentry/core": "10.73.0",
    "@sentry/nextjs": "10.73.0",
    "@swc/helpers": "0.5.23",
    "@tailwindcss/postcss": "4.3.3",
    "@tiptap/core": "^3.29.1",
    "@tiptap/extension-mention": "3.29.1",
    "@tiptap/pm": "^3.29.1",
    "@tiptap/react": "^3.29.1",
    "@tiptap/starter-kit": "^3.29.1",
    "@tiptap/suggestion": "3.29.1",
    "@vanilla-extract/css": "^1.21.2",
    "ai": "file:vendor/ai-7.0.94.tgz",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "1.31.0",
    "next": "16.3.1",
    "pg": "^8.22.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-error-boundary": "6.1.2",
    "react-hook-form": "7.71.2",
    "remark-parse": "11.0.0",
    "streamdown": "2.6.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tiny-invariant": "^1.3.3",
    "unified": "11.0.5",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.2.1",
    "@mswjs/interceptors": "0.41.9",
    "@repo/oxlint-config": "workspace:*",
    "@repo/storybook-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@storybook/addon-a11y": "10.4.6",
    "@storybook/addon-vitest": "10.4.6",
    "@storybook/nextjs-vite": "10.4.6",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vanilla-extract/next-plugin": "^2.5.2",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitest/coverage-v8": "^4.1.9",
    "fuse.js": "^7.5.0",
    "happy-dom": "20.10.6",
    "jose": "^6.2.8",
    "msw": "2.15.0",
    "oxlint": "^1.72.0",
    "storybook": "10.4.6",
    "tsx": "^4.23.0",
    "typescript": "catalog:",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  }
}
