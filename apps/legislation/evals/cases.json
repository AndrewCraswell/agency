[
  {
    "id": "known-federal",
    "scenario": "known_bill",
    "prompt": "Find H.R. 1234 in the 119th Congress and show its official source.",
    "expectedTools": ["search_bills", "get_bill"],
    "evidence": ["canonical bill ID", "official source URL"],
    "local": {
      "calls": [
        { "name": "search_bills", "arguments": { "mode": "lexical", "query": "H.R. 1234" } },
        { "name": "get_bill", "arguments": { "id": "bill:us:119:hr:1234" } }
      ],
      "assertions": [
        {
          "call": 0,
          "source": "data",
          "path": "items.0.id",
          "operator": "equals",
          "expected": "bill:us:119:hr:1234",
          "metric": "known_item_recall",
          "category": "retrieval"
        },
        {
          "call": 1,
          "source": "data",
          "path": "bill.id",
          "operator": "equals",
          "expected": "bill:us:119:hr:1234",
          "metric": "required_field_accuracy",
          "category": "normalization"
        },
        {
          "call": 1,
          "source": "data",
          "path": "bill.sourceUrl",
          "operator": "is_official_url",
          "metric": "source_use",
          "category": "normalization"
        }
      ]
    }
  },
