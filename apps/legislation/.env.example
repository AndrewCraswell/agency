# Runtime
NODE_ENV=development
LOG_LEVEL=info

# HTTP and MCP server
# Local-only bind overrides. Railway injects authoritative PORT and the service binds publicly when it is present.
LEGISLATION_HOST=127.0.0.1
LEGISLATION_PORT=3100
LEGISLATION_PUBLIC_API_BASE_URL=http://127.0.0.1:3100
LEGISLATION_REQUEST_BODY_BYTES=1048576
LEGISLATION_SHUTDOWN_TIMEOUT_MS=30000
# PostgreSQL. Local development uses Compose; deployed development uses Railway.
DATABASE_URL=postgresql://legislation:legislation@127.0.0.1:55432/legislation
DATABASE_MAX_CONNECTIONS=10
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
# PostgreSQL-enforced deadline for statements issued by the Next HTTP API process.
DATABASE_API_STATEMENT_TIMEOUT_MS=15000

# Feature-gated ranked lexical passage search. Keep disabled until the separate
# search database has passed the documented full-corpus readiness gate.
PASSAGE_SEARCH_API_ENABLED=false
# PASSAGE_SEARCH_DATABASE_URL=postgresql://legislation:legislation@127.0.0.1:55433/legislation
# PASSAGE_SEARCH_RANKING_GENERATION=full-corpus-generation
# PASSAGE_SEARCH_API_STATEMENT_TIMEOUT_MS=10000
# PASSAGE_SEARCH_MAX_CONNECTIONS=5
# PASSAGE_SEARCH_CONNECTION_TIMEOUT_MS=5000
# PASSAGE_SEARCH_IDLE_TIMEOUT_MS=30000

# Required in production to enable durable subscription mutations. Generate 32 random bytes and encode with base64url.
LEGISLATION_IDEMPOTENCY_ENCRYPTION_SECRET=

# Required alongside the idempotency key before webhook mutations and synchronous
# verification are composed. This independent 32-byte base64url key protects
# signing secrets at rest; use a KMS-backed adapter when one is available.
LEGISLATION_WEBHOOK_SECRET_ENCRYPTION_KEY=

# Ingestion and local immutable source storage
LEGISLATION_SOURCE_DIRECTORY=.data/sources
INGESTION_CONCURRENCY=4
INGESTION_REQUEST_TIMEOUT_MS=30000
INGESTION_MAX_ATTEMPTS=4
FEDERAL_START_CONGRESS=113
FEDERAL_END_CONGRESS=119
CONGRESS_API_URL=https://api.congress.gov/v3
CONGRESS_API_KEY=
GOVINFO_API_URL=https://api.govinfo.gov
GOVINFO_API_KEY=
OPENSTATES_API_URL=https://v3.openstates.org
OPENSTATES_API_KEY=
# Keep scheduled OpenStates polling disabled until the provider quota supports it.
# Enabling schedules also requires --activate --activate-openstates --apply.
OPENSTATES_SCHEDULES_ENABLED=false

# High-fanout derived backfills use a dedicated one-connection pool per Trigger
# worker and a durable cross-worker publisher limiter. Keep the default of two
# slots for unknown hosts; California is explicitly held to one slot in code.
DERIVED_BACKFILL_DATABASE_MAX_CONNECTIONS=1
DOCUMENT_HOST_DEFAULT_SLOTS=2
DOCUMENT_HOST_LEASE_MS=90000
DOCUMENT_HOST_ACQUIRE_TIMEOUT_MS=120000

# Trigger.dev orchestration
TRIGGER_DEV_PROJECT_ID=
TRIGGER_DEV_API_KEY=
TRIGGER_SECRET_KEY=

# OpenRouter embeddings. The model and dimensions are intentionally pinned.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# Required to enable POST /api/research/answers. This is an explicit OpenRouter model ID, for example an OpenAI model.
RESEARCH_ANSWER_MODEL=
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# WorkOS validation. The API accepts AuthKit sessions plus M2M and MCP callers; MCP accepts only its resource audience.
# Connect/M2M tokens use the AuthKit domain issuer and /oauth2/jwks endpoint. User sessions use their separately
# published session issuer and /sso/jwks/<WORKOS_CLIENT_ID> endpoint.
AUTH_MODE=disabled
WORKOS_CLIENT_ID=
WORKOS_API_AUDIENCE=
WORKOS_ISSUER=
WORKOS_JWKS_URL=
WORKOS_SESSION_ISSUER=
WORKOS_SESSION_JWKS_URL=
WORKOS_MCP_AUDIENCE=

# Azure Blob Storage. Local development uses the filesystem when the account is blank.
AZURE_STORAGE_ACCOUNT=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_STATE_SOURCE_CONTAINER=state-sources
AZURE_FEDERAL_SOURCE_CONTAINER=federal-sources
AZURE_NORMALIZED_DOCUMENT_CONTAINER=normalized-documents
AZURE_REPORT_CONTAINER=reports
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
OCR_MAXIMUM_ATTEMPTS=5

# Langfuse. Configure both keys or neither.
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Integration tests
LEGISLATION_TEST_DATABASE_URL=postgresql://legislation:legislation@127.0.0.1:55432/legislation_test
