              "type": "text",
              "id": "RDavi",
              "name": "Title",
              "fill": "$ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Application shell — standard components and configurations",
              "lineHeight": 1.15,
              "fontFamily": "$font-display",
              "fontSize": "$text-3xl",
              "fontWeight": "600",
              "letterSpacing": -0.5
            },
            {
              "type": "text",
              "id": "Oca5G",
              "name": "Intro",
              "fill": "$ink-muted",
              "textGrowth": "fixed-width",
              "width": 1180,
              "content": "An audit of 84 screens. The header and sidebar are already instanced almost everywhere, so the drift is not adoption — it is that every screen re-encodes the same rules by hand through descendant overrides. This board replaces those overrides with components that carry the state themselves.",
              "lineHeight": 1.55,
              "fontFamily": "$font-ui",
              "fontSize": "$text-sm",
              "fontWeight": "normal"
            }
          ]
        },
