            {
              "type": "frame",
              "id": "XUe8d",
              "name": "Never hover-gate the answer",
              "width": "fill_container",
              "gap": 24,
              "children": [
                {
                  "type": "text",
                  "id": "AqRBz",
                  "name": "Never hover-gate the answer label",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": 264,
                  "content": "Never hover-gate the answer",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 14,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "MOfvy",
                  "name": "Never hover-gate the answer rule",
                  "fill": "$ink-muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Keep submitted choices, written answers, citations, source access, warnings, errors, Continue, Skip and Stop visible whenever applicable. Only secondary metadata and utility actions are candidates for progressive disclosure.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "k5DUp",
              "name": "Accessible, stable reveal",
              "width": "fill_container",
              "gap": 24,
              "children": [
                {
                  "type": "text",
                  "id": "OUVrb",
                  "name": "Accessible, stable reveal label",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": 264,
                  "content": "Accessible, stable reveal",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 14,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "TTCrU",
                  "name": "Accessible, stable reveal rule",
                  "fill": "$ink-muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Use a semantic timestamp button containing time[dateTime], not a focusable noninteractive span/time. Hover, focus or activation exposes the full time. Desktop utility actions reveal on message hover/focus-within; keyboard entry reveals them before use. Honor reduced motion, preserve focus and never move the answer when details appear.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "oEyZ0",
              "name": "Date and lifecycle fidelity",
              "width": "fill_container",
              "gap": 24,
              "children": [
                {
                  "type": "text",
                  "id": "Udb4p",
                  "name": "Date and lifecycle fidelity label",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": 264,
                  "content": "Date and lifecycle fidelity",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 14,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "q3mGr",
                  "name": "Date and lifecycle fidelity rule",
                  "fill": "$ink-muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Format and group by the viewer’s timezone from stored instants, with full dates across days/years. The accessible time includes year and timezone. Sending or failed-to-send messages show their delivery state rather than an invented server timestamp. Read and delivery receipts are not inferred from a time.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "MXoyu",
              "name": "Compact input and full output",
              "width": "fill_container",
              "gap": 24,
              "children": [
                {
                  "type": "text",
                  "id": "o5WyhK",
                  "name": "Compact input and full output label",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": 264,
                  "content": "Compact input and full output",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 14,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "tEyw7",
                  "name": "Compact input and full output rule",
                  "fill": "$ink-muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The answer input is always visible when text is permitted and starts at 44px. It holds the full value with native horizontal caret scrolling. After acknowledgement, render the complete answer and detail as wrapping text beside its question—never a cropped input viewport, generic Answered badge alone or a hidden disclosure.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
