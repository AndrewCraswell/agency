                                                    "KXFN7/EqfZx": {
                                                      "content": "1"
                                                    },
                                                    "NeohA": {
                                                      "content": "Colorado would require local governments to permit middle housing on lots zoned for single-unit dwellings."
                                                    },
                                                    "vaXFN": {
                                                      "content": "From CO HB26-1142, committee substitute of Feb 3, 2026."
                                                    },
                                                    "UnV7O": {
                                                      "enabled": true
                                                    },
                                                    "FFLWq": {
                                                      "content": "“A local government shall not prohibit the use of a lot for a duplex, triplex, or townhome if the lot is located in a tier one urban area and is zoned to allow a single-unit detached dwelling.”"
                                                    },
                                                    "htK3V": {
                                                      "content": "CO HB26-1142, committee substitute of Feb 3, 2026, Sec. 4(b)."
                                                    },
                                                    "dFxOT": {
                                                      "enabled": false
                                                    },
                                                    "VWWHY": {
                                                      "content": "Tier one definition still needs checking against the map referenced in Sec. 2."
