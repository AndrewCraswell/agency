                                                    "KXFN7/EqfZx": {
                                                      "content": "2"
                                                    },
                                                    "NeohA": {
                                                      "content": "Washington would require relocation assistance when a tenant is displaced by a qualifying action."
                                                    },
                                                    "vaXFN": {
                                                      "content": "From WA SB 5218, engrossed version of Feb 5, 2026."
                                                    },
                                                    "UnV7O": {
                                                      "enabled": false
                                                    },
                                                    "FFLWq": {
                                                      "content": "“A landlord shall pay relocation assistance equal to three months of rent to a displaced tenant, unless the displacement results from the tenant's breach of the rental agreement.”"
