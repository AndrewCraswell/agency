            {
              "type": "text",
              "id": "KUv7C",
              "name": "Section Heading",
              "fill": "$ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Local government authority, middle housing",
              "lineHeight": 1.25,
              "fontFamily": "$font-reading",
              "fontSize": "$text-xl",
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "VwlTC",
              "name": "Paragraph A",
              "fill": "$ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "(a)  Notwithstanding any local charter, ordinance, or resolution to the contrary, a municipality with a population of more than ten thousand residents shall allow, as a use by right, the development of middle housing on each lot zoned for single-unit detached dwellings.",
              "lineHeight": "$read-leading",
              "fontFamily": "$font-reading",
              "fontSize": "$read-size",
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "MitfE",
