                  "width": "fill_container",
                  "content": "CITED PASSAGE, 3(b)",
                  "fontFamily": "$font-mono",
                  "fontSize": "$text-xs",
                  "fontWeight": "normal",
                  "letterSpacing": 0.8
                },
                {
                  "type": "text",
                  "id": "edHIV",
                  "name": "Cited Text",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "(b)  A municipality shall not require more than one off-street parking space per dwelling unit for middle housing located within one-half mile of a transit stop served at least four times per hour.",
                  "lineHeight": "$read-leading",
                  "fontFamily": "$font-reading",
                  "fontSize": "$read-size",
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "text",
              "id": "mWWI4",
              "name": "Paragraph C",
              "fill": "$ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "(c)  A municipality may adopt objective design standards applicable to middle housing, provided that the standards do not have the effect of prohibiting development permitted by this section.",
              "lineHeight": "$read-leading",
              "fontFamily": "$font-reading",
              "fontSize": "$read-size",
              "fontWeight": "normal"
            }
