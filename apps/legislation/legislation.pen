                                {
                                  "type": "text",
                                  "id": "zsfXH",
                                  "name": "Cited Text",
                                  "fill": "$ink",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "(b)  A municipality shall not require more than one off-street parking space per dwelling unit for middle housing located within one-half mile of a transit-served corridor, and shall not condition approval of a permit application on the provision of parking in excess of that limit.",
                                  "lineHeight": 1.8,
                                  "fontFamily": "$font-reading",
                                  "fontSize": "$text-lg",
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "id": "oc9Hq",
                              "name": "Paragraph C",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "(c)  A municipality may adopt objective design standards applicable to middle housing, provided that the standards do not, individually or cumulatively, reduce the permitted density below the density authorized by subsection (a) of this section.",
                              "lineHeight": 1.8,
                              "fontFamily": "$font-reading",
                              "fontSize": "$text-lg",
                              "fontWeight": "normal"
                            },
