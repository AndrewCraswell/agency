                                  "fill": "$ink",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "Local government authority — middle housing",
                                  "lineHeight": 1.3,
                                  "fontFamily": "$font-reading",
                                  "fontSize": "$text-xl",
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "id": "BcDfN",
                              "name": "Paragraph A",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "(a)  Notwithstanding any local charter, ordinance, or resolution to the contrary, a municipality with a population of more than ten thousand residents shall allow, as a use by right, the development of middle housing on each lot zoned for single-unit detached dwellings and located within a transit-served area.",
                              "lineHeight": 1.8,
                              "fontFamily": "$font-reading",
                              "fontSize": "$text-lg",
                              "fontWeight": "normal"
                            },
                            {
                              "type": "frame",
                              "id": "I9ws3",
