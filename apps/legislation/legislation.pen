                      "fill": "$ink-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Add one crumb per level and finish with Shell — Crumb, Current. Nothing is disabled to make a shallow path fit.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-ui",
                      "fontSize": "$text-xs",
                      "fontWeight": "normal"
                    }
                  ]
