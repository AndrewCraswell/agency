    {
      "id": "z0lxp",
      "type": "ref",
      "ref": "NkUZ3",
      "name": "Design note — Choose a plan",
      "x": 81320,
      "y": 103735,
      "width": 1440,
      "descendants": {
        "A6Lu1": {
          "content": "Billing change — confirmation gated"
        },
        "XeTKk": {
          "content": "Review change from Subscription and billing. Recheck billing permission."
        },
        "UwdeQ": {
          "content": "No local selection changes the subscription or the current-plan marker."
        },
        "wmahA": {
          "content": "Continue to billing provider, disabled until terms are approved and a complete quote is loaded."
        },
        "QzLJ1": {
          "content": "Provider review, then return to billing for reconciliation."
        },
        "EhOVB": {
          "content": "Back to billing returns focus to Review change."
        },
        "GR0DA": {
          "content": "Cancel before handoff submits nothing. A canceled provider session changes nothing only when confirmed by the provider."
        },
        "PXs1u": {
          "content": "Approved catalogue, current subscription, quote, currency, effective date and permission."
        },
        "QZmiv": {
          "content": "Prices, entitlements, proration, refunds, cancellation, downgrade limits and retention are unresolved. Block self-service changes."
        }
      }
    },
    {
      "id": "lpYKB",
      "type": "ref",
      "ref": "NkUZ3",
      "name": "Design note — Subscription and billing",
      "x": 82880,
      "y": 103735,
      "width": 1440,
      "descendants": {
        "A6Lu1": {
          "content": "Billing return — reconcile, never infer success"
        },
        "XeTKk": {
          "content": "Provider return or Check status again on the billing page."
        },
        "UwdeQ": {
          "content": "Show the last confirmed provider snapshot with its timestamp, or unavailable values. Never move the plan marker optimistically."
        },
        "wmahA": {
          "content": "Check status again"
        },
        "QzLJ1": {
          "content": "Same billing page. Confirmed change: update provider-backed values. Pending: keep a checking state."
        },
        "EhOVB": {
          "content": "Announce the result in the status region without moving focus from the check control."
        },
        "GR0DA": {
          "content": "Confirmed cancel: no change completed. Launch failure: retry the handoff. Unknown return: reconcile before any repeat purchase."
        },
        "PXs1u": {
          "content": "Verified provider subscription and session result, not query-string success flags."
        },
        "QZmiv": {
          "content": "Billing permission does not grant research access. Gate cancellation and downgrade until approved consequences exist."
        }
      }
    },
    {
      "id": "GtQU5",
      "type": "ref",
      "ref": "NkUZ3",
      "name": "Design note — Invoice history unavailable",
      "x": 84440,
      "y": 103735,
      "width": 1440,
      "descendants": {
        "A6Lu1": {
          "content": "Invoice failure — isolated and read-only"
        },
        "XeTKk": {
          "content": "Invoice region fails to load on Subscription and billing."
        },
        "UwdeQ": {
          "content": "No invoice data changes. Keep other confirmed provider values visible and identify their last update."
        },
        "wmahA": {
          "content": "Try again"
        },
        "QzLJ1": {
          "content": "Same invoice region; return only provider-supplied invoices and receipts."
        },
        "EhOVB": {
          "content": "Keep focus on Try again and announce the invoice outcome."
        },
        "GR0DA": {
          "content": "An invoice error is not a failed payment or canceled plan. Never repeat a charge to retry invoice loading."
        },
        "PXs1u": {
          "content": "Billing permission and provider invoice feed."
        },
        "QZmiv": {
          "content": "No cancellation or proration promise. If provider status is uncertain, show it separately and offer status reconciliation."
        }
      }
    },
