                  "descendants": {
                    "A6Lu1": {
                      "content": "Reopening an earlier conversation"
                    },
                    "XeTKk": {
                      "content": "A thread opened from this issue on Jan 22 and reopened today."
                    },
                    "UwdeQ": {
                      "content": "Saved thread on scope revision 2, while the issue is saved on revision 4."
                    },
                    "wmahA": {
                      "content": "Ask new questions on revision 4, offered explicitly and never applied on its own."
                    },
                    "QzLJ1": {
                      "content": "Accepting moves later questions to revision 4. Answers above stay on revision 2."
                    },
                    "EhOVB": {
                      "content": "Return to issue reopens the issue overview with the thread left as it is."
                    },
                    "GR0DA": {
                      "content": "Declining is a full outcome. The thread keeps revision 2 and stays usable."
                    },
                    "PXs1u": {
                      "content": "Historical scope stamped on each turn, plus the issue's current revision for the comparison."
                    },
                    "QZmiv": {
                      "content": "Whether an accepted upgrade should be reversible per thread once new questions exist."
                    }
                  }
                }
              ]
            }
          ]
