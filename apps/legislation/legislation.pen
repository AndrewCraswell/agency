                                          "fill": "$ink",
                                          "textGrowth": "fixed-width",
                                          "width": "fill_container",
                                          "content": "Districts would owe parents notice. H.R. 4021, reported by the House Education and Workforce Committee on February 3, 2026, would require a district using an AI tool on student work to publish a use policy and notify parents before the tool is used.",
                                          "lineHeight": 1.6,
                                          "fontFamily": "$font-reading",
                                          "fontSize": "$text-base",
                                          "fontWeight": "normal"
