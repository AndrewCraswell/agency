                                      "content": "CITED PASSAGE — 3(b)",
                                      "fontFamily": "$font-mono",
                                      "fontSize": "$text-xs",
                                      "fontWeight": "normal",
                                      "letterSpacing": 0.9
                                    },
                                    {
                                      "type": "frame",
