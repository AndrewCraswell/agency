                              "id": "r4aaXZ",
                              "name": "Paragraph C",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "(c)  A municipality may adopt objective design standards applicable to middle housing, provided that the standards do not, individually or cumulatively, reduce the permitted density below the density authorized by subsection (a) of this section.",
                              "lineHeight": 1.8,
                              "fontFamily": "$font-reading",
                              "fontSize": "$text-lg",
