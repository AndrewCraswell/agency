                                      "content": "CITED PASSAGE — 3(b)",
                                      "fontFamily": "$font-mono",
                                      "fontSize": "$text-xs",
                                      "fontWeight": "normal",
                                      "letterSpacing": 0.9
                                    },
                                    {
                                      "type": "frame",
                                      "id": "KuMTE",
                                      "name": "Passage Menu Trigger",
                                      "width": 26,
                                      "height": 26,
                                      "cornerRadius": "$radius-sm",
                                      "justifyContent": "center",
                                      "alignItems": "center",
                                      "children": [
                                        {
                                          "type": "icon",
