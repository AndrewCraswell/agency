                      "content": "The Settings section chooser on a phone."
                    },
                    "UwdeQ": {
                      "content": "Read only. The same inventory as the wide screen, at full width."
                    },
                    "wmahA": {
                      "content": "None. Each row hands off to the section that owns that data."
                    },
                    "QzLJ1": {
                      "content": "Rows open Account and profile, Conversations, Issues, Notifications and Address, one task per screen."
                    },
                    "EhOVB": {
                      "content": "Back returns to the section chooser with Data and privacy in view."
                    },
                    "GR0DA": {
                      "content": "No destructive control on the screen. Export and closure go through the verified support route."
                    },
                    "PXs1u": {
                      "content": "Account record, saved issue and finding counts, follow count, and the district resolved from the address set."
                    },
                    "QZmiv": {
                      "content": "Export and account deletion wait on an approved data inventory, file format, retention and recovery contract. Until then neither is offered as a control."
                    }
