                    "wmahA": {
                      "content": "None. The page orients, and each row hands off to one owner."
                    },
                    "QzLJ1": {
                      "content": "Each row opens the single section that can change or remove it: Account and profile, Conversations, Issues, Notifications, Address."
                    },
                    "EhOVB": {
                      "content": "Returning from a destination restores this page with the row that was opened in view."
                    },
                    "GR0DA": {
                      "content": "Nothing is removed here, so there is nothing to undo. Export and closure requests are verified by support first."
                    },
                    "PXs1u": {
                      "content": "Account record, saved issue and finding counts, follow count, and the district resolved from the address set."
                    },
                    "QZmiv": {
