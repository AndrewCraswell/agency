                },
                {
                  "type": "text",
                  "id": "E0dfFd",
                  "name": "Pause behavior contract",
                  "fill": "$ink-muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Leave earlier answers, citations and completed research available. A pending clarification replaces the working indicator; it does not erase the thread or keep showing a spinning tool. Continue resumes only the owning request after acknowledgement.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "tJBIU",
                  "name": "Ask sparingly contract",
                  "fill": "$ink-muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Use existing context and authorized record lookup before asking. Ask the smallest question that changes the answer, not routine filters for a broad search. If the user cannot answer, explain the limits or offer a broader search instead of repeating the same question. Offer Skip only when a useful, bounded response remains possible.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "Xurzs",
                  "name": "Legal distinction contract",
                  "fill": "$ink-muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Enacted is not synonymous with currently effective. Clarifying this preference does not establish legal status; the answer still needs authoritative records, effective dates and exact citations.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        }
