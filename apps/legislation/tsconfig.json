{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "allowJs": false,
    "incremental": true,
    "jsx": "preserve",
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["./app/*"]
    },
    "noEmit": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "plugins": [{ "name": "next" }],
    "target": "ES2024",
    "types": ["node"]
  },
  "include": [
    "next-env.d.ts",
    "instrumentation.ts",
    "instrumentation-client.ts",
    "sentry.*.config.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "proxy.ts",
    "scripts/next-router-acceptance.test.ts",
    "tools/agent/evaluate-agent.ts",
    "tools/agent/regrade-agent.ts",
    "tools/agent/summarize-agent-comparison.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
