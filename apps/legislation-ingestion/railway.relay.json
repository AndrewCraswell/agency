{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/legislation-ingestion/Dockerfile.relay",
    "watchPatterns": [
      "/apps/legislation-ingestion/**",
      "/apps/legislation-web/vendor/ai-7.0.94.tgz",
      "/packages/legislation-core/**",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml"
    ]
  },
  "deploy": {
    "healthcheckPath": "/ready",
    "healthcheckTimeout": 300,
    "restartPolicyMaxRetries": 3,
    "restartPolicyType": "ON_FAILURE"
  }
}
