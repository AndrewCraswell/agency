# syntax=docker/dockerfile:1.7

ARG NODE_VERSION=24.13.1

FROM node:${NODE_VERSION}-bookworm-slim AS runtime

ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}
ENV npm_config_registry=https://registry.npmjs.org/
ENV NODE_ENV=production
ENV DOCUMENT_FETCH_RELAY_HOST=0.0.0.0
ENV PORT=3000

RUN corepack enable && corepack prepare pnpm@11.9.0 --activate

WORKDIR /workspace

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/legislation-web/vendor/ai-7.0.94.tgz ./apps/legislation-web/vendor/ai-7.0.94.tgz
COPY packages/legislation-core ./packages/legislation-core
COPY apps/legislation-ingestion ./apps/legislation-ingestion
COPY apps/legislation-ingestion/pnpm-workspace.relay.yaml ./pnpm-workspace.yaml

RUN pnpm install --prod --frozen-lockfile --trust-lockfile --ignore-scripts --filter legislation-ingestion...
RUN pnpm --filter legislation-ingestion exec tsx --version

RUN groupadd --system --gid 10001 legislation \
  && useradd --system --uid 10001 --gid legislation legislation \
  && chown -R legislation:legislation /workspace

USER 10001
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s CMD node -e "fetch('http://127.0.0.1:'+process.env.PORT+'/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "--import", "tsx", "apps/legislation-ingestion/src/cli/document-relay.ts"]
